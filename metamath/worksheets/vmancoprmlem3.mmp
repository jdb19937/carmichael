$( <MM> <PROOF_ASST> THEOREM=vmancoprmlem3  LOC_AFTER=?

* Lemma for vmancoprm: the support of the von Mangoldt function in the integers up to Y not coprime to D is the union, over the prime factors q of D, of the multiples of q in it.

s1::simpr |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } )
s2::oveq1 |- ( k = n -> ( k gcd D ) = ( n gcd D ) )
s3:s2:neeq1d |- ( k = n -> ( ( k gcd D ) =/= 1 <-> ( n gcd D ) =/= 1 ) )
s4::fveq2 |- ( k = n -> ( Lam ` k ) = ( Lam ` n ) )
s5:s4:neeq1d |- ( k = n -> ( ( Lam ` k ) =/= 0 <-> ( Lam ` n ) =/= 0 ) )
s6:s3,s5:anbi12d |- ( k = n -> ( ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) <-> ( ( n gcd D ) =/= 1 /\ ( Lam ` n ) =/= 0 ) ) )
s7:s6:elrab |- ( n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } <-> ( n e. ( 1 ... ( |_ ` Y ) ) /\ ( ( n gcd D ) =/= 1 /\ ( Lam ` n ) =/= 0 ) ) )
s8:s1,s7:sylib |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> ( n e. ( 1 ... ( |_ ` Y ) ) /\ ( ( n gcd D ) =/= 1 /\ ( Lam ` n ) =/= 0 ) ) )
s9:s8:simpld |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> n e. ( 1 ... ( |_ ` Y ) ) )
s10:s8:simprd |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> ( ( n gcd D ) =/= 1 /\ ( Lam ` n ) =/= 0 ) )
i11::elfznn
s12:s9,i11:syl |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> n e. NN )
s13::simpl |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> D e. NN )
i14::vmancoprmlem2
s15:s13,s12,s10,i14:syl3anc |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> E. q e. { p e. Prime | p || D } q || n )
s16::breq2 |- ( m = n -> ( q || m <-> q || n ) )
s17:s16:elrab |- ( n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } <-> ( n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } /\ q || n ) )
s18:s1:adantr |- ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) -> n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } )
s19:s18:adantr |- ( ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) /\ q || n ) -> n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } )
s20::simpr |- ( ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) /\ q || n ) -> q || n )
s21:s19,s20:jca |- ( ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) /\ q || n ) -> ( n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } /\ q || n ) )
s22:s21,s17:sylibr |- ( ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) /\ q || n ) -> n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
s23:s22:ex |- ( ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) /\ q e. { p e. Prime | p || D } ) -> ( q || n -> n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } ) )
s24:s23:reximdva |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> ( E. q e. { p e. Prime | p || D } q || n -> E. q e. { p e. Prime | p || D } n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } ) )
s25:s15,s24:mpd |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> E. q e. { p e. Prime | p || D } n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
s26::eliun |- ( n e. U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } <-> E. q e. { p e. Prime | p || D } n e. { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
s27:s25,s26:sylibr |- ( ( D e. NN /\ n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } ) -> n e. U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
s28:s27:ex |- ( D e. NN -> ( n e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } -> n e. U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } ) )
s29:s28:ssrdv |- ( D e. NN -> { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } C_ U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
s30::ssrab2 |- { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) }
s31:s30:rgenw |- A. q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) }
s32::iunss |- ( U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } <-> A. q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } )
s33:s31,s32:mpbir |- U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) }
s34:s33:a1i |- ( D e. NN -> U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } C_ { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } )
qed:s29,s34:eqssd |- ( D e. NN -> { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } = U_ q e. { p e. Prime | p || D } { m e. { k e. ( 1 ... ( |_ ` Y ) ) | ( ( k gcd D ) =/= 1 /\ ( Lam ` k ) =/= 0 ) } | q || m } )
