$( <MM> <PROOF_ASST> THEOREM=tttblw  LOC_AFTER=?

* The first ` L ` slots of a DP table form a word of length ` L ` .

s1::simpl |- ( ( A e. Tbl /\ L e. NN0 ) -> A e. Tbl )
s2::simpr |- ( ( A e. Tbl /\ L e. NN0 ) -> L e. NN0 )
i3::tblf
s4:s1,i3:syl |- ( ( A e. Tbl /\ L e. NN0 ) -> A : NN0 --> ( Word NN0 |_| 1o ) )
s5::0nn0 |- 0 e. NN0
s6::fzossnn0 |- ( 0 e. NN0 -> ( 0 ..^ L ) C_ NN0 )
s7:s5,s6:ax-mp |- ( 0 ..^ L ) C_ NN0
s8:s7:a1i |- ( ( A e. Tbl /\ L e. NN0 ) -> ( 0 ..^ L ) C_ NN0 )
s9:s4,s8:fssresd |- ( ( A e. Tbl /\ L e. NN0 ) -> ( A |` ( 0 ..^ L ) ) : ( 0 ..^ L ) --> ( Word NN0 |_| 1o ) )
i10::iswrdi
s11:s9,i10:syl |- ( ( A e. Tbl /\ L e. NN0 ) -> ( A |` ( 0 ..^ L ) ) e. Word ( Word NN0 |_| 1o ) )
i12::fnfzo0hash
s13:s2,s9,i12:syl2anc |- ( ( A e. Tbl /\ L e. NN0 ) -> ( # ` ( A |` ( 0 ..^ L ) ) ) = L )
qed:s11,s13:jca |- ( ( A e. Tbl /\ L e. NN0 ) -> ( ( A |` ( 0 ..^ L ) ) e. Word ( Word NN0 |_| 1o ) /\ ( # ` ( A |` ( 0 ..^ L ) ) ) = L ) )
$)
