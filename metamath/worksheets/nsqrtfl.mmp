$( <MM> <PROOF_ASST> THEOREM=nsqrtfl  LOC_AFTER=?

* The integer square root is the floor of the real square root.

s1::id |- ( A e. NN0 -> A e. NN0 )
s2:s1:nn0red |- ( A e. NN0 -> A e. RR )
s3:s1:nn0ge0d |- ( A e. NN0 -> 0 <_ A )
i4::resqrtcl
s5:s2,s3,i4:syl2anc |- ( A e. NN0 -> ( sqrt ` A ) e. RR )
i6::sqrtge0
s7:s2,s3,i6:syl2anc |- ( A e. NN0 -> 0 <_ ( sqrt ` A ) )
i8::nfloorfl
qed:s5,s7,i8:syl2anc |- ( A e. NN0 -> ( Nfloor ` ( sqrt ` A ) ) = ( |_ ` ( sqrt ` A ) ) )
$)
