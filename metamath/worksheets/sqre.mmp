s8:s2,s2:crred |- ( ( C e. CC /\ R e. RR ) -> ( Re ` ( R + ( _i x. R ) ) ) = R )
s9:s2,s2:crimd |- ( ( C e. CC /\ R e. RR ) -> ( Im ` ( R + ( _i x. R ) ) ) = R )
s10:s1,s7:resubd |- ( ( C e. CC /\ R e. RR ) -> ( Re ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) - ( Re ` ( R + ( _i x. R ) ) ) ) )
