s12:s10,s11:eqtrd |- ( ( C e. CC /\ R e. RR ) -> ( Re ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) - R ) )
s13:s1,s7:readdd |- ( ( C e. CC /\ R e. RR ) -> ( Re ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) + ( Re ` ( R + ( _i x. R ) ) ) ) )
s14:s8:oveq2d |- ( ( C e. CC /\ R e. RR ) -> ( ( Re ` C ) + ( Re ` ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) + R ) )
s15:s13,s14:eqtrd |- ( ( C e. CC /\ R e. RR ) -> ( Re ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) + R ) )
s16:s1,s7:imsubd |- ( ( C e. CC /\ R e. RR ) -> ( Im ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) - ( Im ` ( R + ( _i x. R ) ) ) ) )
s17:s9:oveq2d |- ( ( C e. CC /\ R e. RR ) -> ( ( Im ` C ) - ( Im ` ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) - R ) )
s18:s16,s17:eqtrd |- ( ( C e. CC /\ R e. RR ) -> ( Im ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) - R ) )
s19:s1,s7:imaddd |- ( ( C e. CC /\ R e. RR ) -> ( Im ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) + ( Im ` ( R + ( _i x. R ) ) ) ) )
s20:s9:oveq2d |- ( ( C e. CC /\ R e. RR ) -> ( ( Im ` C ) + ( Im ` ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) + R ) )
s21:s19,s20:eqtrd |- ( ( C e. CC /\ R e. RR ) -> ( Im ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) + R ) )
s22:s12,s15:jca |- ( ( C e. CC /\ R e. RR ) -> ( ( Re ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) - R ) /\ ( Re ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) + R ) ) )
s23:s18,s21:jca |- ( ( C e. CC /\ R e. RR ) -> ( ( Im ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) - R ) /\ ( Im ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) + R ) ) )
qed:s22,s23:jca |- ( ( C e. CC /\ R e. RR ) -> ( ( ( Re ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) - R ) /\ ( Re ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Re ` C ) + R ) ) /\ ( ( Im ` ( C - ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) - R ) /\ ( Im ` ( C + ( R + ( _i x. R ) ) ) ) = ( ( Im ` C ) + R ) ) ) )
