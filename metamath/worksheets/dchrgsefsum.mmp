s7:s5,i6:syl |- ( ( ( N e. NN /\ A e. ZZ ) /\ a e. ( 0 ..^ N ) ) -> a e. ZZ )
s8::simpr |- ( ( N e. NN /\ A e. ZZ ) -> A e. ZZ )
s9:s8:adantr |- ( ( ( N e. NN /\ A e. ZZ ) /\ a e. ( 0 ..^ N ) ) -> A e. ZZ )
s10:s9,s7:zmulcld |- ( ( ( N e. NN /\ A e. ZZ ) /\ a e. ( 0 ..^ N ) ) -> ( A x. a ) e. ZZ )
i11::dchrgsef
s12:s2,s10,i11:syl2anc |- ( ( ( N e. NN /\ A e. ZZ ) /\ a e. ( 0 ..^ N ) ) -> ( exp ` ( ( 2 x. ( _i x. _pi ) ) x. ( ( A x. a ) / N ) ) ) = ( ( -u 1 ^c ( 2 / N ) ) ^ ( A x. a ) ) )
s13:s12:oveq2d |- ( ( ( N e. NN /\ A e. ZZ ) /\ a e. ( 0 ..^ N ) ) -> ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( exp ` ( ( 2 x. ( _i x. _pi ) ) x. ( ( A x. a ) / N ) ) ) ) = ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ ( A x. a ) ) ) )
qed:s13:sumeq2dv |- ( ( N e. NN /\ A e. ZZ ) -> sum_ a e. ( 0 ..^ N ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( exp ` ( ( 2 x. ( _i x. _pi ) ) x. ( ( A x. a ) / N ) ) ) ) = sum_ a e. ( 0 ..^ N ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ ( A x. a ) ) ) )
