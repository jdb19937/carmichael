s18:s14,s16,s11,i17:syl3anc |- ( ( N e. NN /\ A e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) = ( exp ` ( ( 2 / N ) x. ( log ` -u 1 ) ) ) )
s19::logm1 |- ( log ` -u 1 ) = ( _i x. _pi )
s20:s19:a1i |- ( ( N e. NN /\ A e. ZZ ) -> ( log ` -u 1 ) = ( _i x. _pi ) )
s21:s20:oveq2d |- ( ( N e. NN /\ A e. ZZ ) -> ( ( 2 / N ) x. ( log ` -u 1 ) ) = ( ( 2 / N ) x. ( _i x. _pi ) ) )
s22:s21:fveq2d |- ( ( N e. NN /\ A e. ZZ ) -> ( exp ` ( ( 2 / N ) x. ( log ` -u 1 ) ) ) = ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) )
s23:s18,s22:eqtrd |- ( ( N e. NN /\ A e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) = ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) )
s24:s23:oveq1d |- ( ( N e. NN /\ A e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) = ( ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) ^ A ) )
i25::efexp
s26:s12,s2,i25:syl2anc |- ( ( N e. NN /\ A e. ZZ ) -> ( exp ` ( A x. ( ( 2 / N ) x. ( _i x. _pi ) ) ) ) = ( ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) ^ A ) )
