$( <MM> <PROOF_ASST> THEOREM=cseglinrev  LOC_AFTER=?

* Reversing the parametrisation of a segment.

s1::simp1 |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> A e. CC )
s2::simp2 |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> B e. CC )
s3::simp3 |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> T e. CC )
s4::1cnd |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> 1 e. CC )
s5:s4,s3:subcld |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( 1 - T ) e. CC )
i6::cvxid
s7:s1,s2,s5,i6:syl3anc |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( A + ( ( 1 - T ) x. ( B - A ) ) ) = ( ( ( 1 - ( 1 - T ) ) x. A ) + ( ( 1 - T ) x. B ) ) )
s8:s4,s3:nncand |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( 1 - ( 1 - T ) ) = T )
s9:s8:oveq1d |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( ( 1 - ( 1 - T ) ) x. A ) = ( T x. A ) )
s10:s9:oveq1d |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( ( ( 1 - ( 1 - T ) ) x. A ) + ( ( 1 - T ) x. B ) ) = ( ( T x. A ) + ( ( 1 - T ) x. B ) ) )
s11:s3,s1:mulcld |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( T x. A ) e. CC )
s12:s5,s2:mulcld |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( ( 1 - T ) x. B ) e. CC )
s13:s11,s12:addcomd |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( ( T x. A ) + ( ( 1 - T ) x. B ) ) = ( ( ( 1 - T ) x. B ) + ( T x. A ) ) )
i14::cvxid
s15:s2,s1,s3,i14:syl3anc |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( B + ( T x. ( A - B ) ) ) = ( ( ( 1 - T ) x. B ) + ( T x. A ) ) )
s16:s7,s10:eqtrd |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( A + ( ( 1 - T ) x. ( B - A ) ) ) = ( ( T x. A ) + ( ( 1 - T ) x. B ) ) )
s17:s16,s13:eqtrd |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( A + ( ( 1 - T ) x. ( B - A ) ) ) = ( ( ( 1 - T ) x. B ) + ( T x. A ) ) )
qed:s17,s15:eqtr4d |- ( ( A e. CC /\ B e. CC /\ T e. CC ) -> ( A + ( ( 1 - T ) x. ( B - A ) ) ) = ( B + ( T x. ( A - B ) ) ) )
$)
