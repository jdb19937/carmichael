$( <MM> <PROOF_ASST> THEOREM=root1crt  LOC_AFTER=?

* The CRT factorisation of the additive character (Lean LargeSieve stdAddChar_crt): with A V + B U = 1, the K-th power of the ( U x. V )-th root of unity is the product of the ( A x. K )-th power of the U-th and the ( B x. K )-th power of the V-th root of unity.

s1::simp1 |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( U e. NN /\ V e. NN ) )
s2:s1:simpld |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> U e. NN )
s3:s1:simprd |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> V e. NN )
s4::simp2 |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) )
s5:s4:simp1d |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> A e. ZZ )
s6:s4:simp2d |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> B e. ZZ )
s7:s4:simp3d |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( ( A x. V ) + ( B x. U ) ) = 1 )
s8::simp3 |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> K e. ZZ )
s9:s5,s8:zmulcld |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( A x. K ) e. ZZ )
s10:s6,s8:zmulcld |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( B x. K ) e. ZZ )
i11::root1pow
s12:s2,s3,s9,i11:syl3anc |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( ( -u 1 ^c ( 2 / U ) ) ^ ( A x. K ) ) = ( ( -u 1 ^c ( 2 / ( U x. V ) ) ) ^ ( ( A x. K ) x. V ) ) )
i13::root1pow
s14:s3,s2,s10,i13:syl3anc |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( ( -u 1 ^c ( 2 / V ) ) ^ ( B x. K ) ) = ( ( -u 1 ^c ( 2 / ( V x. U ) ) ) ^ ( ( B x. K ) x. U ) ) )
