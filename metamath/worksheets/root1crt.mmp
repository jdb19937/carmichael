s17:s16,s15:mulcomd |- ( ( ( U e. NN /\ V e. NN ) /\ ( A e. ZZ /\ B e. ZZ /\ ( ( A x. V ) + ( B x. U ) ) = 1 ) /\ K e. ZZ ) -> ( V x. U ) = ( U x. V ) )
