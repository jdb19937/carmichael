$( <MM> <PROOF_ASST> THEOREM=subbitscl  LOC_AFTER=?

* Closure of subbits.

s1::simp1 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> X e. Word 2o )
s2::simp2 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> Y e. Word 2o )
s3::simp3 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> C e. 2o )
s4::subbitsval |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBits Y ) ` C ) = ( ( ( toNat ` X ) - ( ( toNat ` Y ) + ( bToNat ` C ) ) ) bwrd if ( ( # ` X ) <_ ( # ` Y ) , ( # ` Y ) , ( # ` X ) ) ) )
i5::tonatcl
s6:s1,i5:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( toNat ` X ) e. NN0 )
s7:s6:nn0zd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( toNat ` X ) e. ZZ )
i8::tonatcl
s9:s2,i8:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( toNat ` Y ) e. NN0 )
s10:s9:nn0zd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( toNat ` Y ) e. ZZ )
i11::bwbncl
s12:s3,i11:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( bToNat ` C ) e. NN0 )
s13:s12:nn0zd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( bToNat ` C ) e. ZZ )
s14:s10,s13:zaddcld |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( toNat ` Y ) + ( bToNat ` C ) ) e. ZZ )
s15:s7,s14:zsubcld |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( toNat ` X ) - ( ( toNat ` Y ) + ( bToNat ` C ) ) ) e. ZZ )
i16::lencl
s17:s2,i16:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( # ` Y ) e. NN0 )
i18::lencl
s19:s1,i18:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( # ` X ) e. NN0 )
s20:s17,s19:ifcld |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> if ( ( # ` X ) <_ ( # ` Y ) , ( # ` Y ) , ( # ` X ) ) e. NN0 )
i21::bwrdcl
s22:s15,s20,i21:syl2anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( ( toNat ` X ) - ( ( toNat ` Y ) + ( bToNat ` C ) ) ) bwrd if ( ( # ` X ) <_ ( # ` Y ) , ( # ` Y ) , ( # ` X ) ) ) e. Word 2o )
qed:s4,s22:eqeltrd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBits Y ) ` C ) e. Word 2o )
$)
