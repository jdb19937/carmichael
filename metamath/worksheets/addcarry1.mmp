$( <MM> <PROOF_ASST> THEOREM=addcarry1  LOC_AFTER=?

* addCarry of true is the one-letter word true.

s1::1oel2o |- 1o e. 2o
i2::addcarryval
s3:s1,i2:ax-mp |- ( addCarry ` 1o ) = if ( 1o = 1o , <" 1o "> , (/) )
s4::eqid |- 1o = 1o
s5:s4:iftruei |- if ( 1o = 1o , <" 1o "> , (/) ) = <" 1o ">
qed:s3,s5:eqtri |- ( addCarry ` 1o ) = <" 1o ">
$)
