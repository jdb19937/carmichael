4::simpr    |- ( ( ( ( N e. NN /\ ( mmu ` N ) =/= 0 /\ A. p e. Prime ( p || N -> ( p - 1 ) || ( N - 1 ) ) ) /\ a e. ZZ ) /\ q e. Prime ) -> q e. Prime )
5::simpl3   |- ( ( ( N e. NN /\ ( mmu ` N ) =/= 0 /\ A. p e. Prime ( p || N -> ( p - 1 ) || ( N - 1 ) ) ) /\ a e. ZZ ) -> A. p e. Prime ( p || N -> ( p - 1 ) || ( N - 1 ) ) )
