$( <MM> <PROOF_ASST> THEOREM=prmproddvds  LOC_AFTER=?

* Every prime of Q divides the modulus L = Lmod Q (Lean: Finset.dvd_prod_of_mem).

s1::simpl |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q e. ( ~P Prime i^i Fin ) )
s2::simpr |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> P e. Q )
i3::elfpw
s4:s1,i3:sylib |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> ( Q C_ Prime /\ Q e. Fin ) )
s5:s4:simpld |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q C_ Prime )
s6:s4:simprd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q e. Fin )
s7::prmssnn |- Prime C_ NN
s8::nnssnn0 |- NN C_ NN0
s9:s7,s8:sstri |- Prime C_ NN0
s10:s9:a1i |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Prime C_ NN0 )
s11:s5,s10:sstrd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q C_ NN0 )
s12:s11,s6:jca |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> ( Q C_ NN0 /\ Q e. Fin ) )
i13::elfpw
s14:s12,i13:sylibr |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q e. ( ~P NN0 i^i Fin ) )
s15::nnssz |- NN C_ ZZ
s16:s7,s15:sstri |- Prime C_ ZZ
s17:s16:a1i |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Prime C_ ZZ )
s18:s5,s17:sstrd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> Q C_ ZZ )
s19:s6,s18:fproddvdsd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> A. x e. Q x || prod_ k e. Q k )
s20::id |- ( x = P -> x = P )
c1:s20:breq1d |- ( x = P -> ( x || prod_ k e. Q k <-> P || prod_ k e. Q k ) )
s21:c1,s19,s2:rspcdva |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> P || prod_ k e. Q k )
s22::id |- ( k = q -> k = q )
s23:s22:cbvprodv |- prod_ k e. Q k = prod_ q e. Q q
s24:s23:a1i |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> prod_ k e. Q k = prod_ q e. Q q )
s25:s21,s24:breqtrd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> P || prod_ q e. Q q )
i26::lmodqval
s27:s14,i26:syl |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> ( Lmod ` Q ) = prod_ q e. Q q )
s28:s27:eqcomd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> prod_ q e. Q q = ( Lmod ` Q ) )
qed:s25,s28:breqtrd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ P e. Q ) -> P || ( Lmod ` Q ) )
$)
