$( <MM> <PROOF_ASST> THEOREM=thetaapcl  LOC_AFTER=?

* Closure: theta in a residue class is a real number.

s1::thetaapval |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( thetaAP ` Q ) Y ) = sum_ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ( log ` p ) )
s2::fzfid |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( 1 ... ( |_ ` Y ) ) e. Fin )
i3::rabfi
s4:s2,i3:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } e. Fin )
s5::simpr |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } )
i6::elrabi
s7:s5,i6:syl |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> p e. ( 1 ... ( |_ ` Y ) ) )
i8::elfznn
s9:s7,i8:syl |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> p e. NN )
i10::thetaaplem1
s11:s9,i10:syl |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> ( log ` p ) e. ( 0 [,) +oo ) )
i12::elrege0
s13:s11,i12:sylib |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> ( ( log ` p ) e. RR /\ 0 <_ ( log ` p ) ) )
s14:s13:simpld |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> ( log ` p ) e. RR )
s15:s13:simprd |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> 0 <_ ( log ` p ) )
s16:s4,s14:fsumrecl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> sum_ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ( log ` p ) e. RR )
qed:s1,s16:eqeltrd |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( thetaAP ` Q ) Y ) e. RR )
$)
