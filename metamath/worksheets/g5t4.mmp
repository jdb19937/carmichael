$( <MM> <PROOF_ASST> THEOREM=g5t4  LOC_AFTER=?

* Fast path: the same denominator and subtrahend on both sides (ltdiv1dd, ltsub1dd).

s1::simp1 |- ( ( A e. RR /\ B e. RR /\ A < B ) -> A e. RR )
s2::simp2 |- ( ( A e. RR /\ B e. RR /\ A < B ) -> B e. RR )
s3::simp3 |- ( ( A e. RR /\ B e. RR /\ A < B ) -> A < B )
s4::3re |- 3 e. RR
s5:s4:a1i |- ( ( A e. RR /\ B e. RR /\ A < B ) -> 3 e. RR )
s6:s1,s2,s5,s3:ltsub1dd |- ( ( A e. RR /\ B e. RR /\ A < B ) -> ( A - 3 ) < ( B - 3 ) )
s7:s1,s5:resubcld |- ( ( A e. RR /\ B e. RR /\ A < B ) -> ( A - 3 ) e. RR )
s8:s2,s5:resubcld |- ( ( A e. RR /\ B e. RR /\ A < B ) -> ( B - 3 ) e. RR )
s9::2rp |- 2 e. RR+
s10:s9:a1i |- ( ( A e. RR /\ B e. RR /\ A < B ) -> 2 e. RR+ )
qed:s7,s8,s10,s6:ltdiv1dd |- ( ( A e. RR /\ B e. RR /\ A < B ) -> ( ( A - 3 ) / 2 ) < ( ( B - 3 ) / 2 ) )
$)
