$( <MM> <PROOF_ASST> THEOREM=blpos  LOC_AFTER=?

* The bit length of a positive integer is log2 + 1 (Lean: bl_of_pos).

s1::nnnn0 |- ( A e. NN -> A e. NN0 )
i2::bwblval
s3:s1,i2:syl |- ( A e. NN -> ( bl ` A ) = if ( A = 0 , 0 , ( ( 2 Nlog A ) + 1 ) ) )
s4::nnne0 |- ( A e. NN -> A =/= 0 )
s5:s4:neneqd |- ( A e. NN -> -. A = 0 )
s6:s5:iffalsed |- ( A e. NN -> if ( A = 0 , 0 , ( ( 2 Nlog A ) + 1 ) ) = ( ( 2 Nlog A ) + 1 ) )
qed:s3,s6:eqtrd |- ( A e. NN -> ( bl ` A ) = ( ( 2 Nlog A ) + 1 ) )
$)
