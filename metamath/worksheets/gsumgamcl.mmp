$( <MM> <PROOF_ASST> THEOREM=gsumgamcl  LOC_AFTER=?

* The monoid sum of a word of words over Gamma' is a word over Gamma'.

s1::frmdgambas |- ( Base ` ( freeMnd ` Gamma' ) ) = Word Gamma'
s2:s1:eqcomi |- Word Gamma' = ( Base ` ( freeMnd ` Gamma' ) )
s3::frmdgam |- ( freeMnd ` Gamma' ) e. Mnd
s4:s2:gsumwcl |- ( ( ( freeMnd ` Gamma' ) e. Mnd /\ W e. Word Word Gamma' ) -> ( ( freeMnd ` Gamma' ) gsum W ) e. Word Gamma' )
qed:s3,s4:mpan |- ( W e. Word Word Gamma' -> ( ( freeMnd ` Gamma' ) gsum W ) e. Word Gamma' )
$)
