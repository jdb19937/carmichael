$( <MM> <PROOF_ASST> THEOREM=twinvf  LOC_AFTER=?

* The twin-sieve density is a real-valued function on the positive integers.

s1::id |- ( t e. NN -> t e. NN )
i2::pffinq
s3:s1,i2:syl |- ( t e. NN -> { q e. Prime | q || t } e. Fin )
s4::breq1 |- ( q = g -> ( q || t <-> g || t ) )
s5:s4:cbvrabv |- { q e. Prime | q || t } = { g e. Prime | g || t }
s6:s5:a1i |- ( t e. NN -> { q e. Prime | q || t } = { g e. Prime | g || t } )
s8::breq1 |- ( q = g -> ( q || t <-> g || t ) )
s9:s8:cbvrabv |- { q e. Prime | q || t } = { g e. Prime | g || t }
s10:s9:a1i |- ( t e. NN -> { q e. Prime | q || t } = { g e. Prime | g || t } )
s11::id |- ( t e. NN -> t e. NN )
i12::pffinq
s13:s11,i12:syl |- ( t e. NN -> { q e. Prime | q || t } e. Fin )
s14:s10,s13:eqeltrrd |- ( t e. NN -> { g e. Prime | g || t } e. Fin )
s15::breq1 |- ( g = f -> ( g || t <-> f || t ) )
s16:s15:elrab |- ( f e. { g e. Prime | g || t } <-> ( f e. Prime /\ f || t ) )
s17:s16:a1i |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> ( f e. { g e. Prime | g || t } <-> ( f e. Prime /\ f || t ) ) )
s18::simpr |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. { g e. Prime | g || t } )
s19:s17,s18:mpbid |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> ( f e. Prime /\ f || t ) )
s20:s19:simpld |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. Prime )
s21::2re |- 2 e. RR
s22:s21:a1i |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> 2 e. RR )
i23::prmnn
s24:s20,i23:syl |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. NN )
s25:s24:nnrpd |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. RR+ )
s26:s22,s25:rerpdivcld |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> ( 2 / f ) e. RR )
s28::2re |- 2 e. RR
s29:s28:a1i |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> 2 e. RR )
i30::prmnn
s31:s20,i30:syl |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. NN )
s32:s31:nnrpd |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> f e. RR+ )
s33:s29,s32:rerpdivcld |- ( ( t e. NN /\ f e. { g e. Prime | g || t } ) -> ( 2 / f ) e. RR )
s34:s14,s33:fprodrecl |- ( t e. NN -> prod_ f e. { g e. Prime | g || t } ( 2 / f ) e. RR )
s35:s34:rgen |- A. t e. NN prod_ f e. { g e. Prime | g || t } ( 2 / f ) e. RR
s36::eqid |- ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) ) = ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) )
s37:s36:fmpt |- ( A. t e. NN prod_ f e. { g e. Prime | g || t } ( 2 / f ) e. RR <-> ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) ) : NN --> RR )
qed:s35,s37:mpbi |- ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) ) : NN --> RR
$)
