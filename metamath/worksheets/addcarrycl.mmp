$( <MM> <PROOF_ASST> THEOREM=addcarrycl  LOC_AFTER=?

* Closure of addCarry: a bit word.

s1::id |- ( C e. 2o -> C e. 2o )
s2::addcarryval |- ( C e. 2o -> ( addCarry ` C ) = if ( C = 1o , <" 1o "> , (/) ) )
s3::1oel2o |- 1o e. 2o
s4:s3:a1i |- ( C e. 2o -> 1o e. 2o )
i5::s1cl
s6:s4,i5:syl |- ( C e. 2o -> <" 1o "> e. Word 2o )
s7::wrd0 |- (/) e. Word 2o
s8:s7:a1i |- ( C e. 2o -> (/) e. Word 2o )
s9:s6,s8:ifcld |- ( C e. 2o -> if ( C = 1o , <" 1o "> , (/) ) e. Word 2o )
qed:s2,s9:eqeltrd |- ( C e. 2o -> ( addCarry ` C ) e. Word 2o )
$)
