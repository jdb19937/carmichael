$( <MM> <PROOF_ASST> THEOREM=z6ehder  LOC_AFTER=?

* Helper of z6mrhol: the derivative of a function HOL on CC is a function CC --> CC, equal to the mapping of its values.

s1::simpr |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> CC C_ dom ( CC _D ( s e. CC |-> A ) ) )
s2::dvbsss |- dom ( CC _D ( s e. CC |-> A ) ) C_ CC
s3:s2:a1i |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> dom ( CC _D ( s e. CC |-> A ) ) C_ CC )
s4:s3,s1:eqssd |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> dom ( CC _D ( s e. CC |-> A ) ) = CC )
s5::dvfcn |- ( CC _D ( s e. CC |-> A ) ) : dom ( CC _D ( s e. CC |-> A ) ) --> CC
s6:s5:a1i |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( CC _D ( s e. CC |-> A ) ) : dom ( CC _D ( s e. CC |-> A ) ) --> CC )
s7:s4:feq2d |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( ( CC _D ( s e. CC |-> A ) ) : dom ( CC _D ( s e. CC |-> A ) ) --> CC <-> ( CC _D ( s e. CC |-> A ) ) : CC --> CC ) )
s8:s6,s7:mpbid |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( CC _D ( s e. CC |-> A ) ) : CC --> CC )
s9:s8:ffnd |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( CC _D ( s e. CC |-> A ) ) Fn CC )
s10::nfcv |- F/_ s CC
s11::nfcv |- F/_ s _D
s12::nfmpt1 |- F/_ s ( s e. CC |-> A )
s13:s10,s11,s12:nfov |- F/_ s ( CC _D ( s e. CC |-> A ) )
s14:s13:dffn5f |- ( ( CC _D ( s e. CC |-> A ) ) Fn CC <-> ( CC _D ( s e. CC |-> A ) ) = ( s e. CC |-> ( ( CC _D ( s e. CC |-> A ) ) ` s ) ) )
s15:s14:a1i |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( ( CC _D ( s e. CC |-> A ) ) Fn CC <-> ( CC _D ( s e. CC |-> A ) ) = ( s e. CC |-> ( ( CC _D ( s e. CC |-> A ) ) ` s ) ) ) )
s16:s9,s15:mpbid |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( CC _D ( s e. CC |-> A ) ) = ( s e. CC |-> ( ( CC _D ( s e. CC |-> A ) ) ` s ) ) )
qed:s8,s16:jca |- ( ( ( s e. CC |-> A ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( s e. CC |-> A ) ) ) -> ( ( CC _D ( s e. CC |-> A ) ) : CC --> CC /\ ( CC _D ( s e. CC |-> A ) ) = ( s e. CC |-> ( ( CC _D ( s e. CC |-> A ) ) ` s ) ) ) )
