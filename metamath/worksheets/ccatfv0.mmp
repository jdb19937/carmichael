$( <MM> <PROOF_ASST> THEOREM=ccatfv0  LOC_AFTER=?

* The first letter of a concatenation with a nonempty left factor.

s1::simp1 |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> U e. Word A )
s2::simp2 |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> U =/= (/) )
s3::simp3 |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> W e. Word A )
i4::lennncl
s5:s1,s2,i4:syl2anc |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> ( # ` U ) e. NN )
i6::lbfzo0
s7:s5,i6:sylibr |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> 0 e. ( 0 ..^ ( # ` U ) ) )
i8::ccatval1
qed:s1,s3,s7,i8:syl3anc |- ( ( U e. Word A /\ U =/= (/) /\ W e. Word A ) -> ( ( U ++ W ) ` 0 ) = ( U ` 0 ) )
$)
