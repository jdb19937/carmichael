$( <MM> <PROOF_ASST> THEOREM=bwcarriesdec  LOC_AFTER=?

* The run decomposition of the carry chain (the interface incLoop reads): L is carries true letters followed by a rest that is empty or starts with false.

s1::bwcarriesdec1 |- ( L e. Word 2o -> L = ( ( 1o repeatS ( carries ` L ) ) ++ ( L substr <. ( carries ` L ) , ( # ` L ) >. ) ) )
s2::bwcarriesdec2 |- ( ( L e. Word 2o /\ ( L substr <. ( carries ` L ) , ( # ` L ) >. ) =/= (/) ) -> ( ( L substr <. ( carries ` L ) , ( # ` L ) >. ) ` 0 ) = (/) )
s3:s2:ex |- ( L e. Word 2o -> ( ( L substr <. ( carries ` L ) , ( # ` L ) >. ) =/= (/) -> ( ( L substr <. ( carries ` L ) , ( # ` L ) >. ) ` 0 ) = (/) ) )
qed:s1,s3:jca |- ( L e. Word 2o -> ( L = ( ( 1o repeatS ( carries ` L ) ) ++ ( L substr <. ( carries ` L ) , ( # ` L ) >. ) ) /\ ( ( L substr <. ( carries ` L ) , ( # ` L ) >. ) =/= (/) -> ( ( L substr <. ( carries ` L ) , ( # ` L ) >. ) ` 0 ) = (/) ) ) )
$)
