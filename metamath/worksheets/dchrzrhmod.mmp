$( <MM> <PROOF_ASST> THEOREM=dchrzrhmod  LOC_AFTER=?

* A Dirichlet character at the class of the residue of A is its value at the class of A.

s1::simpl |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) )
s2:s1:simpld |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> N e. NN )
s3::simpr |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> A e. ZZ )
i4::zmodcl
s5:s3,s2,i4:syl2anc |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( A mod N ) e. NN0 )
s6:s5:nn0zd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( A mod N ) e. ZZ )
i7::zmoddvds
s8:s2,s3,i7:syl2anc |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> N || ( ( A mod N ) - A ) )
s9:s2:nnnn0d |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> N e. NN0 )
s10::eqid |- ( Z/nZ ` N ) = ( Z/nZ ` N )
s11::eqid |- ( ZRHom ` ( Z/nZ ` N ) ) = ( ZRHom ` ( Z/nZ ` N ) )
s12:s10,s11:zndvds |- ( ( N e. NN0 /\ ( A mod N ) e. ZZ /\ A e. ZZ ) -> ( ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( A mod N ) ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) <-> N || ( ( A mod N ) - A ) ) )
s13:s9,s6,s3,s12:syl3anc |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( A mod N ) ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) <-> N || ( ( A mod N ) - A ) ) )
s14:s8,s13:mpbird |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( A mod N ) ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) )
qed:s14:fveq2d |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( A mod N ) ) ) = ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) )
$)
