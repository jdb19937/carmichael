$( <MM> <PROOF_ASST> THEOREM=blcl  LOC_AFTER=?

* Closure of bl: a nonnegative integer.

s1::id |- ( A e. NN0 -> A e. NN0 )
s2::bwblval |- ( A e. NN0 -> ( bl ` A ) = if ( A = 0 , 0 , ( ( 2 Nlog A ) + 1 ) ) )
s3::0nn0 |- 0 e. NN0
s4:s3:a1i |- ( A e. NN0 -> 0 e. NN0 )
s5::2nn0 |- 2 e. NN0
s6:s5:a1i |- ( A e. NN0 -> 2 e. NN0 )
i7::nlogcl
s8:s6,s1,i7:syl2anc |- ( A e. NN0 -> ( 2 Nlog A ) e. NN0 )
s9::1nn0 |- 1 e. NN0
s10:s9:a1i |- ( A e. NN0 -> 1 e. NN0 )
s11:s8,s10:nn0addcld |- ( A e. NN0 -> ( ( 2 Nlog A ) + 1 ) e. NN0 )
s12:s4,s11:ifcld |- ( A e. NN0 -> if ( A = 0 , 0 , ( ( 2 Nlog A ) + 1 ) ) e. NN0 )
qed:s2,s12:eqeltrd |- ( A e. NN0 -> ( bl ` A ) e. NN0 )
$)
