$( <MM> <PROOF_ASST> THEOREM=algprodrn  LOC_AFTER=?

* The product over a duplicate-free word is the product over its entries (Lean: List.prod_toFinset).

s1::simpl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W e. Word NN0 )
s2::simpr |- ( ( W e. Word NN0 /\ Fun `' W ) -> Fun `' W )
i3::wrdfn
s4:s1,i3:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W Fn ( 0 ..^ ( # ` W ) ) )
i5::dffn4
s6:s4,i5:sylib |- ( ( W e. Word NN0 /\ Fun `' W ) -> W : ( 0 ..^ ( # ` W ) ) -onto-> ran W )
i7::wrdf
s8:s1,i7:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W : ( 0 ..^ ( # ` W ) ) --> NN0 )
s9:s8,s2:jca |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( W : ( 0 ..^ ( # ` W ) ) --> NN0 /\ Fun `' W ) )
i10::df-f1
s11:s9,i10:sylibr |- ( ( W e. Word NN0 /\ Fun `' W ) -> W : ( 0 ..^ ( # ` W ) ) -1-1-> NN0 )
i12::f1f1orn
s13:s11,i12:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W : ( 0 ..^ ( # ` W ) ) -1-1-onto-> ran W )
s14::id |- ( q = ( W ` i ) -> q = ( W ` i ) )
s15::fzofi |- ( 0 ..^ ( # ` W ) ) e. Fin
s16:s15:a1i |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( 0 ..^ ( # ` W ) ) e. Fin )
s17::eqidd |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ i e. ( 0 ..^ ( # ` W ) ) ) -> ( W ` i ) = ( W ` i ) )
s18:s1:adantr |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ q e. ran W ) -> W e. Word NN0 )
s19::simpr |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ q e. ran W ) -> q e. ran W )
s20:s18,s19:jca |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ q e. ran W ) -> ( W e. Word NN0 /\ q e. ran W ) )
i21::algwrdrn
s22:s20,i21:syl |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ q e. ran W ) -> q e. NN0 )
s23:s22:nn0cnd |- ( ( ( W e. Word NN0 /\ Fun `' W ) /\ q e. ran W ) -> q e. CC )
s24:s14,s16,s13,s17,s23:fprodf1o |- ( ( W e. Word NN0 /\ Fun `' W ) -> prod_ q e. ran W q = prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) )
qed:s24:eqcomd |- ( ( W e. Word NN0 /\ Fun `' W ) -> prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) = prod_ q e. ran W q )
$)
