s10:s5:eqcomd |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> 1 = ( E x. E ) )
s11:s10:oveq1d |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( 1 x. X ) = ( ( E x. E ) x. X ) )
s12:s4,s4,s1:mulassd |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( ( E x. E ) x. X ) = ( E x. ( E x. X ) ) )
s13:s11,s12:eqtrd |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( 1 x. X ) = ( E x. ( E x. X ) ) )
s14:s13:oveq1d |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( ( 1 x. X ) / ( E x. F ) ) = ( ( E x. ( E x. X ) ) / ( E x. F ) ) )
s15:s4,s1:mulcld |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( E x. X ) e. CC )
s16:s15,s2,s4,s3,s9:divcan5d |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( ( E x. ( E x. X ) ) / ( E x. F ) ) = ( ( E x. X ) / F ) )
qed:s14,s16:eqtrd |- ( ( ( X e. CC /\ F e. CC /\ F =/= 0 ) /\ ( E e. CC /\ ( E x. E ) = 1 ) ) -> ( ( 1 x. X ) / ( E x. F ) ) = ( ( E x. X ) / F ) )
