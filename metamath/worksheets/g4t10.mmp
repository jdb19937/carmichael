$( <MM> <PROOF_ASST> THEOREM=g4t10  LOC_AFTER=?

* The rules of tools/cl.py for a cartesian product and a greatest common divisor: ` xpfi ` , ` xpexg ` , ` gcdcld ` and ` gcdnncl ` .

s1::simpll |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> A e. Fin )
s2::simplr |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> B e. Fin )
s3::simprl |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> M e. ZZ )
s4::simprr |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> N e. NN )
i5::xpfi
s6:s1,s2,i5:syl2anc |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> ( A X. B ) e. Fin )
s7:s1:elexd |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> A e. _V )
s8:s2:elexd |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> B e. _V )
i9::xpexg
s10:s7,s8,i9:syl2anc |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> ( A X. B ) e. _V )
s11:s4:nnnn0d |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> N e. NN0 )
s12:s11:nn0zd |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> N e. ZZ )
s13:s3,s12:gcdcld |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> ( M gcd N ) e. NN0 )
qed:s6,s10,s13:3jca |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( M e. ZZ /\ N e. NN ) ) -> ( ( A X. B ) e. Fin /\ ( A X. B ) e. _V /\ ( M gcd N ) e. NN0 ) )
$)
