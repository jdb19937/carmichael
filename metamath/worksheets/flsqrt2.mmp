s30:s28,s29:jca |- ( ( A e. RR /\ 0 <_ A ) -> ( ( ( |_ ` ( sqrt ` A ) ) + 1 ) e. RR /\ 0 <_ ( ( |_ ` ( sqrt ` A ) ) + 1 ) ) )
s31:s8,s30:jca |- ( ( A e. RR /\ 0 <_ A ) -> ( ( ( sqrt ` A ) e. RR /\ 0 <_ ( sqrt ` A ) ) /\ ( ( ( |_ ` ( sqrt ` A ) ) + 1 ) e. RR /\ 0 <_ ( ( |_ ` ( sqrt ` A ) ) + 1 ) ) ) )
i32::lt2sq
