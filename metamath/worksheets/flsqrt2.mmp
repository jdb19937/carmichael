s18:s13,s8:jca |- ( ( A e. RR /\ 0 <_ A ) -> ( ( ( |_ ` ( sqrt ` A ) ) e. RR /\ 0 <_ ( |_ ` ( sqrt ` A ) ) ) /\ ( ( sqrt ` A ) e. RR /\ 0 <_ ( sqrt ` A ) ) ) )
i19::le2sq
s20:s18,i19:syl |- ( ( A e. RR /\ 0 <_ A ) -> ( ( |_ ` ( sqrt ` A ) ) <_ ( sqrt ` A ) <-> ( ( |_ ` ( sqrt ` A ) ) ^ 2 ) <_ ( ( sqrt ` A ) ^ 2 ) ) )
s21:s20,s15:mpbid |- ( ( A e. RR /\ 0 <_ A ) -> ( ( |_ ` ( sqrt ` A ) ) ^ 2 ) <_ ( ( sqrt ` A ) ^ 2 ) )
