$( <MM> <PROOF_ASST> THEOREM=revtl  LOC_AFTER=?

* The labels of the reverse machine.

s1::id |- ( A e. V -> A e. V )
s2::opex |- <. { <. (/) , A >. , <. 1o , A >. } , 1o >. e. _V
s3:s2:a1i |- ( A e. V -> <. { <. (/) , A >. , <. 1o , A >. } , 1o >. e. _V )
s4::1oex |- 1o e. _V
s5:s4:a1i |- ( A e. V -> 1o e. _V )
i6::djuex
s7:s1,s5,i6:syl2anc |- ( A e. V -> ( A |_| 1o ) e. _V )
i8::op1stg
s9:s3,s7,i8:syl2anc |- ( A e. V -> ( 1st ` <. <. { <. (/) , A >. , <. 1o , A >. } , 1o >. , ( A |_| 1o ) >. ) = <. { <. (/) , A >. , <. 1o , A >. } , 1o >. )
s10:s9:fveq2d |- ( A e. V -> ( 2nd ` ( 1st ` <. <. { <. (/) , A >. , <. 1o , A >. } , 1o >. , ( A |_| 1o ) >. ) ) = ( 2nd ` <. { <. (/) , A >. , <. 1o , A >. } , 1o >. ) )
s11::prex |- { <. (/) , A >. , <. 1o , A >. } e. _V
s12:s11:a1i |- ( A e. V -> { <. (/) , A >. , <. 1o , A >. } e. _V )
i13::op2ndg
s14:s12,s5,i13:syl2anc |- ( A e. V -> ( 2nd ` <. { <. (/) , A >. , <. 1o , A >. } , 1o >. ) = 1o )
qed:s10,s14:eqtrd |- ( A e. V -> ( 2nd ` ( 1st ` <. <. { <. (/) , A >. , <. 1o , A >. } , 1o >. , ( A |_| 1o ) >. ) ) = 1o )
$)
