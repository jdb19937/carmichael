$( <MM> <PROOF_ASST> THEOREM=wrdhdtl  LOC_AFTER=?

* A nonempty word is its first letter followed by its tail.

s1::simpl |- ( ( U e. Word A /\ U =/= (/) ) -> U e. Word A )
s2::lennncl |- ( ( U e. Word A /\ U =/= (/) ) -> ( # ` U ) e. NN )
i3::nnnn0
s4:s2,i3:syl |- ( ( U e. Word A /\ U =/= (/) ) -> ( # ` U ) e. NN0 )
i5::nnge1
s6:s2,i5:syl |- ( ( U e. Word A /\ U =/= (/) ) -> 1 <_ ( # ` U ) )
s7::1nn0 |- 1 e. NN0
s8:s7:a1i |- ( ( U e. Word A /\ U =/= (/) ) -> 1 e. NN0 )
s9::elfz2nn0 |- ( 1 e. ( 0 ... ( # ` U ) ) <-> ( 1 e. NN0 /\ ( # ` U ) e. NN0 /\ 1 <_ ( # ` U ) ) )
s10:s8,s4,s6,s9:syl3anbrc |- ( ( U e. Word A /\ U =/= (/) ) -> 1 e. ( 0 ... ( # ` U ) ) )
s11::nn0fz0 |- ( ( # ` U ) e. NN0 <-> ( # ` U ) e. ( 0 ... ( # ` U ) ) )
s12:s4,s11:sylib |- ( ( U e. Word A /\ U =/= (/) ) -> ( # ` U ) e. ( 0 ... ( # ` U ) ) )
i13::ccatpfx
s14:s1,s10,s12,i13:syl3anc |- ( ( U e. Word A /\ U =/= (/) ) -> ( ( U prefix 1 ) ++ ( U substr <. 1 , ( # ` U ) >. ) ) = ( U prefix ( # ` U ) ) )
s15::pfx1 |- ( ( U e. Word A /\ U =/= (/) ) -> ( U prefix 1 ) = <" ( U ` 0 ) "> )
s16:s15:oveq1d |- ( ( U e. Word A /\ U =/= (/) ) -> ( ( U prefix 1 ) ++ ( U substr <. 1 , ( # ` U ) >. ) ) = ( <" ( U ` 0 ) "> ++ ( U substr <. 1 , ( # ` U ) >. ) ) )
i17::pfxid
s18:s1,i17:syl |- ( ( U e. Word A /\ U =/= (/) ) -> ( U prefix ( # ` U ) ) = U )
s19:s16,s14:eqtr3d |- ( ( U e. Word A /\ U =/= (/) ) -> ( <" ( U ` 0 ) "> ++ ( U substr <. 1 , ( # ` U ) >. ) ) = ( U prefix ( # ` U ) ) )
s20:s19,s18:eqtrd |- ( ( U e. Word A /\ U =/= (/) ) -> ( <" ( U ` 0 ) "> ++ ( U substr <. 1 , ( # ` U ) >. ) ) = U )
qed:s20:eqcomd |- ( ( U e. Word A /\ U =/= (/) ) -> U = ( <" ( U ` 0 ) "> ++ ( U substr <. 1 , ( # ` U ) >. ) ) )
