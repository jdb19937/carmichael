$( <MM> <PROOF_ASST> THEOREM=twinwt  LOC_AFTER=?

* The weights of the twin sieve are the constant function 1.

s1::1red |- ( c e. NN -> 1 e. RR )
s2:s1:rgen |- A. c e. NN 1 e. RR
s3::eqid |- ( c e. NN |-> 1 ) = ( c e. NN |-> 1 )
s4:s3:fmpt |- ( A. c e. NN 1 e. RR <-> ( c e. NN |-> 1 ) : NN --> RR )
s5:s2,s4:mpbi |- ( c e. NN |-> 1 ) : NN --> RR
s6::1ex |- 1 e. _V
s7::id |- ( k e. NN -> k e. NN )
s8:s6:a1i |- ( k e. NN -> 1 e. _V )
s9:s7,s8:jca |- ( k e. NN -> ( k e. NN /\ 1 e. _V ) )
s10::eqidd |- ( c = k -> 1 = 1 )
s11::eqid |- ( c e. NN |-> 1 ) = ( c e. NN |-> 1 )
s12:s10,s11:fvmptg |- ( ( k e. NN /\ 1 e. _V ) -> ( ( c e. NN |-> 1 ) ` k ) = 1 )
s13:s12:a1i |- ( k e. NN -> ( ( k e. NN /\ 1 e. _V ) -> ( ( c e. NN |-> 1 ) ` k ) = 1 ) )
s14:s9,s13:mpd |- ( k e. NN -> ( ( c e. NN |-> 1 ) ` k ) = 1 )
s15::0le1 |- 0 <_ 1
s16:s15:a1i |- ( k e. NN -> 0 <_ 1 )
s17:s14:eqcomd |- ( k e. NN -> 1 = ( ( c e. NN |-> 1 ) ` k ) )
s18:s16,s17:breqtrd |- ( k e. NN -> 0 <_ ( ( c e. NN |-> 1 ) ` k ) )
s19:s18:rgen |- A. k e. NN 0 <_ ( ( c e. NN |-> 1 ) ` k )
qed:s5,s19:pm3.2i |- ( ( c e. NN |-> 1 ) : NN --> RR /\ A. k e. NN 0 <_ ( ( c e. NN |-> 1 ) ` k ) )
$)
