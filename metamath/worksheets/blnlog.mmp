$( <MM> <PROOF_ASST> THEOREM=blnlog  LOC_AFTER=?

* The binary logarithm of a positive integer is its bit length less one.

s1::blpos |- ( A e. NN -> ( bl ` A ) = ( ( 2 Nlog A ) + 1 ) )
s2::id |- ( A e. NN -> A e. NN )
s3::2nn0 |- 2 e. NN0
s4:s3:a1i |- ( A e. NN -> 2 e. NN0 )
s5:s2:nnnn0d |- ( A e. NN -> A e. NN0 )
i6::nlogcl
s7:s4,s5,i6:syl2anc |- ( A e. NN -> ( 2 Nlog A ) e. NN0 )
s8:s7:nn0zd |- ( A e. NN -> ( 2 Nlog A ) e. ZZ )
s9:s8:zred |- ( A e. NN -> ( 2 Nlog A ) e. RR )
s10:s9:recnd |- ( A e. NN -> ( 2 Nlog A ) e. CC )
s11::1cnd |- ( A e. NN -> 1 e. CC )
s12:s10,s11:pncand |- ( A e. NN -> ( ( ( 2 Nlog A ) + 1 ) - 1 ) = ( 2 Nlog A ) )
s13:s1:oveq1d |- ( A e. NN -> ( ( bl ` A ) - 1 ) = ( ( ( 2 Nlog A ) + 1 ) - 1 ) )
qed:s13,s12:eqtr2d |- ( A e. NN -> ( 2 Nlog A ) = ( ( bl ` A ) - 1 ) )
$)
