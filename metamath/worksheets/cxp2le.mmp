$( <MM> <PROOF_ASST> THEOREM=cxp2le  LOC_AFTER=?

* Two to a negative power below minus one is at most one half; below minus two, at most one quarter.

s1::simpll |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> T e. RR )
s2::simplr |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> U e. RR )
s3::simpr |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> T <_ U )
s4::2re |- 2 e. RR
s5:s4:a1i |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> 2 e. RR )
s6::1lt2 |- 1 < 2
s7:s6:a1i |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> 1 < 2 )
s8:s5,s7,s1,s2:cxpled |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> ( T <_ U <-> ( 2 ^c T ) <_ ( 2 ^c U ) ) )
qed:s3,s8:mpbid |- ( ( ( T e. RR /\ U e. RR ) /\ T <_ U ) -> ( 2 ^c T ) <_ ( 2 ^c U ) )
