$( <MM> <PROOF_ASST> THEOREM=s3sum  LOC_AFTER=?

* The reciprocal sum over the prime divisors of L is the reciprocal sum over Q.

s1::simpl |- ( ( S e. ( ~P Prime i^i Fin ) /\ sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) ) -> S e. ( ~P Prime i^i Fin ) )
s2::simpr |- ( ( S e. ( ~P Prime i^i Fin ) /\ sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) ) -> sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) )
i3::prmprodset
s4:s1,i3:syl |- ( ( S e. ( ~P Prime i^i Fin ) /\ sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) ) -> { p e. Prime | p || ( Lmod ` S ) } = S )
s5:s4:sumeq1d |- ( ( S e. ( ~P Prime i^i Fin ) /\ sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) ) -> sum_ q e. { p e. Prime | p || ( Lmod ` S ) } ( 1 / q ) = sum_ q e. S ( 1 / q ) )
qed:s5,s2:eqbrtrd |- ( ( S e. ( ~P Prime i^i Fin ) /\ sum_ q e. S ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) ) -> sum_ q e. { p e. Prime | p || ( Lmod ` S ) } ( 1 / q ) <_ ( 3 / ; ; 1 6 0 ) )
$)
