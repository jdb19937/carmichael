$( <MM> <PROOF_ASST> THEOREM=zscalecl  LOC_AFTER=?

* Closure of zscale: a nonnegative integer for N >= 3 (where ell2 N and ell3 N are real).

s1::simpl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> C e. RR )
s2::simpr |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> N e. ( ZZ>= ` 3 ) )
i3::uzuzle23
s4:s2,i3:syl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> N e. ( ZZ>= ` 2 ) )
i5::eluz2nn
s6:s4,i5:syl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> N e. NN )
s7:s6:nnnn0d |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> N e. NN0 )
i8::ell2cl
s9:s4,i8:syl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( ell2 ` N ) e. RR )
i10::ell3cl
s11:s2,i10:syl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( ell3 ` N ) e. RR )
s12:s1,s9:remulcld |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( C x. ( ell2 ` N ) ) e. RR )
s13:s12,s11:remulcld |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( ( C x. ( ell2 ` N ) ) x. ( ell3 ` N ) ) e. RR )
i14::zscaleval
s15:s1,s7,i14:syl2anc |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( C zscale N ) = ( Nceil ` ( ( C x. ( ell2 ` N ) ) x. ( ell3 ` N ) ) ) )
i16::nceilcl
s17:s13,i16:syl |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( Nceil ` ( ( C x. ( ell2 ` N ) ) x. ( ell3 ` N ) ) ) e. NN0 )
qed:s15,s17:eqeltrd |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) ) -> ( C zscale N ) e. NN0 )
$)
