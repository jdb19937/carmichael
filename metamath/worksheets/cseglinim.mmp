$( <MM> <PROOF_ASST> THEOREM=cseglinim  LOC_AFTER=?

* The imaginary part of a point of the parametrisation of a segment.

s1::simp1 |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> A e. CC )
s2::simp2 |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> B e. CC )
s3::simp3 |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> T e. RR )
s4:s3:recnd |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> T e. CC )
s5:s2,s1:subcld |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( B - A ) e. CC )
s6:s4,s5:mulcld |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( T x. ( B - A ) ) e. CC )
i7::imadd
s8:s1,s6,i7:syl2anc |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( Im ` ( A + ( T x. ( B - A ) ) ) ) = ( ( Im ` A ) + ( Im ` ( T x. ( B - A ) ) ) ) )
i9::immul2
s10:s3,s5,i9:syl2anc |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( Im ` ( T x. ( B - A ) ) ) = ( T x. ( Im ` ( B - A ) ) ) )
i11::imsub
s12:s2,s1,i11:syl2anc |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( Im ` ( B - A ) ) = ( ( Im ` B ) - ( Im ` A ) ) )
s13:s12:oveq2d |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( T x. ( Im ` ( B - A ) ) ) = ( T x. ( ( Im ` B ) - ( Im ` A ) ) ) )
s14:s10,s13:eqtrd |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( Im ` ( T x. ( B - A ) ) ) = ( T x. ( ( Im ` B ) - ( Im ` A ) ) ) )
s15:s14:oveq2d |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( ( Im ` A ) + ( Im ` ( T x. ( B - A ) ) ) ) = ( ( Im ` A ) + ( T x. ( ( Im ` B ) - ( Im ` A ) ) ) ) )
qed:s8,s15:eqtrd |- ( ( A e. CC /\ B e. CC /\ T e. RR ) -> ( Im ` ( A + ( T x. ( B - A ) ) ) ) = ( ( Im ` A ) + ( T x. ( ( Im ` B ) - ( Im ` A ) ) ) ) )
$)
