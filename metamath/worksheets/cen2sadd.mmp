$( <MM> <PROOF_ASST> THEOREM=cen2sadd  LOC_AFTER=?

* The sum of two convergent series converges to the sum of the values ( ~ climadd on the partial sums, ~ seradd ).

s1::simp1 |- ( ( ( F : NN --> CC /\ G : NN --> CC /\ H : NN --> CC ) /\ ( seq 1 ( + , F ) ~~> A /\ seq 1 ( + , G ) ~~> B ) /\ A. a e. NN ( H ` a ) = ( ( F ` a ) + ( G ` a ) ) ) -> ( F : NN --> CC /\ G : NN --> CC /\ H : NN --> CC ) )
s2::simp2 |- ( ( ( F : NN --> CC /\ G : NN --> CC /\ H : NN --> CC ) /\ ( seq 1 ( + , F ) ~~> A /\ seq 1 ( + , G ) ~~> B ) /\ A. a e. NN ( H ` a ) = ( ( F ` a ) + ( G ` a ) ) ) -> ( seq 1 ( + , F ) ~~> A /\ seq 1 ( + , G ) ~~> B ) )
s3::simp3 |- ( ( ( F : NN --> CC /\ G : NN --> CC /\ H : NN --> CC ) /\ ( seq 1 ( + , F ) ~~> A /\ seq 1 ( + , G ) ~~> B ) /\ A. a e. NN ( H ` a ) = ( ( F ` a ) + ( G ` a ) ) ) -> A. a e. NN ( H ` a ) = ( ( F ` a ) + ( G ` a ) ) )
