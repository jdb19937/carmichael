$( <MM> <PROOF_ASST> THEOREM=progvcl  LOC_AFTER=?

* The density of the progression sieve is a real-valued function on the positive integers.

s1::simpr |- ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) -> t e. NN )
i2::pffinq
s3:s1,i2:syl |- ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) -> { q e. Prime | q || t } e. Fin )
s4::breq1 |- ( q = g -> ( q || t <-> g || t ) )
s5:s4:cbvrabv |- { q e. Prime | q || t } = { g e. Prime | g || t }
s6:s5:a1i |- ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) -> { q e. Prime | q || t } = { g e. Prime | g || t } )
s7:s6,s3:eqeltrrd |- ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) -> { g e. Prime | g || t } e. Fin )
s8::simpr |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> f e. { g e. Prime | g || t } )
i9::elrabi
s10:s8,i9:syl |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> f e. Prime )
i11::prmnn
s12:s10,i11:syl |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> f e. NN )
i13::nnrp
s14:s12,i13:syl |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> f e. RR+ )
s15:s14:rpreccld |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> ( 1 / f ) e. RR+ )
s16:s15:rpred |- ( ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) /\ f e. { g e. Prime | g || t } ) -> ( 1 / f ) e. RR )
s17:s7,s16:fprodrecl |- ( ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) /\ t e. NN ) -> prod_ f e. { g e. Prime | g || t } ( 1 / f ) e. RR )
s18::eqid |- ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) = ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) )
qed:s17,s18:fmptd |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) : NN --> RR )
