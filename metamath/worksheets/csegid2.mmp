$( <MM> <PROOF_ASST> THEOREM=csegid2  LOC_AFTER=?

* The second endpoint lies in the segment.

s1::simpl |- ( ( A e. CC /\ B e. CC ) -> A e. CC )
s2::simpr |- ( ( A e. CC /\ B e. CC ) -> B e. CC )
s3::1elunit |- 1 e. ( 0 [,] 1 )
s4:s3:a1i |- ( ( A e. CC /\ B e. CC ) -> 1 e. ( 0 [,] 1 ) )
i5::cseglin
s6:s1,s2,s4,i5:syl3anc |- ( ( A e. CC /\ B e. CC ) -> ( A + ( 1 x. ( B - A ) ) ) e. ( A cseg B ) )
s7:s2,s1:subcld |- ( ( A e. CC /\ B e. CC ) -> ( B - A ) e. CC )
s8:s7:mullidd |- ( ( A e. CC /\ B e. CC ) -> ( 1 x. ( B - A ) ) = ( B - A ) )
s9:s8:oveq2d |- ( ( A e. CC /\ B e. CC ) -> ( A + ( 1 x. ( B - A ) ) ) = ( A + ( B - A ) ) )
s10:s1,s2:pncan3d |- ( ( A e. CC /\ B e. CC ) -> ( A + ( B - A ) ) = B )
s11:s9,s10:eqtrd |- ( ( A e. CC /\ B e. CC ) -> ( A + ( 1 x. ( B - A ) ) ) = B )
qed:s11,s6:eqeltrrd |- ( ( A e. CC /\ B e. CC ) -> B e. ( A cseg B ) )
$)
