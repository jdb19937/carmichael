$( <MM> <PROOF_ASST> THEOREM=bwbnle1  LOC_AFTER=?

* The value of a Boolean is at most 1.

s1::id |- ( C e. 2o -> C e. 2o )
i2::bwel2o
s3:s1,i2:syl |- ( C e. 2o -> ( C = (/) \/ C = 1o ) )
s4::simpr |- ( ( C e. 2o /\ C = (/) ) -> C = (/) )
s5:s4:fveq2d |- ( ( C e. 2o /\ C = (/) ) -> ( bToNat ` C ) = ( bToNat ` (/) ) )
s6::bwbn0 |- ( bToNat ` (/) ) = 0
s7:s5,s6:eqtrdi |- ( ( C e. 2o /\ C = (/) ) -> ( bToNat ` C ) = 0 )
s8::0le1 |- 0 <_ 1
s9:s8:a1i |- ( ( C e. 2o /\ C = (/) ) -> 0 <_ 1 )
s10:s7,s9:eqbrtrd |- ( ( C e. 2o /\ C = (/) ) -> ( bToNat ` C ) <_ 1 )
s11::simpr |- ( ( C e. 2o /\ C = 1o ) -> C = 1o )
s12:s11:fveq2d |- ( ( C e. 2o /\ C = 1o ) -> ( bToNat ` C ) = ( bToNat ` 1o ) )
s13::bwbn1 |- ( bToNat ` 1o ) = 1
s14:s12,s13:eqtrdi |- ( ( C e. 2o /\ C = 1o ) -> ( bToNat ` C ) = 1 )
s15::1le1 |- 1 <_ 1
s16:s15:a1i |- ( ( C e. 2o /\ C = 1o ) -> 1 <_ 1 )
s17:s14,s16:eqbrtrd |- ( ( C e. 2o /\ C = 1o ) -> ( bToNat ` C ) <_ 1 )
qed:s10,s17,s3:mpjaodan |- ( C e. 2o -> ( bToNat ` C ) <_ 1 )
$)
