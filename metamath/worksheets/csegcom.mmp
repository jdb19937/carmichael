$( <MM> <PROOF_ASST> THEOREM=csegcom  LOC_AFTER=?

* A segment does not depend on the order of its endpoints.

s1::csegcomlem |- ( ( A e. CC /\ B e. CC ) -> ( A cseg B ) C_ ( B cseg A ) )
s2::csegcomlem |- ( ( B e. CC /\ A e. CC ) -> ( B cseg A ) C_ ( A cseg B ) )
s3:s2:ancoms |- ( ( A e. CC /\ B e. CC ) -> ( B cseg A ) C_ ( A cseg B ) )
qed:s1,s3:eqssd |- ( ( A e. CC /\ B e. CC ) -> ( A cseg B ) = ( B cseg A ) )
$)
