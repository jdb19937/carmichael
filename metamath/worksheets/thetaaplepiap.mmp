$( <MM> <PROOF_ASST> THEOREM=thetaaplepiap  LOC_AFTER=?

* theta in a residue class is at most the prime count of the class times log Y (Lean: thetaAP_le_piAP_mul_log; Y positive).

s1::simp1 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> Q e. NN )
s2::simp2 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> A e. ZZ )
s3::simp3 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> Y e. RR+ )
s4:s3:rpred |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> Y e. RR )
s5:s1,s2,s4:3jca |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> ( Q e. NN /\ A e. ZZ /\ Y e. RR ) )
i6::thetaapval
s7:s5,i6:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> ( A ( thetaAP ` Q ) Y ) = sum_ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ( log ` p ) )
i8::piapval
s9:s5,i8:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> ( A ( piAP ` Q ) Y ) = ( # ` { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) )
s10::fzfid |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> ( 1 ... ( |_ ` Y ) ) e. Fin )
i11::rabfi
s12:s10,i11:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) -> { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } e. Fin )
s13::simpr |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } )
i14::elrabi
s15:s13,i14:syl |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR+ ) /\ p e. { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) -> p e. ( 1 ... ( |_ ` Y ) ) )
