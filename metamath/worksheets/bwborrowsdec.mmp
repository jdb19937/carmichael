$( <MM> <PROOF_ASST> THEOREM=bwborrowsdec  LOC_AFTER=?

* The run decomposition of the borrow chain (the interface predLoop reads): L is borrows false letters followed by a rest that is empty or starts with true.

s1::bwborrowsdec1 |- ( L e. Word 2o -> L = ( ( (/) repeatS ( borrows ` L ) ) ++ ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) ) )
s2::bwborrowsdec2 |- ( ( L e. Word 2o /\ ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) =/= (/) ) -> ( ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) ` 0 ) = 1o )
s3:s2:ex |- ( L e. Word 2o -> ( ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) =/= (/) -> ( ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) ` 0 ) = 1o ) )
qed:s1,s3:jca |- ( L e. Word 2o -> ( L = ( ( (/) repeatS ( borrows ` L ) ) ++ ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) ) /\ ( ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) =/= (/) -> ( ( L substr <. ( borrows ` L ) , ( # ` L ) >. ) ` 0 ) = 1o ) ) )
$)
