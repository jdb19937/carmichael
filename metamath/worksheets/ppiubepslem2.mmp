$( <MM> <PROOF_ASST> THEOREM=ppiubepslem2  LOC_AFTER=?

* Lemma for ppiubeps: the prime number theorem unpacked at radius eps.

s1::elioore |- ( x e. ( 1 (,) +oo ) -> x e. RR )
s2::eliooord |- ( x e. ( 1 (,) +oo ) -> ( 1 < x /\ x < +oo ) )
s3:s2:simpld |- ( x e. ( 1 (,) +oo ) -> 1 < x )
s4:s1,s3:rplogcld |- ( x e. ( 1 (,) +oo ) -> ( log ` x ) e. RR+ )
s5::0re |- 0 e. RR
s6:s5:a1i |- ( x e. ( 1 (,) +oo ) -> 0 e. RR )
s7::1re |- 1 e. RR
s8:s7:a1i |- ( x e. ( 1 (,) +oo ) -> 1 e. RR )
s9::0lt1 |- 0 < 1
s10:s9:a1i |- ( x e. ( 1 (,) +oo ) -> 0 < 1 )
s11:s6,s8,s1,s10,s3:lttrd |- ( x e. ( 1 (,) +oo ) -> 0 < x )
s12:s1,s11:elrpd |- ( x e. ( 1 (,) +oo ) -> x e. RR+ )
s13:s12,s4:rpdivcld |- ( x e. ( 1 (,) +oo ) -> ( x / ( log ` x ) ) e. RR+ )
i14::ppicl
s15:s1,i14:syl |- ( x e. ( 1 (,) +oo ) -> ( ppi ` x ) e. NN0 )
s16:s15:nn0red |- ( x e. ( 1 (,) +oo ) -> ( ppi ` x ) e. RR )
s17:s16,s13:rerpdivcld |- ( x e. ( 1 (,) +oo ) -> ( ( ppi ` x ) / ( x / ( log ` x ) ) ) e. RR )
s18:s17:rgen |- A. x e. ( 1 (,) +oo ) ( ( ppi ` x ) / ( x / ( log ` x ) ) ) e. RR
s19:s18:a1i |- ( E e. RR+ -> A. x e. ( 1 (,) +oo ) ( ( ppi ` x ) / ( x / ( log ` x ) ) ) e. RR )
s20::id |- ( E e. RR+ -> E e. RR+ )
s21::pnt |- ( x e. ( 1 (,) +oo ) |-> ( ( ppi ` x ) / ( x / ( log ` x ) ) ) ) ~~>r 1
s22:s21:a1i |- ( E e. RR+ -> ( x e. ( 1 (,) +oo ) |-> ( ( ppi ` x ) / ( x / ( log ` x ) ) ) ) ~~>r 1 )
qed:s19,s20,s22:rlimi |- ( E e. RR+ -> E. y e. RR A. x e. ( 1 (,) +oo ) ( y <_ x -> ( abs ` ( ( ( ppi ` x ) / ( x / ( log ` x ) ) ) - 1 ) ) < E ) )
$)
