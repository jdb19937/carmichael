i14::rescncf
s15:s13,s4,i14:sylc |- ( ( ( A e. CC /\ 0 < ( Re ` A ) ) /\ N e. RR+ ) -> ( ( x e. ( 0 [,) +oo ) |-> ( x ^c A ) ) |` ( 0 [,] N ) ) e. ( ( 0 [,] N ) -cn-> CC ) )
i16::resmpt
s17:s13,i16:syl |- ( ( ( A e. CC /\ 0 < ( Re ` A ) ) /\ N e. RR+ ) -> ( ( x e. ( 0 [,) +oo ) |-> ( x ^c A ) ) |` ( 0 [,] N ) ) = ( x e. ( 0 [,] N ) |-> ( x ^c A ) ) )
s18:s17:eqcomd |- ( ( ( A e. CC /\ 0 < ( Re ` A ) ) /\ N e. RR+ ) -> ( x e. ( 0 [,] N ) |-> ( x ^c A ) ) = ( ( x e. ( 0 [,) +oo ) |-> ( x ^c A ) ) |` ( 0 [,] N ) ) )
qed:s18,s15:eqeltrd |- ( ( ( A e. CC /\ 0 < ( Re ` A ) ) /\ N e. RR+ ) -> ( x e. ( 0 [,] N ) |-> ( x ^c A ) ) e. ( ( 0 [,] N ) -cn-> CC ) )
