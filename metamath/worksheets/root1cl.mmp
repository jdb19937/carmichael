$( <MM> <PROOF_ASST> THEOREM=root1cl  LOC_AFTER=?

* The primitive N-th root of unity of set.mm (root1id) is a nonzero complex number.

s1::neg1cn |- -u 1 e. CC
s2:s1:a1i |- ( N e. NN -> -u 1 e. CC )
s3::neg1ne0 |- -u 1 =/= 0
s4:s3:a1i |- ( N e. NN -> -u 1 =/= 0 )
s5::id |- ( N e. NN -> N e. NN )
s6::2cnd |- ( N e. NN -> 2 e. CC )
s7:s5:nncnd |- ( N e. NN -> N e. CC )
s8:s5:nnne0d |- ( N e. NN -> N =/= 0 )
s9:s6,s7,s8:divcld |- ( N e. NN -> ( 2 / N ) e. CC )
s10:s2,s9:cxpcld |- ( N e. NN -> ( -u 1 ^c ( 2 / N ) ) e. CC )
s11:s2,s4,s9:cxpne0d |- ( N e. NN -> ( -u 1 ^c ( 2 / N ) ) =/= 0 )
qed:s10,s11:jca |- ( N e. NN -> ( ( -u 1 ^c ( 2 / N ) ) e. CC /\ ( -u 1 ^c ( 2 / N ) ) =/= 0 ) )
$)
