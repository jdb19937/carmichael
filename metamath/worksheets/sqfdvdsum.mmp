s12:s7,s10,i11:syl2anc |- ( ( N e. NN /\ G : Prime --> CC ) -> sum_ t e. ~P { q e. Prime | q || N } prod_ p e. t ( G ` p ) = prod_ p e. { q e. Prime | q || N } ( 1 + ( G ` p ) ) )
s13::eqid |- { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } = { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) }
s14::eqid |- ( n e. { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } |-> { p e. Prime | p || n } ) = ( n e. { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } |-> { p e. Prime | p || n } )
s15::oveq1 |- ( r = p -> ( r pCnt m ) = ( p pCnt m ) )
s16:s15:cbvmptv |- ( r e. Prime |-> ( r pCnt m ) ) = ( p e. Prime |-> ( p pCnt m ) )
s17:s16:mpteq2i |- ( m e. NN |-> ( r e. Prime |-> ( r pCnt m ) ) ) = ( m e. NN |-> ( p e. Prime |-> ( p pCnt m ) ) )
s18::oveq2 |- ( m = n -> ( p pCnt m ) = ( p pCnt n ) )
