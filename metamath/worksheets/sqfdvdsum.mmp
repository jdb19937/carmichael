s20:s19:cbvmptv |- ( m e. NN |-> ( p e. Prime |-> ( p pCnt m ) ) ) = ( n e. NN |-> ( p e. Prime |-> ( p pCnt n ) ) )
s21:s17,s20:eqtri |- ( m e. NN |-> ( r e. Prime |-> ( r pCnt m ) ) ) = ( n e. NN |-> ( p e. Prime |-> ( p pCnt n ) ) )
s22:s13,s14,s21:sqff1o |- ( N e. NN -> ( n e. { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } |-> { p e. Prime | p || n } ) : { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } -1-1-onto-> ~P { p e. Prime | p || N } )
s23:s1,s22:syl |- ( ( N e. NN /\ G : Prime --> CC ) -> ( n e. { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } |-> { p e. Prime | p || n } ) : { x e. NN | ( ( mmu ` x ) =/= 0 /\ x || N ) } -1-1-onto-> ~P { p e. Prime | p || N } )
s24:s4:pweqd |- ( ( N e. NN /\ G : Prime --> CC ) -> ~P { p e. Prime | p || N } = ~P { q e. Prime | q || N } )
