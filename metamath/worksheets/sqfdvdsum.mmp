s6:s1,i5:syl |- ( ( N e. NN /\ G : Prime --> CC ) -> { p e. Prime | p || N } e. Fin )
s7:s4,s6:eqeltrrd |- ( ( N e. NN /\ G : Prime --> CC ) -> { q e. Prime | q || N } e. Fin )
