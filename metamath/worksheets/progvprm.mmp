$( <MM> <PROOF_ASST> THEOREM=progvprm  LOC_AFTER=?

* The density of the progression sieve is strictly between 0 and 1 at a prime.

s1::id |- ( s e. Prime -> s e. Prime )
i2::prmnn
s3:s1,i2:syl |- ( s e. Prime -> s e. NN )
i4::sqfprm
s5:s1,i4:syl |- ( s e. Prime -> ( mmu ` s ) =/= 0 )
i6::progvsqf
s7:s3,s5,i6:syl2anc |- ( s e. Prime -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) = ( 1 / s ) )
i8::nnrp
s9:s3,i8:syl |- ( s e. Prime -> s e. RR+ )
s10:s9:rpreccld |- ( s e. Prime -> ( 1 / s ) e. RR+ )
i11::rpgt0
s12:s10,i11:syl |- ( s e. Prime -> 0 < ( 1 / s ) )
s13:s9:rpred |- ( s e. Prime -> s e. RR )
i14::rpgt0
s15:s9,i14:syl |- ( s e. Prime -> 0 < s )
i16::prmgt1
s17:s1,i16:syl |- ( s e. Prime -> 1 < s )
i18::recgt1
s19:s13,s15,i18:syl2anc |- ( s e. Prime -> ( 1 < s <-> ( 1 / s ) < 1 ) )
s20:s19,s17:mpbid |- ( s e. Prime -> ( 1 / s ) < 1 )
s21:s12,s7:breqtrrd |- ( s e. Prime -> 0 < ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) )
s22:s7,s20:eqbrtrd |- ( s e. Prime -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) < 1 )
s23:s21,s22:jca |- ( s e. Prime -> ( 0 < ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) /\ ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) < 1 ) )
s24:s23:a1d |- ( s e. Prime -> ( s || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p -> ( 0 < ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) /\ ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) < 1 ) ) )
s25:s24:rgen |- A. s e. Prime ( s || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p -> ( 0 < ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) /\ ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) < 1 ) )
qed:s25:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> A. s e. Prime ( s || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p -> ( 0 < ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) /\ ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` s ) < 1 ) ) )
$)
