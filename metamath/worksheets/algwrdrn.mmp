$( <MM> <PROOF_ASST> THEOREM=algwrdrn  LOC_AFTER=?

* An element of a word lies in the alphabet (Lean: typing of a List membership).

s1::simpl |- ( ( W e. Word S /\ Q e. ran W ) -> W e. Word S )
s2::simpr |- ( ( W e. Word S /\ Q e. ran W ) -> Q e. ran W )
i3::wrdf
s4:s1,i3:syl |- ( ( W e. Word S /\ Q e. ran W ) -> W : ( 0 ..^ ( # ` W ) ) --> S )
i5::frn
s6:s4,i5:syl |- ( ( W e. Word S /\ Q e. ran W ) -> ran W C_ S )
qed:s6,s2:sseldd |- ( ( W e. Word S /\ Q e. ran W ) -> Q e. S )
$)
