$( <MM> <PROOF_ASST> THEOREM=holdm  LOC_AFTER=?

* The domain of the derivative of a function holomorphic on its whole domain is that domain.

s1::simpl |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> F e. ( D -cn-> CC ) )
s2::simpr |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> D C_ dom ( CC _D F ) )
i3::cncfrss
s4:s1,i3:syl |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> D C_ CC )
i5::cncff
s6:s1,i5:syl |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> F : D --> CC )
s7::ssid |- CC C_ CC
s8:s7:a1i |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> CC C_ CC )
s9:s8,s6,s4:dvbss |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> dom ( CC _D F ) C_ D )
qed:s9,s2:eqssd |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> dom ( CC _D F ) = D )
$)
