$( <MM> <PROOF_ASST> THEOREM=dchrindlem5  LOC_AFTER=?

* Lemma for the induced character: the value of X at the class mod N of the representative of K equals its value at any integer A in the class K.

s1::simp11 |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( N e. NN /\ M e. NN /\ N || M ) )
s2:s1:simp2d |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> M e. NN )
s3::simp13 |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> K e. ( Base ` ( Z/nZ ` M ) ) )
s4::simp2 |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> A e. ZZ )
s5::simp3 |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K )
i6::dchrindlem1
s7:s2,s3,i6:syl2anc |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) e. ZZ )
i8::dchrindlem2
s9:s2,s3,i8:syl2anc |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( ( ZRHom ` ( Z/nZ ` M ) ) ` ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) ) = K )
s10:s9,s5:eqtr4d |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( ( ZRHom ` ( Z/nZ ` M ) ) ` ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) )
s11:s7,s4:jca |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) e. ZZ /\ A e. ZZ ) )
i12::dchrindlem4
s13:s1,s11,s10,i12:syl3anc |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) )
qed:s13:fveq2d |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) /\ K e. ( Base ` ( Z/nZ ` M ) ) ) /\ A e. ZZ /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = K ) -> ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` ( `' ( ( ZRHom ` ( Z/nZ ` M ) ) |` ( 0 ..^ M ) ) ` K ) ) ) = ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) )
