$( <MM> <PROOF_ASST> THEOREM=cmpbitspad2  LOC_AFTER=?

* Padding the first operand of cmpBits with a false letter does not change the result.

s1::simp1 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> X e. Word 2o )
s2::simp2 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> Y e. Word 2o )
s3::simp3 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> C e. 3o )
i4::cmpbitsval
s5:s1,s2,s3,i4:syl3anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( X cmpBits Y ) ` C ) = if ( ( toNat ` X ) = ( toNat ` Y ) , C , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) )
s6::0el2o |- (/) e. 2o
s7:s6:a1i |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> (/) e. 2o )
i8::s1cl
s9:s7,i8:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> <" (/) "> e. Word 2o )
i10::ccatcl
s11:s1,s9,i10:syl2anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( X ++ <" (/) "> ) e. Word 2o )
i12::cmpbitsval
s13:s11,s2,s3,i12:syl3anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( ( X ++ <" (/) "> ) cmpBits Y ) ` C ) = if ( ( toNat ` ( X ++ <" (/) "> ) ) = ( toNat ` Y ) , C , ( ( toNat ` ( X ++ <" (/) "> ) ) Ncmp ( toNat ` Y ) ) ) )
i14::tonatpad
s15:s1,i14:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( toNat ` ( X ++ <" (/) "> ) ) = ( toNat ` X ) )
c1:s15:eqeq1d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( toNat ` ( X ++ <" (/) "> ) ) = ( toNat ` Y ) <-> ( toNat ` X ) = ( toNat ` Y ) ) )
c2:s15:oveq1d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( toNat ` ( X ++ <" (/) "> ) ) Ncmp ( toNat ` Y ) ) = ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) )
c3:c1,c2:ifbieq2d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> if ( ( toNat ` ( X ++ <" (/) "> ) ) = ( toNat ` Y ) , C , ( ( toNat ` ( X ++ <" (/) "> ) ) Ncmp ( toNat ` Y ) ) ) = if ( ( toNat ` X ) = ( toNat ` Y ) , C , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) )
s16:s13,c3:eqtrd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( ( X ++ <" (/) "> ) cmpBits Y ) ` C ) = if ( ( toNat ` X ) = ( toNat ` Y ) , C , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) )
qed:s5,s16:eqtr4d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 3o ) -> ( ( X cmpBits Y ) ` C ) = ( ( ( X ++ <" (/) "> ) cmpBits Y ) ` C ) )
