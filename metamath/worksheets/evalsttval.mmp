24::1oex    |- 1o e. _V
25:24:a1i   |- ( ( F e. V /\ M e. NN0 ) -> 1o e. _V )
26a::djuex
26:23,25,26a:syl2anc |- ( ( F e. V /\ M e. NN0 ) -> ( dom F |_| 1o ) e. _V )
27a::xpexg
27:23,26,27a:syl2anc |- ( ( F e. V /\ M e. NN0 ) -> ( dom F X. ( dom F |_| 1o ) ) e. _V )
28:27,22:ssexd |- ( ( F e. V /\ M e. NN0 ) -> { <. a , b >. | ( ( a e. dom F /\ b e. ( dom F |_| 1o ) ) /\ E. n e. ( 0 ... M ) ( ( ( OptStep ` F ) ^r n ) ` ( inl ` a ) ) = b ) } e. _V )
qed:2,17,19,20,28:ovmpod |- ( ( F e. V /\ M e. NN0 ) -> ( F EvalsToInTime M ) = { <. a , b >. | ( ( a e. dom F /\ b e. ( dom F |_| 1o ) ) /\ E. n e. ( 0 ... M ) ( ( ( OptStep ` F ) ^r n ) ` ( inl ` a ) ) = b ) } )
$)
