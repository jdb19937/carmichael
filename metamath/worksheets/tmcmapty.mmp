s7:s6,s5:mpbird |- ( ( ( 2nd ` T ) = TMSt /\ Y e. V /\ A. u e. TMSt X e. Y ) -> ( u e. TMSt |-> X ) : ( 2nd ` T ) --> Y )
s8::fvexd |- ( ( ( 2nd ` T ) = TMSt /\ Y e. V /\ A. u e. TMSt X e. Y ) -> ( 2nd ` T ) e. _V )
s9:s2,s8:elmapd |- ( ( ( 2nd ` T ) = TMSt /\ Y e. V /\ A. u e. TMSt X e. Y ) -> ( ( u e. TMSt |-> X ) e. ( Y ^m ( 2nd ` T ) ) <-> ( u e. TMSt |-> X ) : ( 2nd ` T ) --> Y ) )
qed:s9,s7:mpbird |- ( ( ( 2nd ` T ) = TMSt /\ Y e. V /\ A. u e. TMSt X e. Y ) -> ( u e. TMSt |-> X ) e. ( Y ^m ( 2nd ` T ) ) )
