$( <MM> <PROOF_ASST> THEOREM=korselt1  LOC_AFTER=?

* If ( P - 1 ) divides M - 1 then A ^ M == A mod P (Fermat, generalized
  exponent). Used by Korselt's criterion.

1::korselt1lem2 |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ P || A ) -> ( ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) mod P ) = ( A mod P ) )
2::korselt1lem1 |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) mod P ) = ( A mod P ) )
qed:1,2:pm2.61dan |- ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) -> ( ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) mod P ) = ( A mod P ) )
