s14:s2:adantr |- ( ( ( A : NN --> CC /\ E e. CC /\ Z e. CC ) /\ k e. NN ) -> E e. CC )
s15:s3:adantr |- ( ( ( A : NN --> CC /\ E e. CC /\ Z e. CC ) /\ k e. NN ) -> Z e. CC )
