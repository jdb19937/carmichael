$( <MM> <PROOF_ASST> THEOREM=psiapsubge0  LOC_AFTER=?

* The gap psiAP - thetaAP is nonnegative (Lean: psiAP_sub_thetaAP_nonneg).

s1::psiapcl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( psiAP ` Q ) Y ) e. RR )
s2::thetaapcl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( thetaAP ` Q ) Y ) e. RR )
s3::thetaaplepsiap |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( thetaAP ` Q ) Y ) <_ ( A ( psiAP ` Q ) Y ) )
s4:s1,s2:subge0d |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( 0 <_ ( ( A ( psiAP ` Q ) Y ) - ( A ( thetaAP ` Q ) Y ) ) <-> ( A ( thetaAP ` Q ) Y ) <_ ( A ( psiAP ` Q ) Y ) ) )
qed:s3,s4:mpbird |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> 0 <_ ( ( A ( psiAP ` Q ) Y ) - ( A ( thetaAP ` Q ) Y ) ) )
