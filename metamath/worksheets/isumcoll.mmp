$( <MM> <PROOF_ASST> THEOREM=isumcoll  LOC_AFTER=?

* Reindexing an infinite sum along a strictly increasing map: the sum of F over NN equals the sum of its values along G when F vanishes off the range of G and the reindexed series converges.

h1::isumcoll.g |- ( ph -> G : NN --> NN )
h2::isumcoll.i |- ( ( ph /\ k e. NN ) -> ( G ` k ) < ( G ` ( k + 1 ) ) )
h3::isumcoll.0 |- ( ( ph /\ n e. ( NN \ ran G ) ) -> ( F ` n ) = 0 )
h4::isumcoll.f |- ( ( ph /\ n e. NN ) -> ( F ` n ) e. CC )
h5::isumcoll.h |- ( ( ph /\ k e. NN ) -> ( H ` k ) = ( F ` ( G ` k ) ) )
h6::isumcoll.c |- ( ph -> seq 1 ( + , H ) e. dom ~~> )
s1::nnuz |- NN = ( ZZ>= ` 1 )
s2:1:adantr |- ( ( ph /\ k e. NN ) -> G : NN --> NN )
s3::simpr |- ( ( ph /\ k e. NN ) -> k e. NN )
s4:s2,s3:ffvelcdmd |- ( ( ph /\ k e. NN ) -> ( G ` k ) e. NN )
s5:4:adantlr |- ( ( ( ph /\ k e. NN ) /\ n e. NN ) -> ( F ` n ) e. CC )
s6:s5:ralrimiva |- ( ( ph /\ k e. NN ) -> A. n e. NN ( F ` n ) e. CC )
s7::id |- ( n = ( G ` k ) -> n = ( G ` k ) )
c1:s7:fveq2d |- ( n = ( G ` k ) -> ( F ` n ) = ( F ` ( G ` k ) ) )
c2:c1:eleq1d |- ( n = ( G ` k ) -> ( ( F ` n ) e. CC <-> ( F ` ( G ` k ) ) e. CC ) )
s8:c2,s6,s4:rspcdva |- ( ( ph /\ k e. NN ) -> ( F ` ( G ` k ) ) e. CC )
s9:5,s8:eqeltrd |- ( ( ph /\ k e. NN ) -> ( H ` k ) e. CC )
s10:s9:ralrimiva |- ( ph -> A. k e. NN ( H ` k ) e. CC )
s11::id |- ( k = j -> k = j )
c3:s11:fveq2d |- ( k = j -> ( H ` k ) = ( H ` j ) )
c4:c3:eleq1d |- ( k = j -> ( ( H ` k ) e. CC <-> ( H ` j ) e. CC ) )
s12:c4:cbvralvw |- ( A. k e. NN ( H ` k ) e. CC <-> A. j e. NN ( H ` j ) e. CC )
s13:s10,s12:sylib |- ( ph -> A. j e. NN ( H ` j ) e. CC )
s14:s13:r19.21bi |- ( ( ph /\ j e. NN ) -> ( H ` j ) e. CC )
s15::1zzd |- ( ph -> 1 e. ZZ )
s16::eqidd |- ( ( ph /\ j e. NN ) -> ( H ` j ) = ( H ` j ) )
s17:s1,s15,s16,s14,6:isumclim2 |- ( ph -> seq 1 ( + , H ) ~~> sum_ j e. NN ( H ` j ) )
s18:s1,s15,1,2,3,4,5:isercoll |- ( ph -> ( seq 1 ( + , H ) ~~> sum_ j e. NN ( H ` j ) <-> seq 1 ( + , F ) ~~> sum_ j e. NN ( H ` j ) ) )
s19:s17,s18:mpbid |- ( ph -> seq 1 ( + , F ) ~~> sum_ j e. NN ( H ` j ) )
s20::eqidd |- ( ( ph /\ n e. NN ) -> ( F ` n ) = ( F ` n ) )
qed:s1,s15,s20,4,s19:isumclim |- ( ph -> sum_ n e. NN ( F ` n ) = sum_ j e. NN ( H ` j ) )
$)
