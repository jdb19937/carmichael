$( <MM> <PROOF_ASST> THEOREM=bwrep1  LOC_AFTER=?

* The word of E true letters is the digits word of -1 (m1bits).

s1::id |- ( E e. NN0 -> E e. NN0 )
s2::neg1z |- -u 1 e. ZZ
s3:s2:a1i |- ( E e. NN0 -> -u 1 e. ZZ )
i4::bwrdcl
s5:s3,s1,i4:syl2anc |- ( E e. NN0 -> ( -u 1 bwrd E ) e. Word 2o )
i6::bwrdlen
s7:s3,s1,i6:syl2anc |- ( E e. NN0 -> ( # ` ( -u 1 bwrd E ) ) = E )
s8::simpr |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> i e. ( 0 ..^ E ) )
s9:s3:adantr |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> -u 1 e. ZZ )
s10:s1:adantr |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> E e. NN0 )
i11::bwrdfv
s12:s9,s10,s8,i11:syl3anc |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> ( ( -u 1 bwrd E ) ` i ) = if ( i e. ( bits ` -u 1 ) , 1o , (/) ) )
i13::elfzonn0
s14:s8,i13:syl |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> i e. NN0 )
s15::m1bits |- ( bits ` -u 1 ) = NN0
s16:s15:a1i |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> ( bits ` -u 1 ) = NN0 )
s17:s14,s16:eleqtrrd |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> i e. ( bits ` -u 1 ) )
s18:s17:iftrued |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> if ( i e. ( bits ` -u 1 ) , 1o , (/) ) = 1o )
s19:s12,s18:eqtrd |- ( ( E e. NN0 /\ i e. ( 0 ..^ E ) ) -> ( ( -u 1 bwrd E ) ` i ) = 1o )
s20:s19:ralrimiva |- ( E e. NN0 -> A. i e. ( 0 ..^ E ) ( ( -u 1 bwrd E ) ` i ) = 1o )
s21:s5,s7,s20:3jca |- ( E e. NN0 -> ( ( -u 1 bwrd E ) e. Word 2o /\ ( # ` ( -u 1 bwrd E ) ) = E /\ A. i e. ( 0 ..^ E ) ( ( -u 1 bwrd E ) ` i ) = 1o ) )
s22::1oel2o |- 1o e. 2o
s23:s22:a1i |- ( E e. NN0 -> 1o e. 2o )
i24::repsdf2
s25:s23,s1,i24:syl2anc |- ( E e. NN0 -> ( ( -u 1 bwrd E ) = ( 1o repeatS E ) <-> ( ( -u 1 bwrd E ) e. Word 2o /\ ( # ` ( -u 1 bwrd E ) ) = E /\ A. i e. ( 0 ..^ E ) ( ( -u 1 bwrd E ) ` i ) = 1o ) ) )
s26:s21,s25:mpbird |- ( E e. NN0 -> ( -u 1 bwrd E ) = ( 1o repeatS E ) )
qed:s26:eqcomd |- ( E e. NN0 -> ( 1o repeatS E ) = ( -u 1 bwrd E ) )
