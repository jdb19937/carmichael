$( <MM> <PROOF_ASST> THEOREM=tm2lentval  LOC_AFTER=?

* Value of ` entries ` : the monoid sum of the entries each followed by a comma.  Lean: ` def entries ` (TM/Lists.lean).

s1::coeq2 |- ( l = L -> ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. l ) = ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) )
s2:s1:oveq2d |- ( l = L -> ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. l ) ) = ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) ) )
s3::df-tm2lent |- entries = ( l e. Word Word ( { 1 } X. 2o ) |-> ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. l ) ) )
s4::ovex |- ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) ) e. _V
qed:s2,s3,s4:fvmpt |- ( L e. Word Word ( { 1 } X. 2o ) -> ( entries ` L ) = ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) ) )
$)
