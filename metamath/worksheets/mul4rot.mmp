$( <MM> <PROOF_ASST> THEOREM=mul4rot  LOC_AFTER=?

* A rearrangement of a four-factor product: D ( C A B ) = A ( ( D C ) B ) .

s1::simpll |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> D e. CC )
s2::simplr |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> C e. CC )
s3::simprl |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> A e. CC )
s4::simprr |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> B e. CC )
s5:s2,s3,s4:mulassd |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( ( C x. A ) x. B ) = ( C x. ( A x. B ) ) )
s6:s5:oveq2d |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( D x. ( ( C x. A ) x. B ) ) = ( D x. ( C x. ( A x. B ) ) ) )
s7:s3,s4:mulcld |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( A x. B ) e. CC )
s8:s1,s2,s7:mulassd |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( ( D x. C ) x. ( A x. B ) ) = ( D x. ( C x. ( A x. B ) ) ) )
s9:s8:eqcomd |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( D x. ( C x. ( A x. B ) ) ) = ( ( D x. C ) x. ( A x. B ) ) )
s10:s6,s9:eqtrd |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( D x. ( ( C x. A ) x. B ) ) = ( ( D x. C ) x. ( A x. B ) ) )
s11:s1,s2:mulcld |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( D x. C ) e. CC )
s12:s3,s11,s4:mul12d |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( A x. ( ( D x. C ) x. B ) ) = ( ( D x. C ) x. ( A x. B ) ) )
qed:s10,s12:eqtr4d |- ( ( ( D e. CC /\ C e. CC ) /\ ( A e. CC /\ B e. CC ) ) -> ( D x. ( ( C x. A ) x. B ) ) = ( A x. ( ( D x. C ) x. B ) ) )
$)
