$( <MM> <PROOF_ASST> THEOREM=gcdnprm  LOC_AFTER=?

* Two positive integers no prime divisor of the first of which divides the second are coprime.

s1::simp1 |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> C e. NN )
s2::simp2 |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> B e. NN )
s3::simp3 |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> A. o e. Prime ( o || C -> -. o || B ) )
s4::breq1 |- ( o = q -> ( o || C <-> q || C ) )
s5::breq1 |- ( o = q -> ( o || B <-> q || B ) )
s6:s5:notbid |- ( o = q -> ( -. o || B <-> -. q || B ) )
s7:s4,s6:imbi12d |- ( o = q -> ( ( o || C -> -. o || B ) <-> ( q || C -> -. q || B ) ) )
s8:s7:rspcv |- ( q e. Prime -> ( A. o e. Prime ( o || C -> -. o || B ) -> ( q || C -> -. q || B ) ) )
s9::simpr |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> q e. Prime )
s10:s9,s8:syl |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> ( A. o e. Prime ( o || C -> -. o || B ) -> ( q || C -> -. q || B ) ) )
s11:s3:adantr |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> A. o e. Prime ( o || C -> -. o || B ) )
s12:s11,s10:mpd |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> ( q || C -> -. q || B ) )
s13::imnan |- ( ( q || C -> -. q || B ) <-> -. ( q || C /\ q || B ) )
s14:s13:a1i |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> ( ( q || C -> -. q || B ) <-> -. ( q || C /\ q || B ) ) )
s15:s14,s12:mpbid |- ( ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) /\ q e. Prime ) -> -. ( q || C /\ q || B ) )
s16:s15:ralrimiva |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> A. q e. Prime -. ( q || C /\ q || B ) )
s17::ralnex |- ( A. q e. Prime -. ( q || C /\ q || B ) <-> -. E. q e. Prime ( q || C /\ q || B ) )
s18:s17:a1i |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> ( A. q e. Prime -. ( q || C /\ q || B ) <-> -. E. q e. Prime ( q || C /\ q || B ) ) )
s19:s18,s16:mpbid |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> -. E. q e. Prime ( q || C /\ q || B ) )
s20::breq1 |- ( q = p -> ( q || C <-> p || C ) )
s21::breq1 |- ( q = p -> ( q || B <-> p || B ) )
s22:s20,s21:anbi12d |- ( q = p -> ( ( q || C /\ q || B ) <-> ( p || C /\ p || B ) ) )
s23:s22:cbvrexvw |- ( E. q e. Prime ( q || C /\ q || B ) <-> E. p e. Prime ( p || C /\ p || B ) )
s24:s23:a1i |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> ( E. q e. Prime ( q || C /\ q || B ) <-> E. p e. Prime ( p || C /\ p || B ) ) )
s25:s19,s24:mtbid |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> -. E. p e. Prime ( p || C /\ p || B ) )
s26::simpl |- ( ( C e. NN /\ B e. NN ) -> C e. NN )
s27::simpr |- ( ( C e. NN /\ B e. NN ) -> B e. NN )
s28:s26,s27:prmdvdsncoprmbd |- ( ( C e. NN /\ B e. NN ) -> ( E. p e. Prime ( p || C /\ p || B ) <-> ( C gcd B ) =/= 1 ) )
s29:s1,s2,s28:syl2anc |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> ( E. p e. Prime ( p || C /\ p || B ) <-> ( C gcd B ) =/= 1 ) )
s30::nne |- ( -. ( C gcd B ) =/= 1 <-> ( C gcd B ) = 1 )
s31:s30:a1i |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> ( -. ( C gcd B ) =/= 1 <-> ( C gcd B ) = 1 ) )
s32:s25,s29:mtbid |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> -. ( C gcd B ) =/= 1 )
qed:s31,s32:mpbid |- ( ( C e. NN /\ B e. NN /\ A. o e. Prime ( o || C -> -. o || B ) ) -> ( C gcd B ) = 1 )
$)
