$( <MM> <PROOF_ASST> THEOREM=emptytblcl  LOC_AFTER=?

* The empty table is a table.

s1::eqid |- (/) = (/)
s2::el1o |- ( (/) e. 1o <-> (/) = (/) )
s3:s1,s2:mpbir |- (/) e. 1o
s4:s3:a1i |- ( ( T. /\ r e. NN0 ) -> (/) e. 1o )
s5::djurcl |- ( (/) e. 1o -> ( inr ` (/) ) e. ( Word NN0 |_| 1o ) )
s6:s4,s5:syl |- ( ( T. /\ r e. NN0 ) -> ( inr ` (/) ) e. ( Word NN0 |_| 1o ) )
s7::df-emptytbl |- EmptyTbl = ( r e. NN0 |-> ( inr ` (/) ) )
s8:s6,s7:fmptd |- ( T. -> EmptyTbl : NN0 --> ( Word NN0 |_| 1o ) )
s9:s8:mptru |- EmptyTbl : NN0 --> ( Word NN0 |_| 1o )
s10::djuex |- ( ( Word NN0 e. _V /\ 1o e. _V ) -> ( Word NN0 |_| 1o ) e. _V )
s11::wrdexi |- Word NN0 e. _V
s12::1oex |- 1o e. _V
s13:s11,s12,s10:mp2an |- ( Word NN0 |_| 1o ) e. _V
s14::nn0ex |- NN0 e. _V
s15::elmapg |- ( ( ( Word NN0 |_| 1o ) e. _V /\ NN0 e. _V ) -> ( EmptyTbl e. ( ( Word NN0 |_| 1o ) ^m NN0 ) <-> EmptyTbl : NN0 --> ( Word NN0 |_| 1o ) ) )
s16:s13,s14,s15:mp2an |- ( EmptyTbl e. ( ( Word NN0 |_| 1o ) ^m NN0 ) <-> EmptyTbl : NN0 --> ( Word NN0 |_| 1o ) )
s17:s9,s16:mpbir |- EmptyTbl e. ( ( Word NN0 |_| 1o ) ^m NN0 )
s18::df-tbl |- Tbl = ( ( Word NN0 |_| 1o ) ^m NN0 )
qed:s17,s18:eleqtrri |- EmptyTbl e. Tbl
$)
