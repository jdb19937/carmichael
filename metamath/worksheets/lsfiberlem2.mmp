$( <MM> <PROOF_ASST> THEOREM=lsfiberlem2  LOC_AFTER=?

* Lemma for lsfiber: f times the squared window sum twisted by a primitive character x mod f is the squared twisted unit average of its induced inverse at level Q (Lean hval, from W_norm_eq).

s1::simpll |- ( ( ( ( ( Q e. NN /\ M e. RR ) /\ ( W e. Fin /\ W C_ ZZ /\ A : W --> CC ) /\ A. m e. W ( m gcd Q ) = 1 ) /\ f e. { d e. NN | ( d || Q /\ ( ( mmu ` ( Q / d ) ) =/= 0 /\ ( ( Q / d ) gcd d ) = 1 ) ) } ) /\ x e. { y e. ( Base ` ( DChr ` f ) ) | ( f DChrCond y ) = f } ) -> ( ( Q e. NN /\ M e. RR ) /\ ( W e. Fin /\ W C_ ZZ /\ A : W --> CC ) /\ A. m e. W ( m gcd Q ) = 1 ) )
