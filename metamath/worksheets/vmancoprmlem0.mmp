$( <MM> <PROOF_ASST> THEOREM=vmancoprmlem0  LOC_AFTER=?

* Lemma for vmancoprm: a nonzero von Mangoldt value marks a prime power.

s1::oveq2 |- ( k = j -> ( p ^ k ) = ( p ^ j ) )
s2:s1:eqeq2d |- ( k = j -> ( A = ( p ^ k ) <-> A = ( p ^ j ) ) )
s3:s2:cbvrexvw |- ( E. k e. NN A = ( p ^ k ) <-> E. j e. NN A = ( p ^ j ) )
s4:s3:rexbii |- ( E. p e. Prime E. k e. NN A = ( p ^ k ) <-> E. p e. Prime E. j e. NN A = ( p ^ j ) )
s5::oveq1 |- ( p = u -> ( p ^ j ) = ( u ^ j ) )
s6:s5:eqeq2d |- ( p = u -> ( A = ( p ^ j ) <-> A = ( u ^ j ) ) )
s7:s6:rexbidv |- ( p = u -> ( E. j e. NN A = ( p ^ j ) <-> E. j e. NN A = ( u ^ j ) ) )
s8:s7:cbvrexvw |- ( E. p e. Prime E. j e. NN A = ( p ^ j ) <-> E. u e. Prime E. j e. NN A = ( u ^ j ) )
s9:s4,s8:bitri |- ( E. p e. Prime E. k e. NN A = ( p ^ k ) <-> E. u e. Prime E. j e. NN A = ( u ^ j ) )
s10::isppw2 |- ( A e. NN -> ( ( Lam ` A ) =/= 0 <-> E. p e. Prime E. k e. NN A = ( p ^ k ) ) )
qed:s10,s9:bitrdi |- ( A e. NN -> ( ( Lam ` A ) =/= 0 <-> E. u e. Prime E. j e. NN A = ( u ^ j ) ) )
$)
