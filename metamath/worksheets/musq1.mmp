s30:s17,s22:eqtrd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( ( -u 1 ^ ( # ` { p e. Prime | p || N } ) ) ^ 2 ) = ( -u 1 ^ ( 2 x. ( # ` { p e. Prime | p || N } ) ) ) )
s31:s24,s27:eqtrd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ ( 2 x. ( # ` { p e. Prime | p || N } ) ) ) = ( 1 ^ ( # ` { p e. Prime | p || N } ) ) )
s32:s31,s29:eqtrd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ ( 2 x. ( # ` { p e. Prime | p || N } ) ) ) = 1 )
s33:s30,s32:eqtrd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( ( -u 1 ^ ( # ` { p e. Prime | p || N } ) ) ^ 2 ) = 1 )
