s16:s12,s6,s14,i15:syl3anc |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ ( ( # ` { p e. Prime | p || N } ) x. 2 ) ) = ( ( -u 1 ^ ( # ` { p e. Prime | p || N } ) ) ^ 2 ) )
s17:s16:eqcomd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( ( -u 1 ^ ( # ` { p e. Prime | p || N } ) ) ^ 2 ) = ( -u 1 ^ ( ( # ` { p e. Prime | p || N } ) x. 2 ) ) )
s18:s6:nn0cnd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( # ` { p e. Prime | p || N } ) e. CC )
s19::2cn |- 2 e. CC
s20:s19:a1i |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> 2 e. CC )
s21:s18,s20:mulcomd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( ( # ` { p e. Prime | p || N } ) x. 2 ) = ( 2 x. ( # ` { p e. Prime | p || N } ) ) )
s22:s21:oveq2d |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ ( ( # ` { p e. Prime | p || N } ) x. 2 ) ) = ( -u 1 ^ ( 2 x. ( # ` { p e. Prime | p || N } ) ) ) )
i23::expmul
s24:s12,s14,s6,i23:syl3anc |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ ( 2 x. ( # ` { p e. Prime | p || N } ) ) ) = ( ( -u 1 ^ 2 ) ^ ( # ` { p e. Prime | p || N } ) ) )
s25::neg1sqe1 |- ( -u 1 ^ 2 ) = 1
s26:s25:a1i |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( -u 1 ^ 2 ) = 1 )
s27:s26:oveq1d |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( ( -u 1 ^ 2 ) ^ ( # ` { p e. Prime | p || N } ) ) = ( 1 ^ ( # ` { p e. Prime | p || N } ) ) )
i28::1exp
