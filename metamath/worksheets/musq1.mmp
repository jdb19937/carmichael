$( <MM> <PROOF_ASST> THEOREM=musq1  LOC_AFTER=?

* The square of the Moebius value at a squarefree argument is one.

s1::simpl |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> N e. NN )
s2::simpr |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( mmu ` N ) =/= 0 )
i3::prmdvdsfi
s4:s1,i3:syl |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> { p e. Prime | p || N } e. Fin )
i5::hashcl
s6:s4,i5:syl |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( # ` { p e. Prime | p || N } ) e. NN0 )
s7:s6:nn0zd |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( # ` { p e. Prime | p || N } ) e. ZZ )
s8::id |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( N e. NN /\ ( mmu ` N ) =/= 0 ) )
i9::muval2
s10:s8,i9:syl |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> ( mmu ` N ) = ( -u 1 ^ ( # ` { p e. Prime | p || N } ) ) )
s11::neg1cn |- -u 1 e. CC
s12:s11:a1i |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> -u 1 e. CC )
s13::2nn0 |- 2 e. NN0
s14:s13:a1i |- ( ( N e. NN /\ ( mmu ` N ) =/= 0 ) -> 2 e. NN0 )
