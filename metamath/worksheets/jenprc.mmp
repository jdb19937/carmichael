$( <MM> <PROOF_ASST> THEOREM=jenprc  LOC_AFTER=?

* The product of the linear factors is a complex number.

s1::simp1 |- ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) -> N e. NN )
s2::simp2 |- ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) -> H : NN --> CC )
s3::simp3 |- ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) -> U e. CC )
s4::simpr |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> k e. ( 1 ... N ) )
s5:s2:adantr |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> H : NN --> CC )
i6::elfznn
s7:s4,i6:syl |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> k e. NN )
s8:s5,s7:ffvelcdmd |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> ( H ` k ) e. CC )
s9:s3:adantr |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> U e. CC )
s10:s9,s8:subcld |- ( ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) /\ k e. ( 1 ... N ) ) -> ( U - ( H ` k ) ) e. CC )
s11::fzfid |- ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) -> ( 1 ... N ) e. Fin )
qed:s11,s10:fprodcl |- ( ( N e. NN /\ H : NN --> CC /\ U e. CC ) -> prod_ k e. ( 1 ... N ) ( U - ( H ` k ) ) e. CC )
$)
