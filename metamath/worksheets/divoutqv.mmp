$( <MM> <PROOF_ASST> THEOREM=divoutqv  LOC_AFTER=?

* The floor of an exact quotient is the quotient.

s1::simpll |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> D e. NN )
s2::simplr |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> R e. NN0 )
s3::simpr |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( R mod D ) = 0 )
s4:s1:nnzd |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> D e. ZZ )
s5:s2:nn0zd |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> R e. ZZ )
s6:s1:nnne0d |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> D =/= 0 )
i7::dvdsval3
s8:s1,s5,i7:syl2anc |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( D || R <-> ( R mod D ) = 0 ) )
s9:s8,s3:mpbird |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> D || R )
s10:s4,s6,s5:3jca |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( D e. ZZ /\ D =/= 0 /\ R e. ZZ ) )
i11::dvdsval2
s12:s10,i11:syl |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( D || R <-> ( R / D ) e. ZZ ) )
s13:s12,s9:mpbid |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( R / D ) e. ZZ )
i14::flid
qed:s13,i14:syl |- ( ( ( D e. NN /\ R e. NN0 ) /\ ( R mod D ) = 0 ) -> ( |_ ` ( R / D ) ) = ( R / D ) )
