$( <MM> <PROOF_ASST> THEOREM=root1ef  LOC_AFTER=?

* The root of unity as an exponential.

s1::id |- ( N e. NN -> N e. NN )
s2:s1:nncnd |- ( N e. NN -> N e. CC )
s3:s1:nnne0d |- ( N e. NN -> N =/= 0 )
s4::2cnd |- ( N e. NN -> 2 e. CC )
s5:s4,s2,s3:divcld |- ( N e. NN -> ( 2 / N ) e. CC )
s6::neg1cn |- -u 1 e. CC
s7:s6:a1i |- ( N e. NN -> -u 1 e. CC )
s8::neg1ne0 |- -u 1 =/= 0
s9:s8:a1i |- ( N e. NN -> -u 1 =/= 0 )
i10::cxpef
s11:s7,s9,s5,i10:syl3anc |- ( N e. NN -> ( -u 1 ^c ( 2 / N ) ) = ( exp ` ( ( 2 / N ) x. ( log ` -u 1 ) ) ) )
s12::logm1 |- ( log ` -u 1 ) = ( _i x. _pi )
s13:s12:a1i |- ( N e. NN -> ( log ` -u 1 ) = ( _i x. _pi ) )
s14:s13:oveq2d |- ( N e. NN -> ( ( 2 / N ) x. ( log ` -u 1 ) ) = ( ( 2 / N ) x. ( _i x. _pi ) ) )
s15:s14:fveq2d |- ( N e. NN -> ( exp ` ( ( 2 / N ) x. ( log ` -u 1 ) ) ) = ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) )
qed:s11,s15:eqtrd |- ( N e. NN -> ( -u 1 ^c ( 2 / N ) ) = ( exp ` ( ( 2 / N ) x. ( _i x. _pi ) ) ) )
$)
