$( <MM> <PROOF_ASST> THEOREM=sqf2omle  LOC_AFTER=?

* 2 to the number of prime divisors of a squarefree D is at most D.

s1::simpl |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> D e. NN )
s2::simpr |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> ( mmu ` D ) =/= 0 )
s3::breq1 |- ( p = q -> ( p || D <-> q || D ) )
s4:s3:cbvrabv |- { p e. Prime | p || D } = { q e. Prime | q || D }
s5:s4:a1i |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> { p e. Prime | p || D } = { q e. Prime | q || D } )
i6::prmdvdsfi
