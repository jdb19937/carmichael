s21:s19,i20:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 1 < p )
s22::2re |- 2 e. RR
s23:s22:a1i |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 2 e. RR )
s24::0le2 |- 0 <_ 2
s25:s24:a1i |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 0 <_ 2 )
i26::prmuz2
s27:s14,i26:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. ( ZZ>= ` 2 ) )
i28::eluzle
s29:s27,i28:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 2 <_ p )
s30:s11,s8,s23,s25,s17,s29:fprodle |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } 2 <_ prod_ p e. { q e. Prime | q || D } p )
s31::2cn |- 2 e. CC
s32:s31:a1i |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> 2 e. CC )
i33::fprodconst
s34:s8,s32,i33:syl2anc |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } 2 = ( 2 ^ ( # ` { q e. Prime | q || D } ) ) )
s35:s34,s30:eqbrtrrd |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> ( 2 ^ ( # ` { q e. Prime | q || D } ) ) <_ prod_ p e. { q e. Prime | q || D } p )
qed:s35,s10:breqtrd |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> ( 2 ^ ( # ` { q e. Prime | q || D } ) ) <_ D )
