$( <MM> <PROOF_ASST> THEOREM=blle2  LOC_AFTER=?

* A positive integer is at least 2 to its bit length less one.

s1::2z |- 2 e. ZZ
i2::uzid
s3:s1,i2:ax-mp |- 2 e. ( ZZ>= ` 2 )
s4:s3:a1i |- ( A e. NN -> 2 e. ( ZZ>= ` 2 ) )
s5::id |- ( A e. NN -> A e. NN )
i6::nlogle
s7:s4,s5,i6:syl2anc |- ( A e. NN -> ( 2 ^ ( 2 Nlog A ) ) <_ A )
s8::blnlog |- ( A e. NN -> ( 2 Nlog A ) = ( ( bl ` A ) - 1 ) )
s9:s8:oveq2d |- ( A e. NN -> ( 2 ^ ( 2 Nlog A ) ) = ( 2 ^ ( ( bl ` A ) - 1 ) ) )
qed:s9,s7:eqbrtrrd |- ( A e. NN -> ( 2 ^ ( ( bl ` A ) - 1 ) ) <_ A )
$)
