h6::cbelin.6 |- ( ph -> X <_ ( 1 + ( P x. M ) ) )
s1:3,4:elrpd |- ( ph -> P e. RR+ )
s2:1,2:elrpd |- ( ph -> M e. RR+ )
s3:s1,s2:rpmulcld |- ( ph -> ( P x. M ) e. RR+ )
