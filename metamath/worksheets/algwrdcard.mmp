$( <MM> <PROOF_ASST> THEOREM=algwrdcard  LOC_AFTER=?

* A duplicate-free word has as many entries as letters (Lean: List.toFinset_card_of_nodup).

s1::simpl |- ( ( W e. Word S /\ Fun `' W ) -> W e. Word S )
s2::simpr |- ( ( W e. Word S /\ Fun `' W ) -> Fun `' W )
i3::algndpcard
s4:s1,i3:syl |- ( ( W e. Word S /\ Fun `' W ) -> ( Fun `' W <-> ( # ` ran W ) = ( # ` W ) ) )
qed:s4,s2:mpbid |- ( ( W e. Word S /\ Fun `' W ) -> ( # ` ran W ) = ( # ` W ) )
$)
