$( <MM> <PROOF_ASST> THEOREM=progtfi  LOC_AFTER=?

* The sifting primes of the progression sieve form a finite set of primes.

s1::fzfid |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( 0 ... Z ) e. Fin )
s2::ssrab2 |- { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ ( 0 ... Z )
s3:s2:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ ( 0 ... Z ) )
s4:s1,s3:ssfid |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } e. Fin )
s5::eleq1 |- ( u = w -> ( u e. Prime <-> w e. Prime ) )
s6::breq1 |- ( u = w -> ( u || M <-> w || M ) )
s7:s6:notbid |- ( u = w -> ( -. u || M <-> -. w || M ) )
s8:s5,s7:anbi12d |- ( u = w -> ( ( u e. Prime /\ -. u || M ) <-> ( w e. Prime /\ -. w || M ) ) )
s9:s8:elrab |- ( w e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } <-> ( w e. ( 0 ... Z ) /\ ( w e. Prime /\ -. w || M ) ) )
s10:s9:biimpi |- ( w e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } -> ( w e. ( 0 ... Z ) /\ ( w e. Prime /\ -. w || M ) ) )
s11:s10:simprld |- ( w e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } -> w e. Prime )
s12:s11:ssriv |- { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ Prime
s13:s12:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ Prime )
qed:s4,s13:jca |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } e. Fin /\ { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ Prime ) )
$)
