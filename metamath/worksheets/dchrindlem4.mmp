$( <MM> <PROOF_ASST> THEOREM=dchrindlem4  LOC_AFTER=?

* Lemma for the induced character: two integers in the same class mod M are in the same class mod N when N divides M.

s1::simp11 |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> N e. NN )
s2::simp12 |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> M e. NN )
s3::simp13 |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> N || M )
s4::simp2l |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> A e. ZZ )
s5::simp2r |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> B e. ZZ )
s6::simp3 |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) )
s7:s1:nnnn0d |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> N e. NN0 )
s8:s2:nnnn0d |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> M e. NN0 )
s9::eqid |- ( Z/nZ ` M ) = ( Z/nZ ` M )
s10::eqid |- ( ZRHom ` ( Z/nZ ` M ) ) = ( ZRHom ` ( Z/nZ ` M ) )
s11::eqid |- ( Z/nZ ` N ) = ( Z/nZ ` N )
s12::eqid |- ( ZRHom ` ( Z/nZ ` N ) ) = ( ZRHom ` ( Z/nZ ` N ) )
s13:s9,s10:zndvds |- ( ( M e. NN0 /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) <-> M || ( A - B ) ) )
s14:s8,s4,s5,s13:syl3anc |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> ( ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) <-> M || ( A - B ) ) )
s15:s6,s14:mpbid |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> M || ( A - B ) )
s16:s1:nnzd |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> N e. ZZ )
s17:s2:nnzd |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> M e. ZZ )
s18:s4,s5:zsubcld |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> ( A - B ) e. ZZ )
s19:s16,s17,s18,s3,s15:dvdstrd |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> N || ( A - B ) )
s20:s11,s12:zndvds |- ( ( N e. NN0 /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` B ) <-> N || ( A - B ) ) )
s21:s7,s4,s5,s20:syl3anc |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> ( ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` B ) <-> N || ( A - B ) ) )
qed:s19,s21:mpbird |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( A e. ZZ /\ B e. ZZ ) /\ ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` M ) ) ` B ) ) -> ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) = ( ( ZRHom ` ( Z/nZ ` N ) ) ` B ) )
