$( <MM> <PROOF_ASST> THEOREM=korselt1lem1  LOC_AFTER=?

* Lemma for korselt1: the case P does not divide A. Fermat's little theorem
  gives A ^ ( P - 1 ) == 1 mod P; raise to the K and multiply by A.

1::simpl1   |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> P e. Prime )
2::simpl2   |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> A e. ZZ )
3::simpl3   |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> K e. NN0 )
4::simpr    |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> -. P || A )
5a::vfermltl
5:1,2,4,5a:syl3anc |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( A ^ ( P - 1 ) ) mod P ) = 1 )
