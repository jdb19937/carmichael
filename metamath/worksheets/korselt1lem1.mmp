12:6,12a:syl |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( P - 1 ) e. NN0 )
13a::zexpcl
13:2,12,13a:syl2anc |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( A ^ ( P - 1 ) ) e. ZZ )
