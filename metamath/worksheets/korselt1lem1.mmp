19:18,19a:syl |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( 1 ^ K ) = 1 )
20:19:oveq1d |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( 1 ^ K ) mod P ) = ( 1 mod P ) )
21:17,20:eqtrd |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( ( A ^ ( P - 1 ) ) ^ K ) mod P ) = ( 1 mod P ) )
