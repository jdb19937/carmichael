36:22,26,36a:syl2anc |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) = ( ( A ^ ( ( P - 1 ) x. K ) ) x. A ) )
37:36:oveq1d |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) mod P ) = ( ( ( A ^ ( ( P - 1 ) x. K ) ) x. A ) mod P ) )
qed:37,35:eqtrd |- ( ( ( P e. Prime /\ A e. ZZ /\ K e. NN0 ) /\ -. P || A ) -> ( ( A ^ ( ( ( P - 1 ) x. K ) + 1 ) ) mod P ) = ( A mod P ) )
