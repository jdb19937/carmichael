$( <MM> <PROOF_ASST> THEOREM=tonatrep0  LOC_AFTER=?

* The value of a word of false letters is 0 (Lean: toNat_replicate_false).

s1::id |- ( E e. NN0 -> E e. NN0 )
s2::bwrep0 |- ( E e. NN0 -> ( (/) repeatS E ) = ( 0 bwrd E ) )
s3:s2:fveq2d |- ( E e. NN0 -> ( toNat ` ( (/) repeatS E ) ) = ( toNat ` ( 0 bwrd E ) ) )
s4::0z |- 0 e. ZZ
s5:s4:a1i |- ( E e. NN0 -> 0 e. ZZ )
i6::tonatbwrd
s7:s5,s1,i6:syl2anc |- ( E e. NN0 -> ( toNat ` ( 0 bwrd E ) ) = ( 0 mod ( 2 ^ E ) ) )
s8::2rp |- 2 e. RR+
s9:s8:a1i |- ( E e. NN0 -> 2 e. RR+ )
s10:s1:nn0zd |- ( E e. NN0 -> E e. ZZ )
s11:s9,s10:rpexpcld |- ( E e. NN0 -> ( 2 ^ E ) e. RR+ )
i12::0mod
s13:s11,i12:syl |- ( E e. NN0 -> ( 0 mod ( 2 ^ E ) ) = 0 )
qed:s3,s7,s13:3eqtrd |- ( E e. NN0 -> ( toNat ` ( (/) repeatS E ) ) = 0 )
