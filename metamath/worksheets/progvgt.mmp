$( <MM> <PROOF_ASST> THEOREM=progvgt  LOC_AFTER=?

* The Selberg term of the progression sieve at a squarefree divisor.

s1::progvsqf |- ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` L ) = ( 1 / L ) )
s2::simpr |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> q e. { r e. Prime | r || L } )
i3::elrabi
s4:s2,i3:syl |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> q e. Prime )
i5::prmnn
s6:s4,i5:syl |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> q e. NN )
i7::sqfprm
s8:s4,i7:syl |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> ( mmu ` q ) =/= 0 )
i9::progvsqf
s10:s6,s8,i9:syl2anc |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` q ) = ( 1 / q ) )
s11:s10:oveq2d |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> ( 1 - ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` q ) ) = ( 1 - ( 1 / q ) ) )
s12:s11:oveq2d |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ q e. { r e. Prime | r || L } ) -> ( 1 / ( 1 - ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` q ) ) ) = ( 1 / ( 1 - ( 1 / q ) ) ) )
s13:s12:prodeq2dv |- ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) -> prod_ q e. { r e. Prime | r || L } ( 1 / ( 1 - ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` q ) ) ) = prod_ q e. { r e. Prime | r || L } ( 1 / ( 1 - ( 1 / q ) ) ) )
qed:s1,s13:oveq12d |- ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) -> ( ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` L ) x. prod_ q e. { r e. Prime | r || L } ( 1 / ( 1 - ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` q ) ) ) ) = ( ( 1 / L ) x. prod_ q e. { r e. Prime | r || L } ( 1 / ( 1 - ( 1 / q ) ) ) ) )
$)
