$( <MM> <PROOF_ASST> THEOREM=revfpop  LOC_AFTER=?

* The pop function of the reverse machine returns the popped optional letter.

s1::opelxpi |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> <. Q , X >. e. ( ( A |_| 1o ) X. ( A |_| 1o ) ) )
i2::fvres
s3:s1,i2:syl |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> ( ( 2nd |` ( ( A |_| 1o ) X. ( A |_| 1o ) ) ) ` <. Q , X >. ) = ( 2nd ` <. Q , X >. ) )
s4::simpl |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> Q e. ( A |_| 1o ) )
s5:s4:elexd |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> Q e. _V )
s6::simpr |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> X e. ( A |_| 1o ) )
s7:s6:elexd |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> X e. _V )
i8::op2ndg
s9:s5,s7,i8:syl2anc |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> ( 2nd ` <. Q , X >. ) = X )
qed:s3,s9:eqtrd |- ( ( Q e. ( A |_| 1o ) /\ X e. ( A |_| 1o ) ) -> ( ( 2nd |` ( ( A |_| 1o ) X. ( A |_| 1o ) ) ) ` <. Q , X >. ) = X )
$)
