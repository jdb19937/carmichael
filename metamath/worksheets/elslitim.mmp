s1::simpl |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> W e. CC )
s2::simpr |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> ( Im ` W ) =/= 0 )
i3::reim0b
s4:s1,i3:syl |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> ( W e. RR <-> ( Im ` W ) = 0 ) )
s5:s2:neneqd |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> -. ( Im ` W ) = 0 )
s6:s5,s4:mtbird |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> -. W e. RR )
s7:s6:pm2.21d |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> ( W e. RR -> W e. RR+ ) )
s8:s1,s7:jca |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> ( W e. CC /\ ( W e. RR -> W e. RR+ ) ) )
s9::eqid |- ( CC \ ( -oo (,] 0 ) ) = ( CC \ ( -oo (,] 0 ) )
s10:s9:ellogdm |- ( W e. ( CC \ ( -oo (,] 0 ) ) <-> ( W e. CC /\ ( W e. RR -> W e. RR+ ) ) )
s11:s10:a1i |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> ( W e. ( CC \ ( -oo (,] 0 ) ) <-> ( W e. CC /\ ( W e. RR -> W e. RR+ ) ) ) )
qed:s8,s11:mpbird |- ( ( W e. CC /\ ( Im ` W ) =/= 0 ) -> W e. ( CC \ ( -oo (,] 0 ) ) )
