s5::simprr |- ( ( ( V e. Word NN0 /\ W e. Word NN0 ) /\ ( ( Fun `' V /\ Fun `' W ) /\ ( ran V i^i ran W ) = (/) ) ) -> ( ran V i^i ran W ) = (/) )
