i12::algwrdfi
s13:s2,i12:syl |- ( ( ( V e. Word NN0 /\ W e. Word NN0 ) /\ ( ( Fun `' V /\ Fun `' W ) /\ ( ran V i^i ran W ) = (/) ) ) -> ran W e. Fin )
i14::hashun
s15:s11,s13,s5,i14:syl3anc |- ( ( ( V e. Word NN0 /\ W e. Word NN0 ) /\ ( ( Fun `' V /\ Fun `' W ) /\ ( ran V i^i ran W ) = (/) ) ) -> ( # ` ( ran V u. ran W ) ) = ( ( # ` ran V ) + ( # ` ran W ) ) )
