$( <MM> <PROOF_ASST> THEOREM=prmprodsetv  LOC_AFTER=?

* The prime divisors of the product over a finite set of primes are exactly that set (induction on the set).

s1::id |- ( v = (/) -> v = (/) )
c1:s1:sseq1d |- ( v = (/) -> ( v C_ Prime <-> (/) C_ Prime ) )
c2:s1:prodeq1d |- ( v = (/) -> prod_ q e. v q = prod_ q e. (/) q )
c3:c2:breq2d |- ( v = (/) -> ( p || prod_ q e. v q <-> p || prod_ q e. (/) q ) )
c4:c3:rabbidv |- ( v = (/) -> { p e. Prime | p || prod_ q e. v q } = { p e. Prime | p || prod_ q e. (/) q } )
c5:c4,s1:eqeq12d |- ( v = (/) -> ( { p e. Prime | p || prod_ q e. v q } = v <-> { p e. Prime | p || prod_ q e. (/) q } = (/) ) )
c6:c1,c5:imbi12d |- ( v = (/) -> ( ( v C_ Prime -> { p e. Prime | p || prod_ q e. v q } = v ) <-> ( (/) C_ Prime -> { p e. Prime | p || prod_ q e. (/) q } = (/) ) ) )
s2::id |- ( v = y -> v = y )
c7:s2:sseq1d |- ( v = y -> ( v C_ Prime <-> y C_ Prime ) )
c8:s2:prodeq1d |- ( v = y -> prod_ q e. v q = prod_ q e. y q )
c9:c8:breq2d |- ( v = y -> ( p || prod_ q e. v q <-> p || prod_ q e. y q ) )
c10:c9:rabbidv |- ( v = y -> { p e. Prime | p || prod_ q e. v q } = { p e. Prime | p || prod_ q e. y q } )
c11:c10,s2:eqeq12d |- ( v = y -> ( { p e. Prime | p || prod_ q e. v q } = v <-> { p e. Prime | p || prod_ q e. y q } = y ) )
c12:c7,c11:imbi12d |- ( v = y -> ( ( v C_ Prime -> { p e. Prime | p || prod_ q e. v q } = v ) <-> ( y C_ Prime -> { p e. Prime | p || prod_ q e. y q } = y ) ) )
s3::id |- ( v = ( y u. { z } ) -> v = ( y u. { z } ) )
c13:s3:sseq1d |- ( v = ( y u. { z } ) -> ( v C_ Prime <-> ( y u. { z } ) C_ Prime ) )
c14:s3:prodeq1d |- ( v = ( y u. { z } ) -> prod_ q e. v q = prod_ q e. ( y u. { z } ) q )
c15:c14:breq2d |- ( v = ( y u. { z } ) -> ( p || prod_ q e. v q <-> p || prod_ q e. ( y u. { z } ) q ) )
c16:c15:rabbidv |- ( v = ( y u. { z } ) -> { p e. Prime | p || prod_ q e. v q } = { p e. Prime | p || prod_ q e. ( y u. { z } ) q } )
c17:c16,s3:eqeq12d |- ( v = ( y u. { z } ) -> ( { p e. Prime | p || prod_ q e. v q } = v <-> { p e. Prime | p || prod_ q e. ( y u. { z } ) q } = ( y u. { z } ) ) )
c18:c13,c17:imbi12d |- ( v = ( y u. { z } ) -> ( ( v C_ Prime -> { p e. Prime | p || prod_ q e. v q } = v ) <-> ( ( y u. { z } ) C_ Prime -> { p e. Prime | p || prod_ q e. ( y u. { z } ) q } = ( y u. { z } ) ) ) )
s4::id |- ( v = Q -> v = Q )
c19:s4:sseq1d |- ( v = Q -> ( v C_ Prime <-> Q C_ Prime ) )
c20:s4:prodeq1d |- ( v = Q -> prod_ q e. v q = prod_ q e. Q q )
c21:c20:breq2d |- ( v = Q -> ( p || prod_ q e. v q <-> p || prod_ q e. Q q ) )
c22:c21:rabbidv |- ( v = Q -> { p e. Prime | p || prod_ q e. v q } = { p e. Prime | p || prod_ q e. Q q } )
c23:c22,s4:eqeq12d |- ( v = Q -> ( { p e. Prime | p || prod_ q e. v q } = v <-> { p e. Prime | p || prod_ q e. Q q } = Q ) )
c24:c19,c23:imbi12d |- ( v = Q -> ( ( v C_ Prime -> { p e. Prime | p || prod_ q e. v q } = v ) <-> ( Q C_ Prime -> { p e. Prime | p || prod_ q e. Q q } = Q ) ) )
s5::prmprodsetb |- ( (/) C_ Prime -> { p e. Prime | p || prod_ q e. (/) q } = (/) )
s6::prmprodsetlem |- ( ( ( y e. Fin /\ -. z e. y ) /\ ( y C_ Prime -> { p e. Prime | p || prod_ q e. y q } = y ) /\ ( y u. { z } ) C_ Prime ) -> { p e. Prime | p || prod_ q e. ( y u. { z } ) q } = ( y u. { z } ) )
s7:s6:3exp |- ( ( y e. Fin /\ -. z e. y ) -> ( ( y C_ Prime -> { p e. Prime | p || prod_ q e. y q } = y ) -> ( ( y u. { z } ) C_ Prime -> { p e. Prime | p || prod_ q e. ( y u. { z } ) q } = ( y u. { z } ) ) ) )
qed:c6,c12,c18,c24,s5,s7:findcard2s |- ( Q e. Fin -> ( Q C_ Prime -> { p e. Prime | p || prod_ q e. Q q } = Q ) )
