$( <MM> <PROOF_ASST> THEOREM=eatcl  LOC_AFTER=?

* Closure of the exponential e ( nu beta ) = exp ( 2 pi i nu beta ) (LargeSieve eAt).

s1::simpl |- ( ( V e. CC /\ B e. CC ) -> V e. CC )
s2::simpr |- ( ( V e. CC /\ B e. CC ) -> B e. CC )
s3::ax-icn |- _i e. CC
s4::picn |- _pi e. CC
s5:s3,s4:mulcli |- ( _i x. _pi ) e. CC
s6::2cn |- 2 e. CC
s7:s6,s5:mulcli |- ( 2 x. ( _i x. _pi ) ) e. CC
s8:s7:a1i |- ( ( V e. CC /\ B e. CC ) -> ( 2 x. ( _i x. _pi ) ) e. CC )
s9:s1,s2:mulcld |- ( ( V e. CC /\ B e. CC ) -> ( V x. B ) e. CC )
s10:s8,s9:mulcld |- ( ( V e. CC /\ B e. CC ) -> ( ( 2 x. ( _i x. _pi ) ) x. ( V x. B ) ) e. CC )
qed:s10:efcld |- ( ( V e. CC /\ B e. CC ) -> ( exp ` ( ( 2 x. ( _i x. _pi ) ) x. ( V x. B ) ) ) e. CC )
$)
