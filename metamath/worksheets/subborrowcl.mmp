$( <MM> <PROOF_ASST> THEOREM=subborrowcl  LOC_AFTER=?

* Closure of subborrow.

s1::simp1 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> X e. Word 2o )
s2::simp2 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> Y e. Word 2o )
s3::simp3 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> C e. 2o )
s4::subborrowval |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBorrow Y ) ` C ) = if ( ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) )
s5::1oel2o |- 1o e. 2o
s6:s5:a1i |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> 1o e. 2o )
s7::0el2o |- (/) e. 2o
s8:s7:a1i |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> (/) e. 2o )
s9:s6,s8:ifcld |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> if ( ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) e. 2o )
qed:s4,s9:eqeltrd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBorrow Y ) ` C ) e. 2o )
$)
