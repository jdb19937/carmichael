$( <MM> <PROOF_ASST> THEOREM=encnatlenpow  LOC_AFTER=?

* The length of encodeNat A is at most B when A < 2 ^ B (Lean: encodeNat_length_le_of_lt_pow).

s1::simp1 |- ( ( A e. NN0 /\ B e. NN0 /\ A < ( 2 ^ B ) ) -> A e. NN0 )
i2::encnatlenbl
s3:s1,i2:syl |- ( ( A e. NN0 /\ B e. NN0 /\ A < ( 2 ^ B ) ) -> ( # ` ( encodeNat ` A ) ) = ( bl ` A ) )
s4::blle |- ( ( A e. NN0 /\ B e. NN0 /\ A < ( 2 ^ B ) ) -> ( bl ` A ) <_ B )
qed:s3,s4:eqbrtrd |- ( ( A e. NN0 /\ B e. NN0 /\ A < ( 2 ^ B ) ) -> ( # ` ( encodeNat ` A ) ) <_ B )
$)
