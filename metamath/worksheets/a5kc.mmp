$( <MM> <PROOF_ASST> THEOREM=a5kc  LOC_AFTER=?

* The coprimality test of the scan agrees with coprimality to the modulus (Lean: coprimeTo_spec at Lmod).

h1::a5kc.1 |- ( ph -> ( Q e. Word NN0 /\ A. q e. ran Q q e. Prime ) )
h2::a5kc.2 |- ( ph -> K e. NN )
h3::a5kc.3 |- ( ph -> A = prod_ i e. ( 0 ..^ ( # ` Q ) ) ( Q ` i ) )
s1:1:simpld |- ( ph -> Q e. Word NN0 )
s2:1:simprd |- ( ph -> A. q e. ran Q q e. Prime )
s3:s1,2:jca |- ( ph -> ( Q e. Word NN0 /\ K e. NN ) )
s4:s3,s2:jca |- ( ph -> ( ( Q e. Word NN0 /\ K e. NN ) /\ A. q e. ran Q q e. Prime ) )
i5::coprimetospec
s6:s4,i5:syl |- ( ph -> ( ( 1st ` ( Q CoprimeTo K ) ) = 1o <-> ( K gcd prod_ i e. ( 0 ..^ ( # ` Q ) ) ( Q ` i ) ) = 1 ) )
s7:3:eqcomd |- ( ph -> prod_ i e. ( 0 ..^ ( # ` Q ) ) ( Q ` i ) = A )
s8:s7:oveq2d |- ( ph -> ( K gcd prod_ i e. ( 0 ..^ ( # ` Q ) ) ( Q ` i ) ) = ( K gcd A ) )
s9:s8:eqeq1d |- ( ph -> ( ( K gcd prod_ i e. ( 0 ..^ ( # ` Q ) ) ( Q ` i ) ) = 1 <-> ( K gcd A ) = 1 ) )
qed:s6,s9:bitrd |- ( ph -> ( ( 1st ` ( Q CoprimeTo K ) ) = 1o <-> ( K gcd A ) = 1 ) )
