$( <MM> <PROOF_ASST> THEOREM=holdv  LOC_AFTER=?

* The derivative of a function holomorphic on its whole domain, as a mapping: the input every mapping-form derivative rule needs.

s1::simpl |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> F e. ( D -cn-> CC ) )
i2::cncff
s3:s1,i2:syl |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> F : D --> CC )
s4:s3:feqmptd |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> F = ( z e. D |-> ( F ` z ) ) )
s5::holf |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> ( CC _D F ) : D --> CC )
s6:s5:feqmptd |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> ( CC _D F ) = ( z e. D |-> ( ( CC _D F ) ` z ) ) )
s7:s4:oveq2d |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> ( CC _D F ) = ( CC _D ( z e. D |-> ( F ` z ) ) ) )
s8:s7:eqcomd |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> ( CC _D ( z e. D |-> ( F ` z ) ) ) = ( CC _D F ) )
qed:s8,s6:eqtrd |- ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) -> ( CC _D ( z e. D |-> ( F ` z ) ) ) = ( z e. D |-> ( ( CC _D F ) ` z ) ) )
$)
