$( <MM> <PROOF_ASST> THEOREM=dshp11  LOC_AFTER=?

* Lean ` P1_one ` : ` P1 N 1 = sum_ r e. { 1 } 1 / r = 1 ` (~ dshrs1 , ~ sumsn ).

s1::id |- ( N e. NN -> N e. NN )
i2::dshrs1
s3:s1,i2:syl |- ( N e. NN -> ( N RSet 1 ) = { 1 } )
s4:s3:sumeq1d |- ( N e. NN -> sum_ r e. ( N RSet 1 ) ( 1 / r ) = sum_ r e. { 1 } ( 1 / r ) )
s5::oveq2 |- ( r = 1 -> ( 1 / r ) = ( 1 / 1 ) )
s6::1nn |- 1 e. NN
s7:s6:a1i |- ( N e. NN -> 1 e. NN )
s8::1div1e1 |- ( 1 / 1 ) = 1
s9::ax-1cn |- 1 e. CC
s10:s8,s9:eqeltri |- ( 1 / 1 ) e. CC
s11:s10:a1i |- ( N e. NN -> ( 1 / 1 ) e. CC )
s12:s7,s11:jca |- ( N e. NN -> ( 1 e. NN /\ ( 1 / 1 ) e. CC ) )
s13:s5:sumsn |- ( ( 1 e. NN /\ ( 1 / 1 ) e. CC ) -> sum_ r e. { 1 } ( 1 / r ) = ( 1 / 1 ) )
s14:s12,s13:syl |- ( N e. NN -> sum_ r e. { 1 } ( 1 / r ) = ( 1 / 1 ) )
s15:s4,s14:eqtrd |- ( N e. NN -> sum_ r e. ( N RSet 1 ) ( 1 / r ) = ( 1 / 1 ) )
s16:s8:a1i |- ( N e. NN -> ( 1 / 1 ) = 1 )
qed:s15,s16:eqtrd |- ( N e. NN -> sum_ r e. ( N RSet 1 ) ( 1 / r ) = 1 )
$)
