$( <MM> <PROOF_ASST> THEOREM=cseglin  LOC_AFTER=?

* A point of the parametrisation lies in the segment.

s1::simp1 |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> A e. CC )
s2::simp2 |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> B e. CC )
s3::simp3 |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> T e. ( 0 [,] 1 ) )
s4::eqidd |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> ( A + ( T x. ( B - A ) ) ) = ( A + ( T x. ( B - A ) ) ) )
s5::oveq1 |- ( t = T -> ( t x. ( B - A ) ) = ( T x. ( B - A ) ) )
s6:s5:oveq2d |- ( t = T -> ( A + ( t x. ( B - A ) ) ) = ( A + ( T x. ( B - A ) ) ) )
s7:s6:eqeq2d |- ( t = T -> ( ( A + ( T x. ( B - A ) ) ) = ( A + ( t x. ( B - A ) ) ) <-> ( A + ( T x. ( B - A ) ) ) = ( A + ( T x. ( B - A ) ) ) ) )
s8:s7:adantl |- ( ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) /\ t = T ) -> ( ( A + ( T x. ( B - A ) ) ) = ( A + ( t x. ( B - A ) ) ) <-> ( A + ( T x. ( B - A ) ) ) = ( A + ( T x. ( B - A ) ) ) ) )
s9:s3,s8,s4:rspcedvd |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> E. t e. ( 0 [,] 1 ) ( A + ( T x. ( B - A ) ) ) = ( A + ( t x. ( B - A ) ) ) )
i10::csegel
s11:s1,s2,i10:syl2anc |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> ( ( A + ( T x. ( B - A ) ) ) e. ( A cseg B ) <-> E. t e. ( 0 [,] 1 ) ( A + ( T x. ( B - A ) ) ) = ( A + ( t x. ( B - A ) ) ) ) )
qed:s9,s11:mpbird |- ( ( A e. CC /\ B e. CC /\ T e. ( 0 [,] 1 ) ) -> ( A + ( T x. ( B - A ) ) ) e. ( A cseg B ) )
