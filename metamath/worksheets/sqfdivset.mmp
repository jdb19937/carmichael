s12:s10,s11:jca |- ( ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ m e. NN ) /\ m || L ) -> ( ( mmu ` m ) =/= 0 /\ m || L ) )
s13::simprr |- ( ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ m e. NN ) /\ ( ( mmu ` m ) =/= 0 /\ m || L ) ) -> m || L )
s14:s13,s12:impbida |- ( ( ( L e. NN /\ ( mmu ` L ) =/= 0 ) /\ m e. NN ) -> ( ( ( mmu ` m ) =/= 0 /\ m || L ) <-> m || L ) )
