$( <MM> <PROOF_ASST> THEOREM=modone  LOC_AFTER=?

* A number congruent to one modulo the modulus has residue one.

s1::simpl |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> ( M e. NN0 /\ L e. NN ) )
s2:s1:simpld |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> M e. NN0 )
s3::simpl |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> ( M e. NN0 /\ L e. NN ) )
s4:s3:simprd |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> L e. NN )
s5::simpr |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> L || ( M - 1 ) )
s6:s2:nn0zd |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> M e. ZZ )
s7::1z |- 1 e. ZZ
s8:s7:a1i |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> 1 e. ZZ )
i9::moddvds
s10:s4,s6,s8,i9:syl3anc |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> ( ( M mod L ) = ( 1 mod L ) <-> L || ( M - 1 ) ) )
qed:s5,s10:mpbird |- ( ( ( M e. NN0 /\ L e. NN ) /\ L || ( M - 1 ) ) -> ( M mod L ) = ( 1 mod L ) )
$)
