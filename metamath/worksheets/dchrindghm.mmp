s14:s12:ablgrpd |- ( ( N e. NN /\ M e. NN /\ N || M ) -> ( DChr ` M ) e. Grp )
s15::dchrindf |- ( ( N e. NN /\ M e. NN /\ N || M ) -> ( N DChrInd M ) : ( Base ` ( DChr ` N ) ) --> ( Base ` ( DChr ` M ) ) )
s16::simpl |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( x e. ( Base ` ( DChr ` N ) ) /\ y e. ( Base ` ( DChr ` N ) ) ) ) -> ( N e. NN /\ M e. NN /\ N || M ) )
s17::simprl |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( x e. ( Base ` ( DChr ` N ) ) /\ y e. ( Base ` ( DChr ` N ) ) ) ) -> x e. ( Base ` ( DChr ` N ) ) )
s18::simprr |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( x e. ( Base ` ( DChr ` N ) ) /\ y e. ( Base ` ( DChr ` N ) ) ) ) -> y e. ( Base ` ( DChr ` N ) ) )
i19::dchrindmul
s20:s16,s17,s18,i19:syl3anc |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ ( x e. ( Base ` ( DChr ` N ) ) /\ y e. ( Base ` ( DChr ` N ) ) ) ) -> ( ( N DChrInd M ) ` ( x ( +g ` ( DChr ` N ) ) y ) ) = ( ( ( N DChrInd M ) ` x ) ( +g ` ( DChr ` M ) ) ( ( N DChrInd M ) ` y ) ) )
