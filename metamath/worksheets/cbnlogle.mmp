$( <MM> <PROOF_ASST> THEOREM=cbnlogle  LOC_AFTER=?

* The binary logarithm of a positive integer is at most the integer (Lean AlgBudget.lean uses Nat.log_le_self for the same step).

s1::id |- ( Z e. NN -> Z e. NN )
s2::2z |- 2 e. ZZ
i3::uzid
s4:s2,i3:ax-mp |- 2 e. ( ZZ>= ` 2 )
s5:s4:a1i |- ( Z e. NN -> 2 e. ( ZZ>= ` 2 ) )
i6::nlogle
s7:s5,s1,i6:syl2anc |- ( Z e. NN -> ( 2 ^ ( 2 Nlog Z ) ) <_ Z )
s8::2nn0 |- 2 e. NN0
s9:s8:a1i |- ( Z e. NN -> 2 e. NN0 )
s10:s1:nnnn0d |- ( Z e. NN -> Z e. NN0 )
i11::nlogcl
s12:s9,s10,i11:syl2anc |- ( Z e. NN -> ( 2 Nlog Z ) e. NN0 )
i13::bernneq3
s14:s5,s12,i13:syl2anc |- ( Z e. NN -> ( 2 Nlog Z ) < ( 2 ^ ( 2 Nlog Z ) ) )
s15:s8:a1i |- ( Z e. NN -> 2 e. NN0 )
s16:s1:nnnn0d |- ( Z e. NN -> Z e. NN0 )
i17::nlogcl
s18:s15,s16,i17:syl2anc |- ( Z e. NN -> ( 2 Nlog Z ) e. NN0 )
s19:s18:nn0zd |- ( Z e. NN -> ( 2 Nlog Z ) e. ZZ )
s20:s19:zred |- ( Z e. NN -> ( 2 Nlog Z ) e. RR )
s21::2re |- 2 e. RR
s22:s21:a1i |- ( Z e. NN -> 2 e. RR )
s23:s22,s18:reexpcld |- ( Z e. NN -> ( 2 ^ ( 2 Nlog Z ) ) e. RR )
s24:s1:nnrpd |- ( Z e. NN -> Z e. RR+ )
s25:s24:rpred |- ( Z e. NN -> Z e. RR )
s26:s20,s23,s25,s14,s7:ltletrd |- ( Z e. NN -> ( 2 Nlog Z ) < Z )
qed:s26:ltled |- ( Z e. NN -> ( 2 Nlog Z ) <_ Z )
$)
