$( <MM> <PROOF_ASST> THEOREM=z5sqfdvd  LOC_AFTER=?

* A divisor of a squarefree number is squarefree (Lean Squarefree.squarefree_of_dvd): mmu ( D ) = 0 would give mmu ( D ( M / D ) ) = 0 by mumullem1.

s1::simpll |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> M e. NN )
s2::simplr |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( mmu ` M ) =/= 0 )
s3::simprl |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> D e. NN )
s4::simprr |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> D || M )
i5::nndivdvds
s6:s1,s3,i5:syl2anc |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( D || M <-> ( M / D ) e. NN ) )
s7:s4,s6:mpbid |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( M / D ) e. NN )
s8:s3:nncnd |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> D e. CC )
s9:s1:nncnd |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> M e. CC )
s10:s3:nnne0d |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> D =/= 0 )
s11:s9,s8,s10:divcan2d |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( D x. ( M / D ) ) = M )
s12:s3:adantr |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> D e. NN )
s13:s7:adantr |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( M / D ) e. NN )
s14::simpr |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( mmu ` D ) = 0 )
i15::mumullem1
s16:s12,s13,s14,i15:syl21anc |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( mmu ` ( D x. ( M / D ) ) ) = 0 )
s17:s11:adantr |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( D x. ( M / D ) ) = M )
s18:s17:fveq2d |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( mmu ` ( D x. ( M / D ) ) ) = ( mmu ` M ) )
s19:s18,s16:eqtr3d |- ( ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) /\ ( mmu ` D ) = 0 ) -> ( mmu ` M ) = 0 )
s20:s19:ex |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( ( mmu ` D ) = 0 -> ( mmu ` M ) = 0 ) )
s21:s20:necon3d |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( ( mmu ` M ) =/= 0 -> ( mmu ` D ) =/= 0 ) )
qed:s2,s21:mpd |- ( ( ( M e. NN /\ ( mmu ` M ) =/= 0 ) /\ ( D e. NN /\ D || M ) ) -> ( mmu ` D ) =/= 0 )
