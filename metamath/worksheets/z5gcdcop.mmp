i22::gcddvds
s23:s12,s11,i22:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w /\ ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) || M ) )
s24:s23:simpld |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w )
i25::rpdvds
s26:s10,s18,s12,s5,s24,i25:syl32anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( D gcd ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) ) = 1 )
i27::gcdcom
s28:s18,s10,i27:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) gcd D ) = ( D gcd ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) ) )
s29:s28,s26:eqtrd |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) gcd D ) = 1 )
i30::rpdvds
