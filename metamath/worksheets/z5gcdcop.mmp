s11:s3:nnzd |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> M e. ZZ )
s12:s8:nnzd |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. ZZ )
i13::gcdnncl
s14:s1,s2,i13:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( R gcd D ) e. NN )
s15:s14:nnzd |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( R gcd D ) e. ZZ )
i16::gcdnncl
s17:s8,s3,i16:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) e. NN )
s18:s17:nnzd |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w gcd M ) e. ZZ )
i19::gcddvds
s20:s9,s10,i19:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( ( R gcd D ) || R /\ ( R gcd D ) || D ) )
