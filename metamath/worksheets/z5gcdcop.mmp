$( <MM> <PROOF_ASST> THEOREM=z5gcdcop  LOC_AFTER=?

* Lean coprime_gcd_gcd_tOf: the two factors ( R , D ) and ( t ( D ; R ) , M ) of the gcd splitting are coprime.

s1::simpl |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> R e. NN )
s2::simprl |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> D e. NN )
s3::simprr |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> M e. NN )
i4::z5tofcop
s5:s1,s2,i4:syl2anc |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( D gcd prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) = 1 )
i6::z5tofsq
s7:s1,i6:syl |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN /\ ( mmu ` prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) =/= 0 ) /\ { q e. Prime | q || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w } = { q e. Prime | ( q || R /\ -. q || D ) } ) )
s8:s7:simplld |- ( ( R e. NN /\ ( D e. NN /\ M e. NN ) ) -> prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN )
