s5:s4:zcnd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ a e. ( 0 ..^ N ) ) -> a e. CC )
s6:s5:mullidd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ a e. ( 0 ..^ N ) ) -> ( 1 x. a ) = a )
s7:s6:eqcomd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ a e. ( 0 ..^ N ) ) -> a = ( 1 x. a ) )
s8:s7:oveq2d |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ a e. ( 0 ..^ N ) ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ a ) = ( ( -u 1 ^c ( 2 / N ) ) ^ ( 1 x. a ) ) )
s9:s8:oveq2d |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ a e. ( 0 ..^ N ) ) -> ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ a ) ) = ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ ( 1 x. a ) ) ) )
s10:s9:sumeq2dv |- ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) -> sum_ a e. ( 0 ..^ N ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ a ) ) = sum_ a e. ( 0 ..^ N ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ ( 1 x. a ) ) ) )
qed:s1,s10:eqtrd |- ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) -> ( N DChrGS X ) = sum_ a e. ( 0 ..^ N ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` a ) ) x. ( ( -u 1 ^c ( 2 / N ) ) ^ ( 1 x. a ) ) ) )
