s12::fveq2 |- ( w = ( encNatGam ` a ) -> ( # ` w ) = ( # ` ( encNatGam ` a ) ) )
s13:s12:breq1d |- ( w = ( encNatGam ` a ) -> ( ( # ` w ) <_ B <-> ( # ` ( encNatGam ` a ) ) <_ B ) )
s14:s13:ralima |- ( ( encNatGam Fn NN0 /\ ran L C_ NN0 ) -> ( A. w e. ( encNatGam " ran L ) ( # ` w ) <_ B <-> A. a e. ran L ( # ` ( encNatGam ` a ) ) <_ B ) )
s15:s7,s11,s14:syl2anc |- ( ( L e. Word NN0 /\ B e. NN0 /\ A. a e. ran L a < ( 2 ^ B ) ) -> ( A. w e. ( encNatGam " ran L ) ( # ` w ) <_ B <-> A. a e. ran L ( # ` ( encNatGam ` a ) ) <_ B ) )
s16::simpl |- ( ( L e. Word NN0 /\ B e. NN0 ) -> L e. Word NN0 )
