s5:s1:nncnd |- ( ( U e. NN /\ V e. NN /\ K e. ZZ ) -> U e. CC )
s6:s1:nnne0d |- ( ( U e. NN /\ V e. NN /\ K e. ZZ ) -> U =/= 0 )
