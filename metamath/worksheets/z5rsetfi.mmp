$( <MM> <PROOF_ASST> THEOREM=z5rsetfi  LOC_AFTER=?

* The pseudocharacter index set is a finite subset of ( 1 ... ( |_ ` R ) ) (Lean Rset is a Finset).

s1::id |- ( ( N e. V /\ R e. W ) -> ( N e. V /\ R e. W ) )
i2::z5rsetval
s3:s1,i2:syl |- ( ( N e. V /\ R e. W ) -> ( N RSet R ) = { k e. ( 1 ... ( |_ ` R ) ) | ( ( mmu ` k ) =/= 0 /\ ( k gcd N ) = 1 ) } )
s4::ssrab2 |- { k e. ( 1 ... ( |_ ` R ) ) | ( ( mmu ` k ) =/= 0 /\ ( k gcd N ) = 1 ) } C_ ( 1 ... ( |_ ` R ) )
s5:s4:a1i |- ( ( N e. V /\ R e. W ) -> { k e. ( 1 ... ( |_ ` R ) ) | ( ( mmu ` k ) =/= 0 /\ ( k gcd N ) = 1 ) } C_ ( 1 ... ( |_ ` R ) ) )
s6:s3,s5:eqsstrd |- ( ( N e. V /\ R e. W ) -> ( N RSet R ) C_ ( 1 ... ( |_ ` R ) ) )
s7::fzfid |- ( ( N e. V /\ R e. W ) -> ( 1 ... ( |_ ` R ) ) e. Fin )
i8::ssfi
s9:s7,s6,i8:syl2anc |- ( ( N e. V /\ R e. W ) -> ( N RSet R ) e. Fin )
qed:s6,s9:jca |- ( ( N e. V /\ R e. W ) -> ( ( N RSet R ) C_ ( 1 ... ( |_ ` R ) ) /\ ( N RSet R ) e. Fin ) )
