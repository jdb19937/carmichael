$( <MM> <PROOF_ASST> THEOREM=tonatrep1  LOC_AFTER=?

* The value of a word of E true letters is 2 ^ E - 1.

s1::id |- ( E e. NN0 -> E e. NN0 )
s2::bwrep1 |- ( E e. NN0 -> ( 1o repeatS E ) = ( -u 1 bwrd E ) )
s3:s2:fveq2d |- ( E e. NN0 -> ( toNat ` ( 1o repeatS E ) ) = ( toNat ` ( -u 1 bwrd E ) ) )
s4::neg1z |- -u 1 e. ZZ
s5:s4:a1i |- ( E e. NN0 -> -u 1 e. ZZ )
i6::tonatbwrd
s7:s5,s1,i6:syl2anc |- ( E e. NN0 -> ( toNat ` ( -u 1 bwrd E ) ) = ( -u 1 mod ( 2 ^ E ) ) )
s8::2nn |- 2 e. NN
s9:s8:a1i |- ( E e. NN0 -> 2 e. NN )
i10::nnexpcl
s11:s9,s1,i10:syl2anc |- ( E e. NN0 -> ( 2 ^ E ) e. NN )
i12::m1modnnsub1
s13:s11,i12:syl |- ( E e. NN0 -> ( -u 1 mod ( 2 ^ E ) ) = ( ( 2 ^ E ) - 1 ) )
qed:s3,s7,s13:3eqtrd |- ( E e. NN0 -> ( toNat ` ( 1o repeatS E ) ) = ( ( 2 ^ E ) - 1 ) )
$)
