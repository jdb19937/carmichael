s15:s12,s14:jca |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> ( 1 e. RR /\ A. m e. NN ( abs ` sum_ i e. ( 1 ... m ) ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` i ) ) <_ 1 ) )
s16:s10,s15:jca |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> ( ( ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) : NN --> CC /\ 1 e. RR /\ A. m e. NN ( abs ` ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` m ) ) <_ 1 ) /\ ( Z e. CC /\ 1 < ( Re ` Z ) ) ) /\ ( 1 e. RR /\ A. m e. NN ( abs ` sum_ i e. ( 1 ... m ) ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` i ) ) <_ 1 ) ) )
i17::abagr
s18:s16,i17:syl |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> sum_ k e. NN ( sum_ i e. ( 1 ... k ) ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` i ) x. ( ( k ^c -u Z ) - ( ( k + 1 ) ^c -u Z ) ) ) = sum_ k e. NN ( ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` k ) x. ( k ^c -u Z ) ) )
s19::simpr |- ( ( ( Z e. CC /\ 1 < ( Re ` Z ) ) /\ k e. NN ) -> k e. NN )
