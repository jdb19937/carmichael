s4:s1:negcld |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> -u Z e. CC )
s5::altabs |- ( ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) : NN --> CC /\ 1 e. RR /\ A. m e. NN ( abs ` ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` m ) ) <_ 1 ) /\ A. m e. NN ( abs ` sum_ i e. ( 1 ... m ) ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` i ) ) <_ 1 )
s6:s5:a1i |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> ( ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) : NN --> CC /\ 1 e. RR /\ A. m e. NN ( abs ` ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` m ) ) <_ 1 ) /\ A. m e. NN ( abs ` sum_ i e. ( 1 ... m ) ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` i ) ) <_ 1 ) )
i7::simpl
