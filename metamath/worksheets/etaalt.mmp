s9::id |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> ( Z e. CC /\ 1 < ( Re ` Z ) ) )
s10:s8,s9:jca |- ( ( Z e. CC /\ 1 < ( Re ` Z ) ) -> ( ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) : NN --> CC /\ 1 e. RR /\ A. m e. NN ( abs ` ( ( q e. NN |-> ( ( 2 x. ( q mod 2 ) ) - 1 ) ) ` m ) ) <_ 1 ) /\ ( Z e. CC /\ 1 < ( Re ` Z ) ) ) )
