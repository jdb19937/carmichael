$( <MM> <PROOF_ASST> THEOREM=xceilwrd  LOC_AFTER=?

* The prime-search ceiling of the entries of a duplicate-free word (Lean: xceil_toFinset).

s1::simpl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W e. Word NN0 )
i2::wrdf
s3:s1,i2:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> W : ( 0 ..^ ( # ` W ) ) --> NN0 )
i4::frn
s5:s3,i4:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> ran W C_ NN0 )
s6::nn0ex |- NN0 e. _V
s7:s6:elpw2 |- ( ran W e. ~P NN0 <-> ran W C_ NN0 )
s8:s7:a1i |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( ran W e. ~P NN0 <-> ran W C_ NN0 ) )
s9:s8,s5:mpbird |- ( ( W e. Word NN0 /\ Fun `' W ) -> ran W e. ~P NN0 )
i10::algwrdfi
s11:s1,i10:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> ran W e. Fin )
s12:s9,s11:elind |- ( ( W e. Word NN0 /\ Fun `' W ) -> ran W e. ( ~P NN0 i^i Fin ) )
i13::xceilval
s14:s12,i13:syl |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( xceil ` ran W ) = ( ( Lmod ` ran W ) ^ 5 ) )
s15::lmodwrd |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( Lmod ` ran W ) = prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) )
s16:s15:oveq1d |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( ( Lmod ` ran W ) ^ 5 ) = ( prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) ^ 5 ) )
qed:s14,s16:eqtrd |- ( ( W e. Word NN0 /\ Fun `' W ) -> ( xceil ` ran W ) = ( prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) ^ 5 ) )
$)
