$( <MM> <PROOF_ASST> THEOREM=psiapval  LOC_AFTER=?

* Value of psi in a residue class (Lean: psiAP_def).

s1::psiapfval |- ( Q e. NN -> ( psiAP ` Q ) = ( a e. ZZ , y e. RR |-> sum_ n e. ( 1 ... ( |_ ` y ) ) if ( ( n mod Q ) = ( a mod Q ) , ( Lam ` n ) , 0 ) ) )
s2:s1:3ad2ant1 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( psiAP ` Q ) = ( a e. ZZ , y e. RR |-> sum_ n e. ( 1 ... ( |_ ` y ) ) if ( ( n mod Q ) = ( a mod Q ) , ( Lam ` n ) , 0 ) ) )
s3::simprl |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> a = A )
s4::simprr |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> y = Y )
s5:s4:fveq2d |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> ( |_ ` y ) = ( |_ ` Y ) )
s6:s5:oveq2d |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> ( 1 ... ( |_ ` y ) ) = ( 1 ... ( |_ ` Y ) ) )
s7:s3:oveq1d |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> ( a mod Q ) = ( A mod Q ) )
s8:s7:eqeq2d |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> ( ( n mod Q ) = ( a mod Q ) <-> ( n mod Q ) = ( A mod Q ) ) )
s9:s8:ifbid |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> if ( ( n mod Q ) = ( a mod Q ) , ( Lam ` n ) , 0 ) = if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) )
s10:s9:adantr |- ( ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) /\ n e. ( 1 ... ( |_ ` y ) ) ) -> if ( ( n mod Q ) = ( a mod Q ) , ( Lam ` n ) , 0 ) = if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) )
s11:s6,s10:sumeq12dv |- ( ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) /\ ( a = A /\ y = Y ) ) -> sum_ n e. ( 1 ... ( |_ ` y ) ) if ( ( n mod Q ) = ( a mod Q ) , ( Lam ` n ) , 0 ) = sum_ n e. ( 1 ... ( |_ ` Y ) ) if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) )
s12::simp2 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> A e. ZZ )
s13::simp3 |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> Y e. RR )
s14::sumex |- sum_ n e. ( 1 ... ( |_ ` Y ) ) if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) e. _V
s15:s14:a1i |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> sum_ n e. ( 1 ... ( |_ ` Y ) ) if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) e. _V )
qed:s2,s11,s12,s13,s15:ovmpod |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( psiAP ` Q ) Y ) = sum_ n e. ( 1 ... ( |_ ` Y ) ) if ( ( n mod Q ) = ( A mod Q ) , ( Lam ` n ) , 0 ) )
