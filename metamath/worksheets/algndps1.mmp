s1::elex |- ( P e. NN0 -> P e. _V )
i2::s1val
s3:s1,i2:syl |- ( P e. NN0 -> <" P "> = { <. 0 , P >. } )
s4:s3:cnveqd |- ( P e. NN0 -> `' <" P "> = `' { <. 0 , P >. } )
s5::c0ex |- 0 e. _V
s6:s5:a1i |- ( P e. NN0 -> 0 e. _V )
i7::cnvsng
