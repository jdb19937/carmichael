$( <MM> <PROOF_ASST> THEOREM=fzocongeq0  LOC_AFTER=?

* Two residues in ( 0 ..^ N ) are congruent mod N only if they are equal (fzocongeq at 0).

s1::simp2 |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> B e. ( 0 ..^ N ) )
s2::simp3 |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> C e. ( 0 ..^ N ) )
i3::fzocongeq
s4:s1,s2,i3:syl2anc |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> ( ( N - 0 ) || ( B - C ) <-> B = C ) )
s5::simp1 |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> N e. NN )
s6:s5:nncnd |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> N e. CC )
s7:s6:subid1d |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> ( N - 0 ) = N )
s8:s7:breq1d |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> ( ( N - 0 ) || ( B - C ) <-> N || ( B - C ) ) )
qed:s8,s4:bitr3d |- ( ( N e. NN /\ B e. ( 0 ..^ N ) /\ C e. ( 0 ..^ N ) ) -> ( N || ( B - C ) <-> B = C ) )
$)
