$( <MM> <PROOF_ASST> THEOREM=iooirev  LOC_AFTER=?

* The reversal of a point of the open unit interval lies in the open unit interval.

s1::id |- ( T e. ( 0 (,) 1 ) -> T e. ( 0 (,) 1 ) )
i2::elioore
s3:s1,i2:syl |- ( T e. ( 0 (,) 1 ) -> T e. RR )
i4::eliooord
s5:s1,i4:syl |- ( T e. ( 0 (,) 1 ) -> ( 0 < T /\ T < 1 ) )
s6:s5:simpld |- ( T e. ( 0 (,) 1 ) -> 0 < T )
s7:s5:simprd |- ( T e. ( 0 (,) 1 ) -> T < 1 )
s8::1red |- ( T e. ( 0 (,) 1 ) -> 1 e. RR )
s9:s8,s3:resubcld |- ( T e. ( 0 (,) 1 ) -> ( 1 - T ) e. RR )
s10:s3,s8:posdifd |- ( T e. ( 0 (,) 1 ) -> ( T < 1 <-> 0 < ( 1 - T ) ) )
s11:s7,s10:mpbid |- ( T e. ( 0 (,) 1 ) -> 0 < ( 1 - T ) )
i12::ltaddpos
s13:s3,s8,i12:syl2anc |- ( T e. ( 0 (,) 1 ) -> ( 0 < T <-> 1 < ( 1 + T ) ) )
s14:s6,s13:mpbid |- ( T e. ( 0 (,) 1 ) -> 1 < ( 1 + T ) )
i15::ltsubadd
s16:s8,s3,s8,i15:syl3anc |- ( T e. ( 0 (,) 1 ) -> ( ( 1 - T ) < 1 <-> 1 < ( 1 + T ) ) )
s17:s14,s16:mpbird |- ( T e. ( 0 (,) 1 ) -> ( 1 - T ) < 1 )
s18::0xr |- 0 e. RR*
s19:s18:a1i |- ( T e. ( 0 (,) 1 ) -> 0 e. RR* )
s20::1xr |- 1 e. RR*
s21:s20:a1i |- ( T e. ( 0 (,) 1 ) -> 1 e. RR* )
i22::elioo2
s23:s19,s21,i22:syl2anc |- ( T e. ( 0 (,) 1 ) -> ( ( 1 - T ) e. ( 0 (,) 1 ) <-> ( ( 1 - T ) e. RR /\ 0 < ( 1 - T ) /\ ( 1 - T ) < 1 ) ) )
qed:s9,s11,s17,s23:mpbir3and |- ( T e. ( 0 (,) 1 ) -> ( 1 - T ) e. ( 0 (,) 1 ) )
