s5:s1,s2,i4:syl2anc |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( ( N RSet R ) C_ ( 1 ... ( |_ ` R ) ) /\ ( N RSet R ) e. Fin ) )
s6:s5:simpld |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( N RSet R ) C_ ( 1 ... ( |_ ` R ) ) )
s7::fzfid |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( 1 ... ( |_ ` R ) ) e. Fin )
i8::hashssle
s9:s7,s6,i8:syl2anc |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( # ` ( N RSet R ) ) <_ ( # ` ( 1 ... ( |_ ` R ) ) ) )
i10::flge0nn0
s11:s2,s3,i10:syl2anc |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( |_ ` R ) e. NN0 )
i12::hashfz1
s13:s11,i12:syl |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( # ` ( 1 ... ( |_ ` R ) ) ) = ( |_ ` R ) )
qed:s9,s13:breqtrd |- ( ( N e. V /\ ( R e. RR /\ 0 <_ R ) ) -> ( # ` ( N RSet R ) ) <_ ( |_ ` R ) )
