$( <MM> <PROOF_ASST> THEOREM=lmodqcl  LOC_AFTER=?

* Closure of Lmod: a positive integer when Q is a finite set of primes.

s1::id |- ( Q e. ( ~P Prime i^i Fin ) -> Q e. ( ~P Prime i^i Fin ) )
i2::elfpw
s3:s1,i2:sylib |- ( Q e. ( ~P Prime i^i Fin ) -> ( Q C_ Prime /\ Q e. Fin ) )
s4:s3:simpld |- ( Q e. ( ~P Prime i^i Fin ) -> Q C_ Prime )
s5:s3:simprd |- ( Q e. ( ~P Prime i^i Fin ) -> Q e. Fin )
s6::prmssnn |- Prime C_ NN
s7::nnssnn0 |- NN C_ NN0
s8:s6,s7:sstri |- Prime C_ NN0
s9:s8:a1i |- ( Q e. ( ~P Prime i^i Fin ) -> Prime C_ NN0 )
s10:s4,s9:sstrd |- ( Q e. ( ~P Prime i^i Fin ) -> Q C_ NN0 )
s11:s10,s5:jca |- ( Q e. ( ~P Prime i^i Fin ) -> ( Q C_ NN0 /\ Q e. Fin ) )
i12::elfpw
s13:s11,i12:sylibr |- ( Q e. ( ~P Prime i^i Fin ) -> Q e. ( ~P NN0 i^i Fin ) )
i14::lmodqval
s15:s13,i14:syl |- ( Q e. ( ~P Prime i^i Fin ) -> ( Lmod ` Q ) = prod_ q e. Q q )
s16:s4:adantr |- ( ( Q e. ( ~P Prime i^i Fin ) /\ q e. Q ) -> Q C_ Prime )
s17::simpr |- ( ( Q e. ( ~P Prime i^i Fin ) /\ q e. Q ) -> q e. Q )
s18:s16,s17:sseldd |- ( ( Q e. ( ~P Prime i^i Fin ) /\ q e. Q ) -> q e. Prime )
i19::prmnn
s20:s18,i19:syl |- ( ( Q e. ( ~P Prime i^i Fin ) /\ q e. Q ) -> q e. NN )
s21:s5,s20:fprodnncl |- ( Q e. ( ~P Prime i^i Fin ) -> prod_ q e. Q q e. NN )
qed:s15,s21:eqeltrd |- ( Q e. ( ~P Prime i^i Fin ) -> ( Lmod ` Q ) e. NN )
$)
