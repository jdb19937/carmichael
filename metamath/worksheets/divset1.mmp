$( <MM> <PROOF_ASST> THEOREM=divset1  LOC_AFTER=?

* The divisors of one.

s1::1z |- 1 e. ZZ
i2::fzsn
s3:s1,i2:ax-mp |- ( 1 ... 1 ) = { 1 }
i4::rabeq
s5:s3,i4:ax-mp |- { m e. ( 1 ... 1 ) | m || 1 } = { m e. { 1 } | m || 1 }
s6::1z |- 1 e. ZZ
i7::iddvds
s8:s6,i7:ax-mp |- 1 || 1
s9::breq1 |- ( m = 1 -> ( m || 1 <-> 1 || 1 ) )
s10:s9:ralsng |- ( 1 e. _V -> ( A. m e. { 1 } m || 1 <-> 1 || 1 ) )
s11::1ex |- 1 e. _V
s12:s11,s10:ax-mp |- ( A. m e. { 1 } m || 1 <-> 1 || 1 )
s13:s8,s12:mpbir |- A. m e. { 1 } m || 1
i14::rabid2
s15:s13,i14:mpbir |- { 1 } = { m e. { 1 } | m || 1 }
s16:s15:eqcomi |- { m e. { 1 } | m || 1 } = { 1 }
qed:s5,s16:eqtri |- { m e. ( 1 ... 1 ) | m || 1 } = { 1 }
$)
