i7::dvcxp2
s8:s1,i7:syl |- ( U e. RR+ -> ( CC _D ( z e. CC |-> ( U ^c z ) ) ) = ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) ) )
s9:s1:adantr |- ( ( U e. RR+ /\ z e. CC ) -> U e. RR+ )
i10::relogcl
s11:s9,i10:syl |- ( ( U e. RR+ /\ z e. CC ) -> ( log ` U ) e. RR )
