s13:s1:adantr |- ( ( U e. RR+ /\ z e. CC ) -> U e. RR+ )
s14:s13:rpcnd |- ( ( U e. RR+ /\ z e. CC ) -> U e. CC )
s15::simpr |- ( ( U e. RR+ /\ z e. CC ) -> z e. CC )
s16:s14,s15:cxpcld |- ( ( U e. RR+ /\ z e. CC ) -> ( U ^c z ) e. CC )
s17:s12,s16:mulcld |- ( ( U e. RR+ /\ z e. CC ) -> ( ( log ` U ) x. ( U ^c z ) ) e. CC )
s18::eqid |- ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) ) = ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) )
s19:s17,s18:fmptd |- ( U e. RR+ -> ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) ) : CC --> CC )
i20::fdm
s21:s19,i20:syl |- ( U e. RR+ -> dom ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) ) = CC )
s22:s8:dmeqd |- ( U e. RR+ -> dom ( CC _D ( z e. CC |-> ( U ^c z ) ) ) = dom ( z e. CC |-> ( ( log ` U ) x. ( U ^c z ) ) ) )
s23:s22,s21:eqtrd |- ( U e. RR+ -> dom ( CC _D ( z e. CC |-> ( U ^c z ) ) ) = CC )
s24:s23:eqcomd |- ( U e. RR+ -> CC = dom ( CC _D ( z e. CC |-> ( U ^c z ) ) ) )
s25:s24:eqimssd |- ( U e. RR+ -> CC C_ dom ( CC _D ( z e. CC |-> ( U ^c z ) ) ) )
qed:s6,s25:jca |- ( U e. RR+ -> ( ( z e. CC |-> ( U ^c z ) ) e. ( CC -cn-> CC ) /\ CC C_ dom ( CC _D ( z e. CC |-> ( U ^c z ) ) ) ) )
