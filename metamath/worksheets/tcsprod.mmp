$( <MM> <PROOF_ASST> THEOREM=tcsprod  LOC_AFTER=?

* The product of a subset of the entries of a word is a nonnegative integer.

s1::tcsfin |- ( ( E e. Word NN0 /\ S e. ~P ran E ) -> ( S e. Fin /\ S C_ NN0 ) )
s2:s1:simpld |- ( ( E e. Word NN0 /\ S e. ~P ran E ) -> S e. Fin )
s3:s1:simprd |- ( ( E e. Word NN0 /\ S e. ~P ran E ) -> S C_ NN0 )
s4:s3:adantr |- ( ( ( E e. Word NN0 /\ S e. ~P ran E ) /\ q e. S ) -> S C_ NN0 )
s5::simpr |- ( ( ( E e. Word NN0 /\ S e. ~P ran E ) /\ q e. S ) -> q e. S )
s6:s4,s5:sseldd |- ( ( ( E e. Word NN0 /\ S e. ~P ran E ) /\ q e. S ) -> q e. NN0 )
qed:s2,s6:fprodnn0cl |- ( ( E e. Word NN0 /\ S e. ~P ran E ) -> prod_ q e. S q e. NN0 )
$)
