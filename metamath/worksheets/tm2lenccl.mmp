$( <MM> <PROOF_ASST> THEOREM=tm2lenccl  LOC_AFTER=?

* A list of numbers on a stack is a word over ` Gamma' ` .

s1::tm2lencval |- ( L e. Word NN0 -> ( encList ` L ) = ( ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. L ) ) ++ <" 2 "> ) )
s2::encoutflatcl |- ( L e. Word NN0 -> ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. L ) ) e. Word Gamma' )
s3::gamma2 |- 2 e. Gamma'
s4:s3:a1i |- ( L e. Word NN0 -> 2 e. Gamma' )
i5::ccatws1cl
s6:s2,s4,i5:syl2anc |- ( L e. Word NN0 -> ( ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. L ) ) ++ <" 2 "> ) e. Word Gamma' )
qed:s1,s6:eqeltrd |- ( L e. Word NN0 -> ( encList ` L ) e. Word Gamma' )
$)
