$( <MM> <PROOF_ASST> THEOREM=nceilge  LOC_AFTER=?

* A real number is at most its natural ceiling (Lean: Nat.le_ceil).

s1::nceilval |- ( X e. RR -> ( Nceil ` X ) = if ( X <_ 0 , 0 , ( |^ ` X ) ) )
s2::simpr |- ( ( X e. RR /\ X <_ 0 ) -> X <_ 0 )
s3:s2:iftrued |- ( ( X e. RR /\ X <_ 0 ) -> if ( X <_ 0 , 0 , ( |^ ` X ) ) = 0 )
s4:s2,s3:breqtrrd |- ( ( X e. RR /\ X <_ 0 ) -> X <_ if ( X <_ 0 , 0 , ( |^ ` X ) ) )
s5::simpr |- ( ( X e. RR /\ -. X <_ 0 ) -> -. X <_ 0 )
s6:s5:iffalsed |- ( ( X e. RR /\ -. X <_ 0 ) -> if ( X <_ 0 , 0 , ( |^ ` X ) ) = ( |^ ` X ) )
s7::simpl |- ( ( X e. RR /\ -. X <_ 0 ) -> X e. RR )
i8::ceilge
s9:s7,i8:syl |- ( ( X e. RR /\ -. X <_ 0 ) -> X <_ ( |^ ` X ) )
s10:s9,s6:breqtrrd |- ( ( X e. RR /\ -. X <_ 0 ) -> X <_ if ( X <_ 0 , 0 , ( |^ ` X ) ) )
s11:s4,s10:pm2.61dan |- ( X e. RR -> X <_ if ( X <_ 0 , 0 , ( |^ ` X ) ) )
qed:s11,s1:breqtrrd |- ( X e. RR -> X <_ ( Nceil ` X ) )
