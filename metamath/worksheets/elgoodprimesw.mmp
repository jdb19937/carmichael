$( <MM> <PROOF_ASST> THEOREM=elgoodprimesw  LOC_AFTER=?

* Membership in the windowed reservoir (Lean: Finset.mem_filter).

s1::goodprimeswval |- ( ( Z e. NN0 /\ W e. NN0 /\ Y e. NN0 ) -> ( ( Z goodPrimesW W ) ` Y ) = { q e. ( 0 ... Z ) | ( q e. Prime /\ W < q /\ A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) ) } )
s2:s1:eleq2d |- ( ( Z e. NN0 /\ W e. NN0 /\ Y e. NN0 ) -> ( Q e. ( ( Z goodPrimesW W ) ` Y ) <-> Q e. { q e. ( 0 ... Z ) | ( q e. Prime /\ W < q /\ A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) ) } ) )
s3::id |- ( q = Q -> q = Q )
c1:s3:eleq1d |- ( q = Q -> ( q e. Prime <-> Q e. Prime ) )
c2:s3:breq2d |- ( q = Q -> ( W < q <-> W < Q ) )
c3:s3:oveq1d |- ( q = Q -> ( q - 1 ) = ( Q - 1 ) )
c4:c3:breq2d |- ( q = Q -> ( p || ( q - 1 ) <-> p || ( Q - 1 ) ) )
c5:c4:imbi1d |- ( q = Q -> ( ( p || ( q - 1 ) -> p <_ Y ) <-> ( p || ( Q - 1 ) -> p <_ Y ) ) )
c6:c5:ralbidv |- ( q = Q -> ( A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) <-> A. p e. Prime ( p || ( Q - 1 ) -> p <_ Y ) ) )
c7:c1,c2,c6:3anbi123d |- ( q = Q -> ( ( q e. Prime /\ W < q /\ A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) ) <-> ( Q e. Prime /\ W < Q /\ A. p e. Prime ( p || ( Q - 1 ) -> p <_ Y ) ) ) )
s4:c7:elrab |- ( Q e. { q e. ( 0 ... Z ) | ( q e. Prime /\ W < q /\ A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) ) } <-> ( Q e. ( 0 ... Z ) /\ ( Q e. Prime /\ W < Q /\ A. p e. Prime ( p || ( Q - 1 ) -> p <_ Y ) ) ) )
s5:s4:a1i |- ( ( Z e. NN0 /\ W e. NN0 /\ Y e. NN0 ) -> ( Q e. { q e. ( 0 ... Z ) | ( q e. Prime /\ W < q /\ A. p e. Prime ( p || ( q - 1 ) -> p <_ Y ) ) } <-> ( Q e. ( 0 ... Z ) /\ ( Q e. Prime /\ W < Q /\ A. p e. Prime ( p || ( Q - 1 ) -> p <_ Y ) ) ) ) )
qed:s2,s5:bitrd |- ( ( Z e. NN0 /\ W e. NN0 /\ Y e. NN0 ) -> ( Q e. ( ( Z goodPrimesW W ) ` Y ) <-> ( Q e. ( 0 ... Z ) /\ ( Q e. Prime /\ W < Q /\ A. p e. Prime ( p || ( Q - 1 ) -> p <_ Y ) ) ) ) )
