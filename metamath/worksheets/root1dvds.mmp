$( <MM> <PROOF_ASST> THEOREM=root1dvds  LOC_AFTER=?

* The powers of the root of unity depend only on the exponent mod N.

s1::simp1 |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> N e. NN )
s2::simp2 |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> A e. ZZ )
s3::simp3 |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> B e. ZZ )
i4::root1cl
s5:s1,i4:syl |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) e. CC /\ ( -u 1 ^c ( 2 / N ) ) =/= 0 ) )
s6:s5:simpld |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) e. CC )
s7:s5:simprd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) =/= 0 )
s8:s6,s7,s3,s2:expsubd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ ( A - B ) ) = ( ( ( -u 1 ^c ( 2 / N ) ) ^ A ) / ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) )
s9:s2,s3:zsubcld |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( A - B ) e. ZZ )
i10::root1eq1
s11:s1,s9,i10:syl2anc |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( -u 1 ^c ( 2 / N ) ) ^ ( A - B ) ) = 1 <-> N || ( A - B ) ) )
s12:s6,s7,s2:expclzd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) e. CC )
s13:s6,s7,s3:expclzd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ B ) e. CC )
s14:s6,s7,s3:expne0d |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ B ) =/= 0 )
i15::diveq1
s16:s12,s13,s14,i15:syl3anc |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( ( -u 1 ^c ( 2 / N ) ) ^ A ) / ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) = 1 <-> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) = ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) )
s17:s8:eqeq1d |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( -u 1 ^c ( 2 / N ) ) ^ ( A - B ) ) = 1 <-> ( ( ( -u 1 ^c ( 2 / N ) ) ^ A ) / ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) = 1 ) )
s18:s17,s16:bitrd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( -u 1 ^c ( 2 / N ) ) ^ ( A - B ) ) = 1 <-> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) = ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) )
s19:s11,s18:bitr3d |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( N || ( A - B ) <-> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) = ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) )
qed:s19:biimpd |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( N || ( A - B ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ A ) = ( ( -u 1 ^c ( 2 / N ) ) ^ B ) ) )
$)
