$( <MM> <PROOF_ASST> THEOREM=borrowcl  LOC_AFTER=?

* Closure of borrow: a Boolean.

s1::simp1 |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> A e. 2o )
s2::simp2 |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> B e. 2o )
s3::simp3 |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> C e. 2o )
s4::borrowval |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> ( ( A borrow B ) ` C ) = if ( ( ( -. A = 1o /\ ( B = 1o \/ C = 1o ) ) \/ ( B = 1o /\ C = 1o ) ) , 1o , (/) ) )
s5::1oel2o |- 1o e. 2o
s6:s5:a1i |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> 1o e. 2o )
s7::0el2o |- (/) e. 2o
s8:s7:a1i |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> (/) e. 2o )
s9:s6,s8:ifcld |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> if ( ( ( -. A = 1o /\ ( B = 1o \/ C = 1o ) ) \/ ( B = 1o /\ C = 1o ) ) , 1o , (/) ) e. 2o )
qed:s4,s9:eqeltrd |- ( ( A e. 2o /\ B e. 2o /\ C e. 2o ) -> ( ( A borrow B ) ` C ) e. 2o )
$)
