s12:s8,s10,i11:syl2anc |- ( ( X e. Word 2o /\ Y e. Word 2o ) -> ( ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) = 1o <-> ( toNat ` X ) = ( toNat ` Y ) ) )
s13::simpr |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ ( toNat ` X ) = ( toNat ` Y ) ) -> ( toNat ` X ) = ( toNat ` Y ) )
s14:s13:iftrued |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ ( toNat ` X ) = ( toNat ` Y ) ) -> if ( ( toNat ` X ) = ( toNat ` Y ) , 1o , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) = 1o )
s15:s12:adantr |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ ( toNat ` X ) = ( toNat ` Y ) ) -> ( ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) = 1o <-> ( toNat ` X ) = ( toNat ` Y ) ) )
s16:s13,s15:mpbird |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ ( toNat ` X ) = ( toNat ` Y ) ) -> ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) = 1o )
s17:s14,s16:eqtr4d |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ ( toNat ` X ) = ( toNat ` Y ) ) -> if ( ( toNat ` X ) = ( toNat ` Y ) , 1o , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) = ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) )
s18::simpr |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ -. ( toNat ` X ) = ( toNat ` Y ) ) -> -. ( toNat ` X ) = ( toNat ` Y ) )
s19:s18:iffalsed |- ( ( ( X e. Word 2o /\ Y e. Word 2o ) /\ -. ( toNat ` X ) = ( toNat ` Y ) ) -> if ( ( toNat ` X ) = ( toNat ` Y ) , 1o , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) = ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) )
s20:s17,s19:pm2.61dan |- ( ( X e. Word 2o /\ Y e. Word 2o ) -> if ( ( toNat ` X ) = ( toNat ` Y ) , 1o , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) = ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) )
qed:s6,s20:eqtrd |- ( ( X e. Word 2o /\ Y e. Word 2o ) -> ( ( X cmpBits Y ) ` 1o ) = ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) )
