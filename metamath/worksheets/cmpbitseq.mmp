i5::cmpbitsval
s6:s1,s2,s4,i5:syl3anc |- ( ( X e. Word 2o /\ Y e. Word 2o ) -> ( ( X cmpBits Y ) ` 1o ) = if ( ( toNat ` X ) = ( toNat ` Y ) , 1o , ( ( toNat ` X ) Ncmp ( toNat ` Y ) ) ) )
i7::tonatcl
s8:s1,i7:syl |- ( ( X e. Word 2o /\ Y e. Word 2o ) -> ( toNat ` X ) e. NN0 )
i9::tonatcl
