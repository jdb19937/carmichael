$( <MM> <PROOF_ASST> THEOREM=twinpz  LOC_AFTER=?

* Every prime divisor of the sifting product is at most the sifting bound.

s1::id |- ( Z e. NN0 -> Z e. NN0 )
i2::twinpp
s3:s1,i2:syl |- ( Z e. NN0 -> ( ( prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p e. NN /\ ( mmu ` prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p ) =/= 0 ) /\ { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p } = { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } ) )
s4:s3:simprd |- ( Z e. NN0 -> { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p } = { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } )
s5::simpr |- ( ( Z e. NN0 /\ y e. Prime ) -> y e. Prime )
s6::breq1 |- ( q = y -> ( q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p <-> y || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p ) )
s7:s6:elrab |- ( y e. { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p } <-> ( y e. Prime /\ y || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p ) )
