s13:s4:adantr |- ( ( Z e. NN0 /\ y e. Prime ) -> { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p } = { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } )
s14:s13:adantr |- ( ( ( Z e. NN0 /\ y e. Prime ) /\ y || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p ) -> { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } p } = { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || ( 2 x. M ) ) } )
