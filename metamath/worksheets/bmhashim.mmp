$( <MM> <PROOF_ASST> THEOREM=bmhashim  LOC_AFTER=?

* The image of a finite set under a function has at most as many elements (~ fores , ~ fodomfi , ~ hashdomi ).

s1::simp1 |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> F Fn A )
s2::simp2 |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> B e. Fin )
s3::simp3 |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> B C_ A )
s4:s1:fnfund |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> Fun F )
i5::fndm
s6:s1,i5:syl |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> dom F = A )
s7:s3,s6:sseqtrrd |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> B C_ dom F )
i8::fores
s9:s4,s7,i8:syl2anc |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> ( F |` B ) : B -onto-> ( F " B ) )
i10::fodomfi
s11:s2,s9,i10:syl2anc |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> ( F " B ) ~<_ B )
i12::hashdomi
qed:s11,i12:syl |- ( ( F Fn A /\ B e. Fin /\ B C_ A ) -> ( # ` ( F " B ) ) <_ ( # ` B ) )
$)
