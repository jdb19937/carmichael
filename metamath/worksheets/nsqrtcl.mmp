$( <MM> <PROOF_ASST> THEOREM=nsqrtcl  LOC_AFTER=?

* Closure of the integer square root (Lean: Nat.sqrt a : Nat).

s1::id |- ( A e. NN0 -> A e. NN0 )
s2:s1:nn0red |- ( A e. NN0 -> A e. RR )
s3:s1:nn0ge0d |- ( A e. NN0 -> 0 <_ A )
i4::resqrtcl
s5:s2,s3,i4:syl2anc |- ( A e. NN0 -> ( sqrt ` A ) e. RR )
i6::nfloorcl
qed:s5,i6:syl |- ( A e. NN0 -> ( Nfloor ` ( sqrt ` A ) ) e. NN0 )
$)
