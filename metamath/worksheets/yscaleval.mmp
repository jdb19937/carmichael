$( <MM> <PROOF_ASST> THEOREM=yscaleval  LOC_AFTER=?

* Value of yscale: the natural ceiling of z ^ ( 2 / 3 ) (Lean: yscale).

s1::simpl |- ( ( c = C /\ n = N ) -> c = C )
s2::simpr |- ( ( c = C /\ n = N ) -> n = N )
c1:s1,s2:oveq12d |- ( ( c = C /\ n = N ) -> ( c zscale n ) = ( C zscale N ) )
c2:c1:oveq1d |- ( ( c = C /\ n = N ) -> ( ( c zscale n ) ^c ( 2 / 3 ) ) = ( ( C zscale N ) ^c ( 2 / 3 ) ) )
c3:c2:fveq2d |- ( ( c = C /\ n = N ) -> ( Nceil ` ( ( c zscale n ) ^c ( 2 / 3 ) ) ) = ( Nceil ` ( ( C zscale N ) ^c ( 2 / 3 ) ) ) )
s3::df-yscale |- yscale = ( c e. RR , n e. NN0 |-> ( Nceil ` ( ( c zscale n ) ^c ( 2 / 3 ) ) ) )
s4::fvex |- ( Nceil ` ( ( C zscale N ) ^c ( 2 / 3 ) ) ) e. _V
qed:c3,s3,s4:ovmpoa |- ( ( C e. RR /\ N e. NN0 ) -> ( C yscale N ) = ( Nceil ` ( ( C zscale N ) ^c ( 2 / 3 ) ) ) )
$)
