$( <MM> <PROOF_ASST> THEOREM=subborrowpad2  LOC_AFTER=?

* Padding the first operand of subBorrow with a false letter does not change the result.

s1::simp1 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> X e. Word 2o )
s2::simp2 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> Y e. Word 2o )
s3::simp3 |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> C e. 2o )
i4::subborrowval
s5:s1,s2,s3,i4:syl3anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBorrow Y ) ` C ) = if ( ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) )
s6::0el2o |- (/) e. 2o
s7:s6:a1i |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> (/) e. 2o )
i8::s1cl
s9:s7,i8:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> <" (/) "> e. Word 2o )
i10::ccatcl
s11:s1,s9,i10:syl2anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( X ++ <" (/) "> ) e. Word 2o )
i12::subborrowval
s13:s11,s2,s3,i12:syl3anc |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( ( X ++ <" (/) "> ) subBorrow Y ) ` C ) = if ( ( toNat ` ( X ++ <" (/) "> ) ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) )
i14::tonatpad
s15:s1,i14:syl |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( toNat ` ( X ++ <" (/) "> ) ) = ( toNat ` X ) )
c1:s15:breq1d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( toNat ` ( X ++ <" (/) "> ) ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) <-> ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) ) )
c2:c1:ifbid |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> if ( ( toNat ` ( X ++ <" (/) "> ) ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) = if ( ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) )
s16:s13,c2:eqtrd |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( ( X ++ <" (/) "> ) subBorrow Y ) ` C ) = if ( ( toNat ` X ) < ( ( toNat ` Y ) + ( bToNat ` C ) ) , 1o , (/) ) )
qed:s5,s16:eqtr4d |- ( ( X e. Word 2o /\ Y e. Word 2o /\ C e. 2o ) -> ( ( X subBorrow Y ) ` C ) = ( ( ( X ++ <" (/) "> ) subBorrow Y ) ` C ) )
$)
