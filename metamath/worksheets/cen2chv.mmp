$( <MM> <PROOF_ASST> THEOREM=cen2chv  LOC_AFTER=?

* A Dirichlet character value at an integer is a complex number of absolute value at most 1 (Lean ` DirichletCharacter.norm_le_one ` ).

s1::simpl |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) )
s2:s1:simpld |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> N e. NN )
s3:s1:simprd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> X e. ( Base ` ( DChr ` N ) ) )
s4::simpr |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> A e. ZZ )
s5::eqid |- ( DChr ` N ) = ( DChr ` N )
s6::eqid |- ( Base ` ( DChr ` N ) ) = ( Base ` ( DChr ` N ) )
s7::eqid |- ( Z/nZ ` N ) = ( Z/nZ ` N )
s8::eqid |- ( Base ` ( Z/nZ ` N ) ) = ( Base ` ( Z/nZ ` N ) )
s9::eqid |- ( ZRHom ` ( Z/nZ ` N ) ) = ( ZRHom ` ( Z/nZ ` N ) )
s10:s7,s8,s9:znzrhfo |- ( N e. NN0 -> ( ZRHom ` ( Z/nZ ` N ) ) : ZZ -onto-> ( Base ` ( Z/nZ ` N ) ) )
s11:s2:nnnn0d |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> N e. NN0 )
s12:s11,s10:syl |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ZRHom ` ( Z/nZ ` N ) ) : ZZ -onto-> ( Base ` ( Z/nZ ` N ) ) )
i13::fof
s14:s12,i13:syl |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ZRHom ` ( Z/nZ ` N ) ) : ZZ --> ( Base ` ( Z/nZ ` N ) ) )
s15:s14,s4:ffvelcdmd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) e. ( Base ` ( Z/nZ ` N ) ) )
s16:s5,s7,s6,s8,s3:dchrf |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> X : ( Base ` ( Z/nZ ` N ) ) --> CC )
s17:s16,s15:ffvelcdmd |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) e. CC )
s18:s5,s6,s7,s8,s3,s15:dchrabs2 |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( abs ` ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) ) <_ 1 )
qed:s17,s18:jca |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) -> ( ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) e. CC /\ ( abs ` ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) ) <_ 1 ) )
