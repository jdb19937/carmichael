$( <MM> <PROOF_ASST> THEOREM=vprmc  LOC_AFTER=?

* Instantiation of the density condition at a prime divisor of the sifting product.

s1::simpl |- ( ( A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) /\ ( Q e. Prime /\ Q || P ) ) -> A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) )
s2::simprl |- ( ( A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) /\ ( Q e. Prime /\ Q || P ) ) -> Q e. Prime )
s3::simprr |- ( ( A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) /\ ( Q e. Prime /\ Q || P ) ) -> Q || P )
s4::breq1 |- ( s = Q -> ( s || P <-> Q || P ) )
s5::fveq2 |- ( s = Q -> ( V ` s ) = ( V ` Q ) )
s6:s5:breq2d |- ( s = Q -> ( 0 < ( V ` s ) <-> 0 < ( V ` Q ) ) )
s7:s5:breq1d |- ( s = Q -> ( ( V ` s ) < 1 <-> ( V ` Q ) < 1 ) )
s8:s6,s7:anbi12d |- ( s = Q -> ( ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) <-> ( 0 < ( V ` Q ) /\ ( V ` Q ) < 1 ) ) )
s9:s4,s8:imbi12d |- ( s = Q -> ( ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) <-> ( Q || P -> ( 0 < ( V ` Q ) /\ ( V ` Q ) < 1 ) ) ) )
s10:s9,s1,s2:rspcdva |- ( ( A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) /\ ( Q e. Prime /\ Q || P ) ) -> ( Q || P -> ( 0 < ( V ` Q ) /\ ( V ` Q ) < 1 ) ) )
qed:s10,s3:mpd |- ( ( A. s e. Prime ( s || P -> ( 0 < ( V ` s ) /\ ( V ` s ) < 1 ) ) /\ ( Q e. Prime /\ Q || P ) ) -> ( 0 < ( V ` Q ) /\ ( V ` Q ) < 1 ) )
