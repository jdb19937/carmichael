$( <MM> <PROOF_ASST> THEOREM=holcrect  LOC_AFTER=?

* Holomorphy on an open domain gives the rectangle form of holomorphy for any rectangle inside it.

s1::simpl |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) )
s2::simpr |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> ( A crect B ) C_ D )
i3::simpl
s4:s1,i3:syl |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> F e. ( D -cn-> CC ) )
i5::simpr
s6:s1,i5:syl |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> D C_ dom ( CC _D F ) )
s7:s2,s6:sstrd |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> ( A crect B ) C_ dom ( CC _D F ) )
qed:s4,s7:jca |- ( ( ( F e. ( D -cn-> CC ) /\ D C_ dom ( CC _D F ) ) /\ ( A crect B ) C_ D ) -> ( F e. ( D -cn-> CC ) /\ ( A crect B ) C_ dom ( CC _D F ) ) )
$)
