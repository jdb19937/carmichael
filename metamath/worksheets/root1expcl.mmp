$( <MM> <PROOF_ASST> THEOREM=root1expcl  LOC_AFTER=?

* Integer powers of the root of unity are complex numbers.

s1::simpl |- ( ( N e. NN /\ K e. ZZ ) -> N e. NN )
i2::root1cl
s3:s1,i2:syl |- ( ( N e. NN /\ K e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) e. CC /\ ( -u 1 ^c ( 2 / N ) ) =/= 0 ) )
s4:s3:simpld |- ( ( N e. NN /\ K e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) e. CC )
s5:s3:simprd |- ( ( N e. NN /\ K e. ZZ ) -> ( -u 1 ^c ( 2 / N ) ) =/= 0 )
s6::simpr |- ( ( N e. NN /\ K e. ZZ ) -> K e. ZZ )
qed:s4,s5,s6:expclzd |- ( ( N e. NN /\ K e. ZZ ) -> ( ( -u 1 ^c ( 2 / N ) ) ^ K ) e. CC )
$)
