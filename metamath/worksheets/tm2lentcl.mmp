$( <MM> <PROOF_ASST> THEOREM=tm2lentcl  LOC_AFTER=?

* The entries of a list of bit words form a word over ` Gamma' ` .

s1::tm2lentval |- ( L e. Word Word ( { 1 } X. 2o ) -> ( entries ` L ) = ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) ) )
s2::id |- ( L e. Word Word ( { 1 } X. 2o ) -> L e. Word Word ( { 1 } X. 2o ) )
s3::tm2lentpf |- ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) : Word ( { 1 } X. 2o ) --> Word Gamma'
s4:s3:a1i |- ( L e. Word Word ( { 1 } X. 2o ) -> ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) : Word ( { 1 } X. 2o ) --> Word Gamma' )
i5::wrdco
s6:s2,s4,i5:syl2anc |- ( L e. Word Word ( { 1 } X. 2o ) -> ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) e. Word Word Gamma' )
i7::gsumgamcl
s8:s6,i7:syl |- ( L e. Word Word ( { 1 } X. 2o ) -> ( ( freeMnd ` Gamma' ) gsum ( ( w e. Word ( { 1 } X. 2o ) |-> ( w ++ <" 4 "> ) ) o. L ) ) e. Word Gamma' )
qed:s1,s8:eqeltrd |- ( L e. Word Word ( { 1 } X. 2o ) -> ( entries ` L ) e. Word Gamma' )
$)
