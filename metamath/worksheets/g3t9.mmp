$( <MM> <PROOF_ASST> THEOREM=g3t9  LOC_AFTER=?

* A finite sum whose body tools/cl.py has no rule for: the body closures are handed to tools/fsum.py as plain worksheet step names, one already under the body antecedent and one under the antecedent above it, which the module lifts with ` adantr ` .

s1::simpll |- ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) -> N e. NN )
s2::simplr |- ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) -> C e. CC )
s3::simpr |- ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) -> F : ( 1 ... N ) --> CC )
s4:s3:adantr |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> F : ( 1 ... N ) --> CC )
s5::simpr |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> k e. ( 1 ... N ) )
i6::ffvelcdm
s7:s4,s5,i6:syl2anc |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> ( F ` k ) e. CC )
s8::fzfid |- ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) -> ( 1 ... N ) e. Fin )
s9::simpr |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> k e. ( 1 ... N ) )
i10::elfznn
s11:s9,i10:syl |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> k e. NN )
s12:s2:adantr |- ( ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) /\ k e. ( 1 ... N ) ) -> C e. CC )
qed:s8,s7,s12:fsumadd |- ( ( ( N e. NN /\ C e. CC ) /\ F : ( 1 ... N ) --> CC ) -> sum_ k e. ( 1 ... N ) ( ( F ` k ) + C ) = ( sum_ k e. ( 1 ... N ) ( F ` k ) + sum_ k e. ( 1 ... N ) C ) )
$)
