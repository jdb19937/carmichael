$( <MM> <PROOF_ASST> THEOREM=tsqtrm  LOC_AFTER=?

* Three to the number of prime factors over the totient, as a product.

s1::simpl |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> D e. NN )
i2::prmdvdsfi
s3:s1,i2:syl |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> { p e. Prime | p || D } e. Fin )
s4::cbvrabv |- { p e. Prime | p || D } = { q e. Prime | q || D }
s5:s4:a1i |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> { p e. Prime | p || D } = { q e. Prime | q || D } )
s6:s5,s3:eqeltrrd |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> { q e. Prime | q || D } e. Fin )
s7::simpr |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. { q e. Prime | q || D } )
i8::elrabi
s9:s7,i8:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. Prime )
i10::prmnn
s11:s9,i10:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. NN )
s12:s11:nncnd |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. CC )
s13:s11:nnred |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. RR )
s14:s11:nnne0d |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p =/= 0 )
i15::prmuz2
s16:s9,i15:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. ( ZZ>= ` 2 ) )
i17::uz2m1rp
s18:s16,i17:syl |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> ( p x. ( p - 1 ) ) e. RR+ )
s19::1cnd |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 1 e. CC )
s20::1red |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 1 e. RR )
s21:s12,s19:subcld |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> ( p - 1 ) e. CC )
s22:s13,s20:resubcld |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> ( p - 1 ) e. RR )
s23:s18:rpne0d |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> ( p x. ( p - 1 ) ) =/= 0 )
s24:s12,s21,s23:mulne0bbd |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> ( p - 1 ) =/= 0 )
s25:s11:nnrpd |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> p e. RR+ )
s26::3cn |- 3 e. CC
s27:s26:a1i |- ( ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ p e. { q e. Prime | q || D } ) -> 3 e. CC )
s28:s6,s27,s21,s24:fproddiv |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } ( 3 / ( p - 1 ) ) = ( prod_ p e. { q e. Prime | q || D } 3 / prod_ p e. { q e. Prime | q || D } ( p - 1 ) ) )
s29::3cn |- 3 e. CC
s30:s29:a1i |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> 3 e. CC )
i31::fprodconst
s32:s6,s30,i31:syl2anc |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } 3 = ( 3 ^ ( # ` { q e. Prime | q || D } ) ) )
s33::phisqf |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> ( phi ` D ) = prod_ p e. { q e. Prime | q || D } ( p - 1 ) )
s34:s33:eqcomd |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } ( p - 1 ) = ( phi ` D ) )
s35:s32,s34:oveq12d |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> ( prod_ p e. { q e. Prime | q || D } 3 / prod_ p e. { q e. Prime | q || D } ( p - 1 ) ) = ( ( 3 ^ ( # ` { q e. Prime | q || D } ) ) / ( phi ` D ) ) )
qed:s28,s35:eqtrd |- ( ( D e. NN /\ ( mmu ` D ) =/= 0 ) -> prod_ p e. { q e. Prime | q || D } ( 3 / ( p - 1 ) ) = ( ( 3 ^ ( # ` { q e. Prime | q || D } ) ) / ( phi ` D ) ) )
$)
