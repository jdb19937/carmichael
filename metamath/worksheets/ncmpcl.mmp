$( <MM> <PROOF_ASST> THEOREM=ncmpcl  LOC_AFTER=?

* Closure of Ncmp: an ordering.

s1::ncmpval |- ( ( A e. NN0 /\ B e. NN0 ) -> ( A Ncmp B ) = if ( A = B , 1o , if ( A < B , (/) , 2o ) ) )
s2::simpl |- ( ( A e. NN0 /\ B e. NN0 ) -> A e. NN0 )
s3::simpr |- ( ( A e. NN0 /\ B e. NN0 ) -> B e. NN0 )
s4::bw1oel3o |- 1o e. 3o
s5:s4:a1i |- ( ( A e. NN0 /\ B e. NN0 ) -> 1o e. 3o )
s6::bw0el3o |- (/) e. 3o
s7:s6:a1i |- ( ( A e. NN0 /\ B e. NN0 ) -> (/) e. 3o )
s8::bw2oel3o |- 2o e. 3o
s9:s8:a1i |- ( ( A e. NN0 /\ B e. NN0 ) -> 2o e. 3o )
s10:s7,s9:ifcld |- ( ( A e. NN0 /\ B e. NN0 ) -> if ( A < B , (/) , 2o ) e. 3o )
s11:s5,s10:ifcld |- ( ( A e. NN0 /\ B e. NN0 ) -> if ( A = B , 1o , if ( A < B , (/) , 2o ) ) e. 3o )
qed:s1,s11:eqeltrd |- ( ( A e. NN0 /\ B e. NN0 ) -> ( A Ncmp B ) e. 3o )
$)
