$( <MM> <PROOF_ASST> THEOREM=tm2lbitf  LOC_AFTER=?

* The binary encoding of a number is a word of bit letters.

s1::df-encnatgam |- encNatGam = ( n e. NN0 |-> ( inclBool o. ( encodeNat ` n ) ) )
s2::encnatf |- encodeNat : NN0 --> Word 2o
s3:s2:a1i |- ( n e. NN0 -> encodeNat : NN0 --> Word 2o )
s4::id |- ( n e. NN0 -> n e. NN0 )
i5::ffvelcdm
s6:s3,s4,i5:syl2anc |- ( n e. NN0 -> ( encodeNat ` n ) e. Word 2o )
s7::tm2linclf |- inclBool : 2o --> ( { 1 } X. 2o )
s8:s7:a1i |- ( n e. NN0 -> inclBool : 2o --> ( { 1 } X. 2o ) )
i9::wrdco
s10:s6,s8,i9:syl2anc |- ( n e. NN0 -> ( inclBool o. ( encodeNat ` n ) ) e. Word ( { 1 } X. 2o ) )
qed:s1,s10:fmpti |- encNatGam : NN0 --> Word ( { 1 } X. 2o )
