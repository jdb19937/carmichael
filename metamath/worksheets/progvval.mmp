$( <MM> <PROOF_ASST> THEOREM=progvval  LOC_AFTER=?

* The density of the progression sieve at a positive integer is the product of the reciprocals of its prime divisors.

s1::id |- ( L e. NN -> L e. NN )
i2::pffinq
s3:s1,i2:syl |- ( L e. NN -> { q e. Prime | q || L } e. Fin )
s4::breq1 |- ( q = g -> ( q || L <-> g || L ) )
s5:s4:cbvrabv |- { q e. Prime | q || L } = { g e. Prime | g || L }
s6:s5:a1i |- ( L e. NN -> { q e. Prime | q || L } = { g e. Prime | g || L } )
s7:s6,s3:eqeltrrd |- ( L e. NN -> { g e. Prime | g || L } e. Fin )
s8::simpr |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> f e. { g e. Prime | g || L } )
i9::elrabi
s10:s8,i9:syl |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> f e. Prime )
i11::prmnn
s12:s10,i11:syl |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> f e. NN )
i13::nnrp
s14:s12,i13:syl |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> f e. RR+ )
s15:s14:rpreccld |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> ( 1 / f ) e. RR+ )
s16:s15:rpcnd |- ( ( L e. NN /\ f e. { g e. Prime | g || L } ) -> ( 1 / f ) e. CC )
s17:s7,s16:fprodcl |- ( L e. NN -> prod_ f e. { g e. Prime | g || L } ( 1 / f ) e. CC )
s18:s17:elexd |- ( L e. NN -> prod_ f e. { g e. Prime | g || L } ( 1 / f ) e. _V )
s19::breq2 |- ( t = L -> ( g || t <-> g || L ) )
s20:s19:rabbidv |- ( t = L -> { g e. Prime | g || t } = { g e. Prime | g || L } )
s21:s20:prodeq1d |- ( t = L -> prod_ f e. { g e. Prime | g || t } ( 1 / f ) = prod_ f e. { g e. Prime | g || L } ( 1 / f ) )
s22::eqid |- ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) = ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) )
s23:s21,s22:fvmptg |- ( ( L e. NN /\ prod_ f e. { g e. Prime | g || L } ( 1 / f ) e. _V ) -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` L ) = prod_ f e. { g e. Prime | g || L } ( 1 / f ) )
qed:s1,s18,s23:syl2anc |- ( L e. NN -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` L ) = prod_ f e. { g e. Prime | g || L } ( 1 / f ) )
$)
