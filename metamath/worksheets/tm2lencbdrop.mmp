$( <MM> <PROOF_ASST> THEOREM=tm2lencbdrop  LOC_AFTER=?

* The list segment from the ` J ` -th entry on: the ` J ` -th entry, a comma, and the segment after it.  Lean: ` List.drop_eq_getElem_cons ` with ` encListB_cons ` , the shape the entry loop reads.

s1::simpl |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> L e. Word Word ( { 1 } X. 2o ) )
s2::simpr |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> J e. ( 0 ..^ ( # ` L ) ) )
i3::tm2ldrop
s4:s1,s2,i3:syl2anc |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( L substr <. J , ( # ` L ) >. ) = ( <" ( L ` J ) "> ++ ( L substr <. ( J + 1 ) , ( # ` L ) >. ) ) )
s5:s4:fveq2d |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( encListB ` ( L substr <. J , ( # ` L ) >. ) ) = ( encListB ` ( <" ( L ` J ) "> ++ ( L substr <. ( J + 1 ) , ( # ` L ) >. ) ) ) )
i6::wrdsymbcl
s7:s1,s2,i6:syl2anc |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( L ` J ) e. Word ( { 1 } X. 2o ) )
i8::swrdcl
s9:s1,i8:syl |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( L substr <. ( J + 1 ) , ( # ` L ) >. ) e. Word Word ( { 1 } X. 2o ) )
i10::tm2lencbcons
s11:s7,s9,i10:syl2anc |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( encListB ` ( <" ( L ` J ) "> ++ ( L substr <. ( J + 1 ) , ( # ` L ) >. ) ) ) = ( ( L ` J ) ++ ( <" 4 "> ++ ( encListB ` ( L substr <. ( J + 1 ) , ( # ` L ) >. ) ) ) ) )
qed:s5,s11:eqtrd |- ( ( L e. Word Word ( { 1 } X. 2o ) /\ J e. ( 0 ..^ ( # ` L ) ) ) -> ( encListB ` ( L substr <. J , ( # ` L ) >. ) ) = ( ( L ` J ) ++ ( <" 4 "> ++ ( encListB ` ( L substr <. ( J + 1 ) , ( # ` L ) >. ) ) ) ) )
$)
