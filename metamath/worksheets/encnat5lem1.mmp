$( <MM> <PROOF_ASST> THEOREM=encnat5lem1  LOC_AFTER=?

* Lemma for the example: the integer part of the binary logarithm of 5 is 2.

s1::2nn0 |- 2 e. NN0
s2::sq2 |- ( 2 ^ 2 ) = 4
s3::2p1e3 |- ( 2 + 1 ) = 3
s4:s3:oveq2i |- ( 2 ^ ( 2 + 1 ) ) = ( 2 ^ 3 )
s5::cu2 |- ( 2 ^ 3 ) = 8
s6:s4,s5:eqtri |- ( 2 ^ ( 2 + 1 ) ) = 8
s7:s2,s6:oveq12i |- ( ( 2 ^ 2 ) ..^ ( 2 ^ ( 2 + 1 ) ) ) = ( 4 ..^ 8 )
s8::5nn0 |- 5 e. NN0
s9:s8:nn0zi |- 5 e. ZZ
s10::4z |- 4 e. ZZ
s11::8nn0 |- 8 e. NN0
s12:s11:nn0zi |- 8 e. ZZ
i13::elfzo
s14:s9,s10,s12,i13:mp3an |- ( 5 e. ( 4 ..^ 8 ) <-> ( 4 <_ 5 /\ 5 < 8 ) )
s15::4re |- 4 e. RR
s16::5re |- 5 e. RR
s17::4lt5 |- 4 < 5
s18:s15,s16:ltlei |- ( 4 < 5 -> 4 <_ 5 )
s19:s17,s18:ax-mp |- 4 <_ 5
s20::5lt8 |- 5 < 8
s21:s19,s20,s14:mpbir2an |- 5 e. ( 4 ..^ 8 )
s22:s21,s7:eleqtrri |- 5 e. ( ( 2 ^ 2 ) ..^ ( 2 ^ ( 2 + 1 ) ) )
i23::fllog2
qed:s1,s22,i23:mp2an |- ( |_ ` ( 2 logb 5 ) ) = 2
$)
