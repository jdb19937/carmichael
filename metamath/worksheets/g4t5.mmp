$( <MM> <PROOF_ASST> THEOREM=g4t5  LOC_AFTER=?

* A double sum as one sum over the cartesian product, through tools/fsum.py and ` fsumxp ` : the substitution hypothesis comes from ` op1std ` , ` op2ndd ` and the congruence generator.

s1::simpll |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) -> A e. Fin )
s2::simplr |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) -> B e. Fin )
s3::simprl |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) -> G : A --> CC )
s4::simprr |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) -> H : B --> CC )
s5:s3:adantr |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> G : A --> CC )
s6::simprl |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> j e. A )
s7:s5,s6:ffvelcdmd |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> ( G ` j ) e. CC )
s8:s4:adantr |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> H : B --> CC )
s9::simprr |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> k e. B )
s10:s8,s9:ffvelcdmd |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> ( H ` k ) e. CC )
s11:s7,s10:mulcld |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> ( ( G ` j ) x. ( H ` k ) ) e. CC )
s12::vex |- j e. _V
s13::vex |- k e. _V
s14:s12,s13:op1std |- ( z = <. j , k >. -> ( 1st ` z ) = j )
s15:s12,s13:op2ndd |- ( z = <. j , k >. -> ( 2nd ` z ) = k )
s16:s14:eqcomd |- ( z = <. j , k >. -> j = ( 1st ` z ) )
s17:s15:eqcomd |- ( z = <. j , k >. -> k = ( 2nd ` z ) )
x1:s16:fveq2d |- ( z = <. j , k >. -> ( G ` j ) = ( G ` ( 1st ` z ) ) )
x2:s17:fveq2d |- ( z = <. j , k >. -> ( H ` k ) = ( H ` ( 2nd ` z ) ) )
x3:x1,x2:oveq12d |- ( z = <. j , k >. -> ( ( G ` j ) x. ( H ` k ) ) = ( ( G ` ( 1st ` z ) ) x. ( H ` ( 2nd ` z ) ) ) )
s18:x3:eqcomd |- ( z = <. j , k >. -> ( ( G ` ( 1st ` z ) ) x. ( H ` ( 2nd ` z ) ) ) = ( ( G ` j ) x. ( H ` k ) ) )
s19::simprl |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> j e. A )
s20::simprr |- ( ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) /\ ( j e. A /\ k e. B ) ) -> k e. B )
qed:s18,s1,s2,s11:fsumxp |- ( ( ( A e. Fin /\ B e. Fin ) /\ ( G : A --> CC /\ H : B --> CC ) ) -> sum_ j e. A sum_ k e. B ( ( G ` j ) x. ( H ` k ) ) = sum_ z e. ( A X. B ) ( ( G ` ( 1st ` z ) ) x. ( H ` ( 2nd ` z ) ) ) )
