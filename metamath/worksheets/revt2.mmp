$( <MM> <PROOF_ASST> THEOREM=revt2  LOC_AFTER=?

* The internal states of the reverse machine.

s1::id |- ( A e. V -> A e. V )
s2::opex |- <. { <. (/) , A >. , <. 1o , A >. } , 1o >. e. _V
s3:s2:a1i |- ( A e. V -> <. { <. (/) , A >. , <. 1o , A >. } , 1o >. e. _V )
s4::1oex |- 1o e. _V
s5:s4:a1i |- ( A e. V -> 1o e. _V )
i6::djuex
s7:s1,s5,i6:syl2anc |- ( A e. V -> ( A |_| 1o ) e. _V )
i8::op2ndg
qed:s3,s7,i8:syl2anc |- ( A e. V -> ( 2nd ` <. <. { <. (/) , A >. , <. 1o , A >. } , 1o >. , ( A |_| 1o ) >. ) = ( A |_| 1o ) )
$)
