s8::eqid |- ( Z/nZ ` Q ) = ( Z/nZ ` Q )
s9::eqid |- ( Base ` ( DChr ` Q ) ) = ( Base ` ( DChr ` Q ) )
s10::eqid |- ( ZRHom ` ( Z/nZ ` Q ) ) = ( ZRHom ` ( Z/nZ ` Q ) )
s11::simpl2 |- ( ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) /\ n e. ( 1 ... ( |_ ` Y ) ) ) -> X e. ( Base ` ( DChr ` Q ) ) )
s12:s7,s8,s9,s10,s11,s6:dchrzrhcl |- ( ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) /\ n e. ( 1 ... ( |_ ` Y ) ) ) -> ( X ` ( ( ZRHom ` ( Z/nZ ` Q ) ) ` n ) ) e. CC )
i13::vmacl
s14:s5,i13:syl |- ( ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) /\ n e. ( 1 ... ( |_ ` Y ) ) ) -> ( Lam ` n ) e. RR )
s15:s14:recnd |- ( ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) /\ n e. ( 1 ... ( |_ ` Y ) ) ) -> ( Lam ` n ) e. CC )
s16:s12,s15:mulcld |- ( ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) /\ n e. ( 1 ... ( |_ ` Y ) ) ) -> ( ( X ` ( ( ZRHom ` ( Z/nZ ` Q ) ) ` n ) ) x. ( Lam ` n ) ) e. CC )
s17:s2,s16:fsumcl |- ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) -> sum_ n e. ( 1 ... ( |_ ` Y ) ) ( ( X ` ( ( ZRHom ` ( Z/nZ ` Q ) ) ` n ) ) x. ( Lam ` n ) ) e. CC )
qed:s1,s17:eqeltrd |- ( ( Q e. NN /\ X e. ( Base ` ( DChr ` Q ) ) /\ Y e. RR ) -> ( X ( psiChar ` Q ) Y ) e. CC )
