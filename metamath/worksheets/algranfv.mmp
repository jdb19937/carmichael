$( <MM> <PROOF_ASST> THEOREM=algranfv  LOC_AFTER=?

* An indexed letter is an entry of the word.

s1::simpl |- ( ( W e. Word S /\ I e. ( 0 ..^ ( # ` W ) ) ) -> W e. Word S )
s2::simpr |- ( ( W e. Word S /\ I e. ( 0 ..^ ( # ` W ) ) ) -> I e. ( 0 ..^ ( # ` W ) ) )
i3::wrdfn
s4:s1,i3:syl |- ( ( W e. Word S /\ I e. ( 0 ..^ ( # ` W ) ) ) -> W Fn ( 0 ..^ ( # ` W ) ) )
i5::fnfvelrn
qed:s4,s2,i5:syl2anc |- ( ( W e. Word S /\ I e. ( 0 ..^ ( # ` W ) ) ) -> ( W ` I ) e. ran W )
$)
