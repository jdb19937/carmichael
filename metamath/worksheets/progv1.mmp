$( <MM> <PROOF_ASST> THEOREM=progv1  LOC_AFTER=?

* The density of the progression sieve is 1 at 1.

s1::1nn |- 1 e. NN
s2:s1:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> 1 e. NN )
i3::progvval
s4:s2,i3:syl |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` 1 ) = prod_ f e. { g e. Prime | g || 1 } ( 1 / f ) )
s5::nprmdvds1 |- ( g e. Prime -> -. g || 1 )
s6:s5:rgen |- A. g e. Prime -. g || 1
s7::rabeq0 |- ( { g e. Prime | g || 1 } = (/) <-> A. g e. Prime -. g || 1 )
s8:s7,s6:mpbir |- { g e. Prime | g || 1 } = (/)
s9:s8:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> { g e. Prime | g || 1 } = (/) )
s10:s9:prodeq1d |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> prod_ f e. { g e. Prime | g || 1 } ( 1 / f ) = prod_ f e. (/) ( 1 / f ) )
s11::prod0 |- prod_ f e. (/) ( 1 / f ) = 1
s12:s11:a1i |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> prod_ f e. (/) ( 1 / f ) = 1 )
s13:s10,s12:eqtrd |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> prod_ f e. { g e. Prime | g || 1 } ( 1 / f ) = 1 )
qed:s4,s13:eqtrd |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 1 / f ) ) ` 1 ) = 1 )
$)
