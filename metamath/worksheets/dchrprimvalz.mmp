s11:s6,s2,s8:3jca |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd N ) = 1 ) -> ( ( N DChrCond X ) e. NN /\ N e. NN /\ ( N DChrCond X ) || N ) )
s12:s11,s10:jca |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd N ) = 1 ) -> ( ( ( N DChrCond X ) e. NN /\ N e. NN /\ ( N DChrCond X ) || N ) /\ ( N DChrPrim X ) e. ( Base ` ( DChr ` ( N DChrCond X ) ) ) ) )
i13::dchrindval1
s14:s12,s3,s4,i13:syl3anc |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd N ) = 1 ) -> ( ( ( ( N DChrCond X ) DChrInd N ) ` ( N DChrPrim X ) ) ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) = ( ( N DChrPrim X ) ` ( ( ZRHom ` ( Z/nZ ` ( N DChrCond X ) ) ) ` A ) ) )
i15::dchrprimind
