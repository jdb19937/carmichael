s3::simp2 |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd N ) = 1 ) -> A e. ZZ )
s4::simp3 |- ( ( ( N e. NN /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd N ) = 1 ) -> ( A gcd N ) = 1 )
i5::dchrcondnn
