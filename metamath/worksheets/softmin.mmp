s23:s7,s9:addge01d |- ( ( A e. RR+ /\ B e. RR+ ) -> ( 0 <_ B <-> A <_ ( A + B ) ) )
s24:s23,s15:mpbid |- ( ( A e. RR+ /\ B e. RR+ ) -> A <_ ( A + B ) )
