$( <MM> <PROOF_ASST> THEOREM=encoutf  LOC_AFTER=?

* encodeOutput is a function from pairs (number, list of numbers) to the words over Gamma'.

s1::encoutval |- ( ( m e. NN0 /\ s e. Word NN0 ) -> ( m encodeOutput s ) = ( ( encNatGam ` m ) ++ ( <" 4 "> ++ ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. s ) ) ) ) )
s2::encoutcl |- ( ( m e. NN0 /\ s e. Word NN0 ) -> ( m encodeOutput s ) e. Word Gamma' )
s3:s1,s2:eqeltrrd |- ( ( m e. NN0 /\ s e. Word NN0 ) -> ( ( encNatGam ` m ) ++ ( <" 4 "> ++ ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. s ) ) ) ) e. Word Gamma' )
s4:s3:rgen2 |- A. m e. NN0 A. s e. Word NN0 ( ( encNatGam ` m ) ++ ( <" 4 "> ++ ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. s ) ) ) ) e. Word Gamma'
s5::df-encout |- encodeOutput = ( m e. NN0 , s e. Word NN0 |-> ( ( encNatGam ` m ) ++ ( <" 4 "> ++ ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. s ) ) ) ) )
s6:s5:fmpo |- ( A. m e. NN0 A. s e. Word NN0 ( ( encNatGam ` m ) ++ ( <" 4 "> ++ ( ( freeMnd ` Gamma' ) gsum ( ( p e. NN0 |-> ( ( encNatGam ` p ) ++ <" 4 "> ) ) o. s ) ) ) ) e. Word Gamma' <-> encodeOutput : ( NN0 X. Word NN0 ) --> Word Gamma' )
qed:s4,s6:mpbi |- encodeOutput : ( NN0 X. Word NN0 ) --> Word Gamma'
$)
