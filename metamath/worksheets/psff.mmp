$( <MM> <PROOF_ASST> THEOREM=psff  LOC_AFTER=?

* The partial sums of a complex sequence form a complex sequence.

s1::ad2antrr |- ( ( ( A : NN --> CC /\ q e. NN ) /\ i e. ( 1 ... q ) ) -> A : NN --> CC )
s2::simpr |- ( ( ( A : NN --> CC /\ q e. NN ) /\ i e. ( 1 ... q ) ) -> i e. ( 1 ... q ) )
i3::elfznn
s4:s2,i3:syl |- ( ( ( A : NN --> CC /\ q e. NN ) /\ i e. ( 1 ... q ) ) -> i e. NN )
s5:s1,s4:ffvelcdmd |- ( ( ( A : NN --> CC /\ q e. NN ) /\ i e. ( 1 ... q ) ) -> ( A ` i ) e. CC )
s6::fzfid |- ( ( A : NN --> CC /\ q e. NN ) -> ( 1 ... q ) e. Fin )
s7:s6,s5:fsumcl |- ( ( A : NN --> CC /\ q e. NN ) -> sum_ i e. ( 1 ... q ) ( A ` i ) e. CC )
s8::eqid |- ( q e. NN |-> sum_ i e. ( 1 ... q ) ( A ` i ) ) = ( q e. NN |-> sum_ i e. ( 1 ... q ) ( A ` i ) )
