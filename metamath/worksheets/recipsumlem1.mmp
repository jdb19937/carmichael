12:5,7:logled |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( w <_ p <-> ( log ` w ) <_ ( log ` p ) ) )
13:3,12:mpbid |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( log ` w ) <_ ( log ` p ) )
14:7:relogcld |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( log ` p ) e. RR )
15:11:rpred |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( log ` w ) e. RR )
16:15,14,7,13:lediv1dd |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( log ` w ) / p ) <_ ( ( log ` p ) / p ) )
17:15:recnd |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( log ` w ) e. CC )
18:7:rpcnd  |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> p e. CC )
19:7:rpne0d |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> p =/= 0 )
20a::divrec2
20:17,18,19,20a:syl3anc |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( log ` w ) / p ) = ( ( 1 / p ) x. ( log ` w ) ) )
21:20,16:eqbrtrrd |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( 1 / p ) x. ( log ` w ) ) <_ ( ( log ` p ) / p ) )
22::1re     |- 1 e. RR
