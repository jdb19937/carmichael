26:11:rpgt0d |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> 0 < ( log ` w ) )
27:15,26:jca |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( log ` w ) e. RR /\ 0 < ( log ` w ) ) )
28a::lemuldiv
28:24,25,27,28a:syl3anc |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( ( 1 / p ) x. ( log ` w ) ) <_ ( ( log ` p ) / p ) <-> ( 1 / p ) <_ ( ( ( log ` p ) / p ) / ( log ` w ) ) ) )
29:21,28:mpbid |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( 1 / p ) <_ ( ( ( log ` p ) / p ) / ( log ` w ) ) )
30:8:oveq1d |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( Lam ` p ) / p ) = ( ( log ` p ) / p ) )
31:30:oveq1d |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( ( ( Lam ` p ) / p ) / ( log ` w ) ) = ( ( ( log ` p ) / p ) / ( log ` w ) ) )
qed:29,31:breqtrrd |- ( ( w e. ( ZZ>= ` 2 ) /\ p e. Prime /\ w <_ p ) -> ( 1 / p ) <_ ( ( ( Lam ` p ) / p ) / ( log ` w ) ) )
