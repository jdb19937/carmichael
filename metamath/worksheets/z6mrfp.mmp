$( <MM> <PROOF_ASST> THEOREM=z6mrfp  LOC_AFTER=?

* The rising factorial is the product of ~ z6gamfe ( ~ risefacval , ~ fzoval ).

s1::simpl |- ( ( Z e. CC /\ K e. NN0 ) -> Z e. CC )
s2::simpr |- ( ( Z e. CC /\ K e. NN0 ) -> K e. NN0 )
i3::risefacval
s4:s1,s2,i3:syl2anc |- ( ( Z e. CC /\ K e. NN0 ) -> ( Z RiseFac K ) = prod_ k e. ( 0 ... ( K - 1 ) ) ( Z + k ) )
s5:s2:nn0zd |- ( ( Z e. CC /\ K e. NN0 ) -> K e. ZZ )
i6::fzoval
s7:s5,i6:syl |- ( ( Z e. CC /\ K e. NN0 ) -> ( 0 ..^ K ) = ( 0 ... ( K - 1 ) ) )
s8:s7:prodeq1d |- ( ( Z e. CC /\ K e. NN0 ) -> prod_ j e. ( 0 ..^ K ) ( Z + j ) = prod_ j e. ( 0 ... ( K - 1 ) ) ( Z + j ) )
s9::oveq2 |- ( j = k -> ( Z + j ) = ( Z + k ) )
s10:s9:cbvprodv |- prod_ j e. ( 0 ... ( K - 1 ) ) ( Z + j ) = prod_ k e. ( 0 ... ( K - 1 ) ) ( Z + k )
s11:s10:a1i |- ( ( Z e. CC /\ K e. NN0 ) -> prod_ j e. ( 0 ... ( K - 1 ) ) ( Z + j ) = prod_ k e. ( 0 ... ( K - 1 ) ) ( Z + k ) )
s12:s8,s11:eqtrd |- ( ( Z e. CC /\ K e. NN0 ) -> prod_ j e. ( 0 ..^ K ) ( Z + j ) = prod_ k e. ( 0 ... ( K - 1 ) ) ( Z + k ) )
qed:s12,s4:eqtr4d |- ( ( Z e. CC /\ K e. NN0 ) -> prod_ j e. ( 0 ..^ K ) ( Z + j ) = ( Z RiseFac K ) )
$)
