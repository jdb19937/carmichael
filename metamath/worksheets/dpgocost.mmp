s4::simpl |- ( ( ( ( L e. NN /\ P e. NN0 ) /\ T e. Tbl ) /\ ( F e. NN0 /\ A e. Tbl ) ) -> ( ( L e. NN /\ P e. NN0 ) /\ T e. Tbl ) )
