$( <MM> <PROOF_ASST> THEOREM=bwbncl  LOC_AFTER=?

* The value of a Boolean is a nonnegative integer.

s1::bwbnval |- ( C e. 2o -> ( bToNat ` C ) = if ( C = 1o , 1 , 0 ) )
s2::id |- ( C e. 2o -> C e. 2o )
s3::1nn0 |- 1 e. NN0
s4:s3:a1i |- ( C e. 2o -> 1 e. NN0 )
s5::0nn0 |- 0 e. NN0
s6:s5:a1i |- ( C e. 2o -> 0 e. NN0 )
s7:s4,s6:ifcld |- ( C e. 2o -> if ( C = 1o , 1 , 0 ) e. NN0 )
qed:s1,s7:eqeltrd |- ( C e. 2o -> ( bToNat ` C ) e. NN0 )
$)
