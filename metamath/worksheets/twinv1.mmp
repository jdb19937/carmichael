$( <MM> <PROOF_ASST> THEOREM=twinv1  LOC_AFTER=?

* The twin-sieve density at 1 is 1.

s1::nprmdvds1 |- ( g e. Prime -> -. g || 1 )
s2:s1:rgen |- A. g e. Prime -. g || 1
s3::rabeq0 |- ( { g e. Prime | g || 1 } = (/) <-> A. g e. Prime -. g || 1 )
s4:s3,s2:mpbir |- { g e. Prime | g || 1 } = (/)
i5::prodeq1
s6:s4,i5:ax-mp |- prod_ f e. { g e. Prime | g || 1 } ( 2 / f ) = prod_ f e. (/) ( 2 / f )
s7::prod0 |- prod_ f e. (/) ( 2 / f ) = 1
s8:s6,s7:eqtri |- prod_ f e. { g e. Prime | g || 1 } ( 2 / f ) = 1
s9::1nn |- 1 e. NN
i10::twinvval
s11:s9,i10:ax-mp |- ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) ) ` 1 ) = prod_ f e. { g e. Prime | g || 1 } ( 2 / f )
qed:s11,s8:eqtri |- ( ( t e. NN |-> prod_ f e. { g e. Prime | g || t } ( 2 / f ) ) ` 1 ) = 1
$)
