4::simp3l   |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P - 1 ) || ( N - 1 ) )
5::simp3r   |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> A e. ZZ )
6a::sqfpc
6:2,3,1,6a:syl3anc |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P pCnt N ) <_ 1 )
7:1,2,4:3jca |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P e. Prime /\ N e. NN /\ ( P - 1 ) || ( N - 1 ) ) )
