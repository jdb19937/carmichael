14a::exp1
14:13,14a:syl |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P ^ 1 ) = P )
15:14,8:eqbrtrd |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P ^ 1 ) || ( ( A ^ N ) - A ) )
