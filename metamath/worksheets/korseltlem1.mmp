18:15,17:mpbird |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> 1 <_ ( P pCnt ( ( A ^ N ) - A ) ) )
19a::nnq
19:2,19a:syl |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> N e. QQ )
