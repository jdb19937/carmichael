qed:20,22,24,6,18:xrletrd |- ( ( P e. Prime /\ ( N e. NN /\ ( mmu ` N ) =/= 0 ) /\ ( ( P - 1 ) || ( N - 1 ) /\ A e. ZZ ) ) -> ( P pCnt N ) <_ ( P pCnt ( ( A ^ N ) - A ) ) )
