$( <MM> <PROOF_ASST> THEOREM=divisorsofspec  LOC_AFTER=?

* The divisor enumeration is duplicate-free and enumerates the divisors (Lean: divisorsOf_spec).

s1::simp1 |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> W e. Word NN0 )
s2::simp2 |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> Fun `' W )
s3::simp3 |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> A. q e. ran W q e. Prime )
i4::divofsp
s5:s1,i4:syl |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> ( ( Fun `' W /\ A. q e. ran W q e. Prime ) -> ( Fun `' ( 1st ` ( DivisorsOf ` W ) ) /\ ran ( 1st ` ( DivisorsOf ` W ) ) = { m e. ( 1 ... prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) ) | m || prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) } ) ) )
s6:s2,s3:jca |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> ( Fun `' W /\ A. q e. ran W q e. Prime ) )
qed:s5,s6:mpd |- ( ( W e. Word NN0 /\ Fun `' W /\ A. q e. ran W q e. Prime ) -> ( Fun `' ( 1st ` ( DivisorsOf ` W ) ) /\ ran ( 1st ` ( DivisorsOf ` W ) ) = { m e. ( 1 ... prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) ) | m || prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) } ) )
$)
