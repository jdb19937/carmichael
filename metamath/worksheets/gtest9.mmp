s1::simpl |- ( ( X e. RR /\ N e. NN0 ) -> X e. RR )
s2::simpr |- ( ( X e. RR /\ N e. NN0 ) -> N e. NN0 )
s3:s1:reefcld |- ( ( X e. RR /\ N e. NN0 ) -> ( exp ` X ) e. RR )
s4:s2:nn0zd |- ( ( X e. RR /\ N e. NN0 ) -> N e. ZZ )
s5:s4:zred |- ( ( X e. RR /\ N e. NN0 ) -> N e. RR )
