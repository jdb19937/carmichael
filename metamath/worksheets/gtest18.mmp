s8:s7:rpred |- ( ( N e. NN /\ k e. ( 1 ... ( N + 1 ) ) ) -> k e. RR )
s9:s8:recnd |- ( ( N e. NN /\ k e. ( 1 ... ( N + 1 ) ) ) -> k e. CC )
s10::2nn0 |- 2 e. NN0
