s15::1red |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) /\ E e. RR ) -> 1 e. RR )
s16:s15,s3:resubcld |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) /\ E e. RR ) -> ( 1 - E ) e. RR )
i17::recxpcl
s18:s13,s14,s16,i17:syl3anc |- ( ( C e. RR /\ N e. ( ZZ>= ` 3 ) /\ E e. RR ) -> ( ( C zscale N ) ^c ( 1 - E ) ) e. RR )
i19::nceilcl
