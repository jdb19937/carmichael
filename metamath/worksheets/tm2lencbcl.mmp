$( <MM> <PROOF_ASST> THEOREM=tm2lencbcl  LOC_AFTER=?

* A list of bit words on a stack is a word over ` Gamma' ` .

s1::tm2lencbval |- ( L e. Word Word ( { 1 } X. 2o ) -> ( encListB ` L ) = ( ( entries ` L ) ++ <" 2 "> ) )
s2::tm2lentcl |- ( L e. Word Word ( { 1 } X. 2o ) -> ( entries ` L ) e. Word Gamma' )
s3::gamma2 |- 2 e. Gamma'
s4:s3:a1i |- ( L e. Word Word ( { 1 } X. 2o ) -> 2 e. Gamma' )
i5::ccatws1cl
s6:s2,s4,i5:syl2anc |- ( L e. Word Word ( { 1 } X. 2o ) -> ( ( entries ` L ) ++ <" 2 "> ) e. Word Gamma' )
qed:s1,s6:eqeltrd |- ( L e. Word Word ( { 1 } X. 2o ) -> ( encListB ` L ) e. Word Gamma' )
$)
