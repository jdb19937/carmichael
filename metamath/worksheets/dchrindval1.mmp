$( <MM> <PROOF_ASST> THEOREM=dchrindval1  LOC_AFTER=?

* The characterising property of the induced character (Mathlib changeLevel_eq_cast_of_dvd): at the class of an integer A coprime to M it agrees with X at the class of A mod N.

s1::3simpa |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd M ) = 1 ) -> ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ ) )
i2::dchrindval2
s3:s1,i2:syl |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd M ) = 1 ) -> ( ( ( N DChrInd M ) ` X ) ` ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) ) = if ( ( A gcd M ) = 1 , ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) , 0 ) )
s4::simp3 |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd M ) = 1 ) -> ( A gcd M ) = 1 )
s5:s4:iftrued |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd M ) = 1 ) -> if ( ( A gcd M ) = 1 , ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) , 0 ) = ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) )
qed:s3,s5:eqtrd |- ( ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) /\ A e. ZZ /\ ( A gcd M ) = 1 ) -> ( ( ( N DChrInd M ) ` X ) ` ( ( ZRHom ` ( Z/nZ ` M ) ) ` A ) ) = ( X ` ( ( ZRHom ` ( Z/nZ ` N ) ) ` A ) ) )
$)
