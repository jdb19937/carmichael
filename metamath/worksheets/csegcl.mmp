$( <MM> <PROOF_ASST> THEOREM=csegcl  LOC_AFTER=?

* A segment is a set of complex numbers.

s1::simpll |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> A e. CC )
s2::simplr |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> B e. CC )
s3::simpr |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> t e. ( 0 [,] 1 ) )
i4::elunitcn
s5:s3,i4:syl |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> t e. CC )
s6:s2,s1:subcld |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( B - A ) e. CC )
s7:s5,s6:mulcld |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( t x. ( B - A ) ) e. CC )
s8:s1,s7:addcld |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( A + ( t x. ( B - A ) ) ) e. CC )
s9:s8:fmptd |- ( ( A e. CC /\ B e. CC ) -> ( t e. ( 0 [,] 1 ) |-> ( A + ( t x. ( B - A ) ) ) ) : ( 0 [,] 1 ) --> CC )
s10:s9:frnd |- ( ( A e. CC /\ B e. CC ) -> ran ( t e. ( 0 [,] 1 ) |-> ( A + ( t x. ( B - A ) ) ) ) C_ CC )
s11::csegval |- ( ( A e. CC /\ B e. CC ) -> ( A cseg B ) = ran ( t e. ( 0 [,] 1 ) |-> ( A + ( t x. ( B - A ) ) ) ) )
qed:s11,s10:eqsstrd |- ( ( A e. CC /\ B e. CC ) -> ( A cseg B ) C_ CC )
$)
