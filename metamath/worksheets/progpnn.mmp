$( <MM> <PROOF_ASST> THEOREM=progpnn  LOC_AFTER=?

* The sifting product of the progression sieve is a squarefree positive integer whose prime divisors are the sifting primes.

s1::progtfi |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } e. Fin /\ { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } C_ Prime ) )
i2::sqfprod
qed:s1,i2:syl |- ( ( M e. ( ZZ>= ` 2 ) /\ Z e. NN /\ N e. NN0 ) -> ( ( prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p e. NN /\ ( mmu ` prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p ) =/= 0 ) /\ { q e. Prime | q || prod_ p e. { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } p } = { u e. ( 0 ... Z ) | ( u e. Prime /\ -. u || M ) } ) )
$)
