s19:s1,s2:jca |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( B e. V /\ G : B --> B ) )
i20::relexpfd
s21:s4,i20:syl |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( ( B e. V /\ G : B --> B ) -> ( G ^r M ) : B --> B ) )
s22:s19,s21:mpd |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( G ^r M ) : B --> B )
