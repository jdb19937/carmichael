s14:s3,s13:jca |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( N e. NN0 /\ ( M e. NN0 /\ G e. _V /\ ( ( N + M ) = 1 -> Rel G ) ) ) )
i15::relexpaddg
s16:s14,i15:syl |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( ( G ^r N ) o. ( G ^r M ) ) = ( G ^r ( N + M ) ) )
s17:s16:eqcomd |- ( ( ( B e. V /\ G : B --> B ) /\ ( N e. NN0 /\ M e. NN0 ) /\ X e. B ) -> ( G ^r ( N + M ) ) = ( ( G ^r N ) o. ( G ^r M ) ) )
