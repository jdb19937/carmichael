28:2,27,28a:syl2anc |- ( ( P e. Prime /\ p e. Prime ) -> p =/= 1 )
29:28:neneqd |- ( ( P e. Prime /\ p e. Prime ) -> -. p = 1 )
30:29,25:mtbird |- ( ( P e. Prime /\ p e. Prime ) -> -. ( p ^ 2 ) = 1 )
31:13,30:jca |- ( ( P e. Prime /\ p e. Prime ) -> ( -. ( p ^ 2 ) = P /\ -. ( p ^ 2 ) = 1 ) )
32::ioran   |- ( -. ( ( p ^ 2 ) = P \/ ( p ^ 2 ) = 1 ) <-> ( -. ( p ^ 2 ) = P /\ -. ( p ^ 2 ) = 1 ) )
33:31,32:sylibr |- ( ( P e. Prime /\ p e. Prime ) -> -. ( ( p ^ 2 ) = P \/ ( p ^ 2 ) = 1 ) )
34:33,5:mtbird |- ( ( P e. Prime /\ p e. Prime ) -> -. ( p ^ 2 ) || P )
35:34:ralrimiva |- ( P e. Prime -> A. p e. Prime -. ( p ^ 2 ) || P )
36::ralnex  |- ( A. p e. Prime -. ( p ^ 2 ) || P <-> -. E. p e. Prime ( p ^ 2 ) || P )
37:35,36:sylib |- ( P e. Prime -> -. E. p e. Prime ( p ^ 2 ) || P )

38::prmnn |- ( P e. Prime -> P e. NN )
39a::isnsqf
