h2::z5finser.2 |- ( ( ph /\ ( k e. A /\ m e. NN ) ) -> ( G ` m ) e. CC )
h3::z5finser.3 |- ( ( ph /\ k e. A ) -> seq 1 ( + , G ) ~~> L )
h4::z5finser.4 |- ( ( ph /\ k e. A ) -> E e. CC )
