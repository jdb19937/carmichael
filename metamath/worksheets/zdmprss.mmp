$( <MM> <PROOF_ASST> THEOREM=zdmprss  LOC_AFTER=?

* The primes up to N lie in ( 2 ... N ).

s1::id |- ( p e. ( ( 1 ... N ) i^i Prime ) -> p e. ( ( 1 ... N ) i^i Prime ) )
i2::elinel1
s3:s1,i2:syl |- ( p e. ( ( 1 ... N ) i^i Prime ) -> p e. ( 1 ... N ) )
i4::elinel2
s5:s1,i4:syl |- ( p e. ( ( 1 ... N ) i^i Prime ) -> p e. Prime )
i6::prmuz2
s7:s5,i6:syl |- ( p e. ( ( 1 ... N ) i^i Prime ) -> p e. ( ZZ>= ` 2 ) )
i8::elfzuz3
s9:s3,i8:syl |- ( p e. ( ( 1 ... N ) i^i Prime ) -> N e. ( ZZ>= ` p ) )
s10:s7,s9:jca |- ( p e. ( ( 1 ... N ) i^i Prime ) -> ( p e. ( ZZ>= ` 2 ) /\ N e. ( ZZ>= ` p ) ) )
s11::elfzuzb |- ( p e. ( 2 ... N ) <-> ( p e. ( ZZ>= ` 2 ) /\ N e. ( ZZ>= ` p ) ) )
s12:s11:a1i |- ( p e. ( ( 1 ... N ) i^i Prime ) -> ( p e. ( 2 ... N ) <-> ( p e. ( ZZ>= ` 2 ) /\ N e. ( ZZ>= ` p ) ) ) )
s13:s10,s12:mpbird |- ( p e. ( ( 1 ... N ) i^i Prime ) -> p e. ( 2 ... N ) )
qed:s13:ssriv |- ( ( 1 ... N ) i^i Prime ) C_ ( 2 ... N )
