$( <MM> <PROOF_ASST> THEOREM=algprodcl  LOC_AFTER=?

* The product over a word of nonnegative integers is a nonnegative integer.

s1::id |- ( W e. Word NN0 -> W e. Word NN0 )
s2::fzofi |- ( 0 ..^ ( # ` W ) ) e. Fin
s3:s2:a1i |- ( W e. Word NN0 -> ( 0 ..^ ( # ` W ) ) e. Fin )
s4:s1:adantr |- ( ( W e. Word NN0 /\ i e. ( 0 ..^ ( # ` W ) ) ) -> W e. Word NN0 )
s5::simpr |- ( ( W e. Word NN0 /\ i e. ( 0 ..^ ( # ` W ) ) ) -> i e. ( 0 ..^ ( # ` W ) ) )
i6::wrdsymbcl
s7:s4,s5,i6:syl2anc |- ( ( W e. Word NN0 /\ i e. ( 0 ..^ ( # ` W ) ) ) -> ( W ` i ) e. NN0 )
qed:s3,s7:fprodnn0cl |- ( W e. Word NN0 -> prod_ i e. ( 0 ..^ ( # ` W ) ) ( W ` i ) e. NN0 )
$)
