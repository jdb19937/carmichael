s1::simp1 |- ( ( ( y e. Fin /\ -. z e. y ) /\ ( y C_ Prime -> ( mmu ` prod_ q e. y q ) =/= 0 ) /\ ( y u. { z } ) C_ Prime ) -> ( y e. Fin /\ -. z e. y ) )
