$( <MM> <PROOF_ASST> THEOREM=z5tofsq  LOC_AFTER=?

* Lean squarefree_tOf, tOf_ne_zero, tOf_primeFactors: t ( D ; R ) = prod_ ( p | R , -. p | D ) p is a squarefree positive integer whose prime set is { p | R : -. p | D } (V2's sqfprod on that finite set of primes).

s1::simpl |- ( ( u || R /\ -. u || D ) -> u || R )
s2:s1:a1i |- ( u e. Prime -> ( ( u || R /\ -. u || D ) -> u || R ) )
s3:s2:ss2rabi |- { u e. Prime | ( u || R /\ -. u || D ) } C_ { u e. Prime | u || R }
s4::breq1 |- ( u = q -> ( u || R <-> q || R ) )
s5:s4:cbvrabv |- { u e. Prime | u || R } = { q e. Prime | q || R }
s6:s3,s5:sseqtri |- { u e. Prime | ( u || R /\ -. u || D ) } C_ { q e. Prime | q || R }
