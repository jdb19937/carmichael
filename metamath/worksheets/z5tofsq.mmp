s11:s10:a1i |- ( R e. NN -> { u e. Prime | ( u || R /\ -. u || D ) } C_ Prime )
i12::sqfprod
s13:s9,s11,i12:syl2anc |- ( R e. NN -> ( ( prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p e. NN /\ ( mmu ` prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p ) =/= 0 ) /\ { q e. Prime | q || prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p } = { u e. Prime | ( u || R /\ -. u || D ) } ) )
s14::id |- ( p = w -> p = w )
s15:s14:cbvprodv |- prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p = prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w
s16::id |- ( u = q -> u = q )
c1:s16:breq1d |- ( u = q -> ( u || R <-> q || R ) )
c2:s16:breq1d |- ( u = q -> ( u || D <-> q || D ) )
