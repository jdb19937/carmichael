s19:s17:a1i |- ( R e. NN -> { u e. Prime | ( u || R /\ -. u || D ) } = { q e. Prime | ( q || R /\ -. q || D ) } )
c5:s18:eleq1d |- ( R e. NN -> ( prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p e. NN <-> prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN ) )
c6:s18:fveq2d |- ( R e. NN -> ( mmu ` prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p ) = ( mmu ` prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) )
