c12:c8,c11:anbi12d |- ( R e. NN -> ( ( ( prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p e. NN /\ ( mmu ` prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p ) =/= 0 ) /\ { q e. Prime | q || prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p } = { u e. Prime | ( u || R /\ -. u || D ) } ) <-> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN /\ ( mmu ` prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) =/= 0 ) /\ { q e. Prime | q || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w } = { q e. Prime | ( q || R /\ -. q || D ) } ) ) )
qed:s13,c12:mpbid |- ( R e. NN -> ( ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN /\ ( mmu ` prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) =/= 0 ) /\ { q e. Prime | q || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w } = { q e. Prime | ( q || R /\ -. q || D ) } ) )
