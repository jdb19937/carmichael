c8:c5,c7:anbi12d |- ( R e. NN -> ( ( prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p e. NN /\ ( mmu ` prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p ) =/= 0 ) <-> ( prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w e. NN /\ ( mmu ` prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) =/= 0 ) ) )
c9:s18:breq2d |- ( R e. NN -> ( q || prod_ p e. { u e. Prime | ( u || R /\ -. u || D ) } p <-> q || prod_ w e. { u e. Prime | ( u || R /\ -. u || D ) } w ) )
