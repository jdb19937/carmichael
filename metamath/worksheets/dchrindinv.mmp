$( <MM> <PROOF_ASST> THEOREM=dchrindinv  LOC_AFTER=?

* The induced character of the inverse (= conjugate, dchrinv) character is the inverse of the induced character (Mathlib map_inv for changeLevel).

s1::simpl |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) -> ( N e. NN /\ M e. NN /\ N || M ) )
s2::simpr |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) -> X e. ( Base ` ( DChr ` N ) ) )
i3::dchrindghm
s4:s1,i3:syl |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) -> ( N DChrInd M ) e. ( ( DChr ` N ) GrpHom ( DChr ` M ) ) )
s5::eqid |- ( Base ` ( DChr ` N ) ) = ( Base ` ( DChr ` N ) )
s6::eqid |- ( invg ` ( DChr ` N ) ) = ( invg ` ( DChr ` N ) )
s7::eqid |- ( invg ` ( DChr ` M ) ) = ( invg ` ( DChr ` M ) )
s8:s5,s6,s7:ghminv |- ( ( ( N DChrInd M ) e. ( ( DChr ` N ) GrpHom ( DChr ` M ) ) /\ X e. ( Base ` ( DChr ` N ) ) ) -> ( ( N DChrInd M ) ` ( ( invg ` ( DChr ` N ) ) ` X ) ) = ( ( invg ` ( DChr ` M ) ) ` ( ( N DChrInd M ) ` X ) ) )
qed:s4,s2,s8:syl2anc |- ( ( ( N e. NN /\ M e. NN /\ N || M ) /\ X e. ( Base ` ( DChr ` N ) ) ) -> ( ( N DChrInd M ) ` ( ( invg ` ( DChr ` N ) ) ` X ) ) = ( ( invg ` ( DChr ` M ) ) ` ( ( N DChrInd M ) ` X ) ) )
$)
