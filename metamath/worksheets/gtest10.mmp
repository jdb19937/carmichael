s3::simpr |- ( ( N e. NN /\ k e. ( 1 ... N ) ) -> k e. ( 1 ... N ) )
i4::elfznn
s5:s3,i4:syl |- ( ( N e. NN /\ k e. ( 1 ... N ) ) -> k e. NN )
s6::1re |- 1 e. RR
s7:s6:a1i |- ( ( N e. NN /\ k e. ( 1 ... N ) ) -> 1 e. RR )
s8:s5:nnrpd |- ( ( N e. NN /\ k e. ( 1 ... N ) ) -> k e. RR+ )
s9:s7,s8:rerpdivcld |- ( ( N e. NN /\ k e. ( 1 ... N ) ) -> ( 1 / k ) e. RR )
s10:s2,s9:fsumrecl |- ( N e. NN -> sum_ k e. ( 1 ... N ) ( 1 / k ) e. RR )
