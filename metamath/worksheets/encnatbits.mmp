i18::rerpdivcl
s19:s12,s17,i18:syl2anc |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( N / ( 2 ^ I ) ) e. RR )
s20:s19:flcld |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( |_ ` ( N / ( 2 ^ I ) ) ) e. ZZ )
i21::mod2eq1n2dvds
s22:s20,i21:syl |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 <-> -. 2 || ( |_ ` ( N / ( 2 ^ I ) ) ) ) )
s23:s9,s22:bitrd |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( ( ( encodeNat ` N ) ` I ) = 1o <-> -. 2 || ( |_ ` ( N / ( 2 ^ I ) ) ) ) )
s24:s1:nn0zd |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> N e. ZZ )
