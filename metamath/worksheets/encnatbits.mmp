$( <MM> <PROOF_ASST> THEOREM=encnatbits  LOC_AFTER=?

* The I-th letter of encodeNat N is true if and only if I is a binary digit of N (set.mm's bits).

s1::simpl |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> N e. NN0 )
s2::simpr |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) )
s3::encnatfv |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( ( encodeNat ` N ) ` I ) = if ( ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 , 1o , (/) ) )
s4:s3:eqeq1d |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( ( ( encodeNat ` N ) ` I ) = 1o <-> if ( ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 , 1o , (/) ) = 1o ) )
s5::1n0 |- 1o =/= (/)
i6::iftrueb
s7:s5,i6:ax-mp |- ( if ( ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 , 1o , (/) ) = 1o <-> ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 )
s8:s7:a1i |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( if ( ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 , 1o , (/) ) = 1o <-> ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 ) )
s9:s4,s8:bitrd |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> ( ( ( encodeNat ` N ) ` I ) = 1o <-> ( ( |_ ` ( N / ( 2 ^ I ) ) ) mod 2 ) = 1 ) )
i10::elfzonn0
s11:s2,i10:syl |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> I e. NN0 )
s12:s1:nn0red |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> N e. RR )
s13::2rp |- 2 e. RR+
s14:s13:a1i |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> 2 e. RR+ )
s15:s11:nn0zd |- ( ( N e. NN0 /\ I e. ( 0 ..^ ( # ` ( encodeNat ` N ) ) ) ) -> I e. ZZ )
