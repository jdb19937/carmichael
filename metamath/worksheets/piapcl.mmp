$( <MM> <PROOF_ASST> THEOREM=piapcl  LOC_AFTER=?

* Closure: the prime count in a residue class is a nonnegative integer.

s1::piapval |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( piAP ` Q ) Y ) = ( # ` { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) )
s2::fzfid |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( 1 ... ( |_ ` Y ) ) e. Fin )
i3::rabfi
s4:s2,i3:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } e. Fin )
i5::hashcl
s6:s4,i5:syl |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( # ` { n e. ( 1 ... ( |_ ` Y ) ) | ( n e. Prime /\ ( n mod Q ) = ( A mod Q ) ) } ) e. NN0 )
qed:s1,s6:eqeltrd |- ( ( Q e. NN /\ A e. ZZ /\ Y e. RR ) -> ( A ( piAP ` Q ) Y ) e. NN0 )
$)
