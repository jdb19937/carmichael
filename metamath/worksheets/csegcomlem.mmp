$( <MM> <PROOF_ASST> THEOREM=csegcomlem  LOC_AFTER=?

* Lemma for csegcom: one inclusion.

s1::simpll |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> A e. CC )
s2::simplr |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> B e. CC )
s3::simpr |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> t e. ( 0 [,] 1 ) )
i4::elunitcn
s5:s3,i4:syl |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> t e. CC )
i6::cseglinrev
s7:s2,s1,s5,i6:syl3anc |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( B + ( ( 1 - t ) x. ( A - B ) ) ) = ( A + ( t x. ( B - A ) ) ) )
i8::iirev
s9:s3,i8:syl |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( 1 - t ) e. ( 0 [,] 1 ) )
i10::cseglin
s11:s2,s1,s9,i10:syl3anc |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( B + ( ( 1 - t ) x. ( A - B ) ) ) e. ( B cseg A ) )
s12:s7,s11:eqeltrrd |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( A + ( t x. ( B - A ) ) ) e. ( B cseg A ) )
s13::eleq1 |- ( x = ( A + ( t x. ( B - A ) ) ) -> ( x e. ( B cseg A ) <-> ( A + ( t x. ( B - A ) ) ) e. ( B cseg A ) ) )
s14:s12,s13:syl5ibrcom |- ( ( ( A e. CC /\ B e. CC ) /\ t e. ( 0 [,] 1 ) ) -> ( x = ( A + ( t x. ( B - A ) ) ) -> x e. ( B cseg A ) ) )
s15:s14:rexlimdva |- ( ( A e. CC /\ B e. CC ) -> ( E. t e. ( 0 [,] 1 ) x = ( A + ( t x. ( B - A ) ) ) -> x e. ( B cseg A ) ) )
s16::csegel |- ( ( A e. CC /\ B e. CC ) -> ( x e. ( A cseg B ) <-> E. t e. ( 0 [,] 1 ) x = ( A + ( t x. ( B - A ) ) ) ) )
s17:s16,s15:sylbid |- ( ( A e. CC /\ B e. CC ) -> ( x e. ( A cseg B ) -> x e. ( B cseg A ) ) )
qed:s17:ssrdv |- ( ( A e. CC /\ B e. CC ) -> ( A cseg B ) C_ ( B cseg A ) )
$)
