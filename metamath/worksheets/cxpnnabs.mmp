$( <MM> <PROOF_ASST> THEOREM=cxpnnabs  LOC_AFTER=?

* The modulus of a Dirichlet-series power: it depends only on the real part of the exponent.

s1::simpl |- ( ( K e. NN /\ Z e. CC ) -> K e. NN )
s2::simpr |- ( ( K e. NN /\ Z e. CC ) -> Z e. CC )
s3:s1:nnrpd |- ( ( K e. NN /\ Z e. CC ) -> K e. RR+ )
s4:s2:negcld |- ( ( K e. NN /\ Z e. CC ) -> -u Z e. CC )
i5::abscxp
s6:s3,s4,i5:syl2anc |- ( ( K e. NN /\ Z e. CC ) -> ( abs ` ( K ^c -u Z ) ) = ( K ^c ( Re ` -u Z ) ) )
i7::reneg
s8:s2,i7:syl |- ( ( K e. NN /\ Z e. CC ) -> ( Re ` -u Z ) = -u ( Re ` Z ) )
s9:s8:oveq2d |- ( ( K e. NN /\ Z e. CC ) -> ( K ^c ( Re ` -u Z ) ) = ( K ^c -u ( Re ` Z ) ) )
qed:s6,s9:eqtrd |- ( ( K e. NN /\ Z e. CC ) -> ( abs ` ( K ^c -u Z ) ) = ( K ^c -u ( Re ` Z ) ) )
$)
