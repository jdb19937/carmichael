$( <MM> <PROOF_ASST> THEOREM=phiinvpf  LOC_AFTER=?

* For a positive integer L, ( 1 / L ) times the Euler product of 1 / ( 1 - 1 / q ) over the primes dividing L is 1 / phi ( L ).

s1::id |- ( L e. NN -> L e. NN )
s2::breq1 |- ( q = r -> ( q || L <-> r || L ) )
s3:s2:cbvrabv |- { q e. Prime | q || L } = { r e. Prime | r || L }
s4:s3:prodeq1i |- prod_ p e. { q e. Prime | q || L } ( 1 - ( 1 / p ) ) = prod_ p e. { r e. Prime | r || L } ( 1 - ( 1 / p ) )
s5::oveq2 |- ( p = q -> ( 1 / p ) = ( 1 / q ) )
s6:s5:oveq2d |- ( p = q -> ( 1 - ( 1 / p ) ) = ( 1 - ( 1 / q ) ) )
s7:s6:cbvprodv |- prod_ p e. { r e. Prime | r || L } ( 1 - ( 1 / p ) ) = prod_ q e. { r e. Prime | r || L } ( 1 - ( 1 / q ) )
s8:s4,s7:eqtri |- prod_ p e. { q e. Prime | q || L } ( 1 - ( 1 / p ) ) = prod_ q e. { r e. Prime | r || L } ( 1 - ( 1 / q ) )
i9::phipfprod
s10:s1,i9:syl |- ( L e. NN -> prod_ p e. { q e. Prime | q || L } ( 1 - ( 1 / p ) ) = ( ( phi ` L ) / L ) )
s11:s8:a1i |- ( L e. NN -> prod_ p e. { q e. Prime | q || L } ( 1 - ( 1 / p ) ) = prod_ q e. { r e. Prime | r || L } ( 1 - ( 1 / q ) ) )
s12:s10,s11:eqtr3d |- ( L e. NN -> prod_ q e. { r e. Prime | r || L } ( 1 - ( 1 / q ) ) = ( ( phi ` L ) / L ) )
i13::pffinq
s14:s1,i13:syl |- ( L e. NN -> { q e. Prime | q || L } e. Fin )
s15:s3:a1i |- ( L e. NN -> { q e. Prime | q || L } = { r e. Prime | r || L } )
s16:s14,s15:eqeltrrd |- ( L e. NN -> { r e. Prime | r || L } e. Fin )
s17::ssrab2 |- { r e. Prime | r || L } C_ Prime
s18:s17:a1i |- ( ( L e. NN /\ q e. { r e. Prime | r || L } ) -> { r e. Prime | r || L } C_ Prime )
