$( <MM> <PROOF_ASST> THEOREM=hp0logdm  LOC_AFTER=?

* The open right half-plane lies in the domain of continuity of the logarithm, the plane slit along the nonpositive reals.

s1::0re |- 0 e. RR
i2::elhp2
s3:s1,i2:ax-mp |- ( A e. ( `' Re " ( 0 (,) +oo ) ) <-> ( A e. CC /\ 0 < ( Re ` A ) ) )
s4:s3:a1i |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> ( A e. ( `' Re " ( 0 (,) +oo ) ) <-> ( A e. CC /\ 0 < ( Re ` A ) ) ) )
s5::id |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> A e. ( `' Re " ( 0 (,) +oo ) ) )
s6:s5,s4:mpbid |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> ( A e. CC /\ 0 < ( Re ` A ) ) )
i7::simpl
s8:s6,i7:syl |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> A e. CC )
i9::simpr
s10:s6,i9:syl |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> 0 < ( Re ` A ) )
s11::simpr |- ( ( A e. ( `' Re " ( 0 (,) +oo ) ) /\ A e. RR ) -> A e. RR )
i12::rere
s13:s11,i12:syl |- ( ( A e. ( `' Re " ( 0 (,) +oo ) ) /\ A e. RR ) -> ( Re ` A ) = A )
s14:s10:adantr |- ( ( A e. ( `' Re " ( 0 (,) +oo ) ) /\ A e. RR ) -> 0 < ( Re ` A ) )
s15:s14,s13:breqtrd |- ( ( A e. ( `' Re " ( 0 (,) +oo ) ) /\ A e. RR ) -> 0 < A )
s16:s11,s15:elrpd |- ( ( A e. ( `' Re " ( 0 (,) +oo ) ) /\ A e. RR ) -> A e. RR+ )
s17:s16:ex |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> ( A e. RR -> A e. RR+ ) )
s18::eqid |- ( CC \ ( -oo (,] 0 ) ) = ( CC \ ( -oo (,] 0 ) )
s19:s18:ellogdm |- ( A e. ( CC \ ( -oo (,] 0 ) ) <-> ( A e. CC /\ ( A e. RR -> A e. RR+ ) ) )
s20:s19:a1i |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> ( A e. ( CC \ ( -oo (,] 0 ) ) <-> ( A e. CC /\ ( A e. RR -> A e. RR+ ) ) ) )
s21:s8,s17:jca |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> ( A e. CC /\ ( A e. RR -> A e. RR+ ) ) )
qed:s21,s20:mpbird |- ( A e. ( `' Re " ( 0 (,) +oo ) ) -> A e. ( CC \ ( -oo (,] 0 ) ) )
