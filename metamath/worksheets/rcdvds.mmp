s34:s33:fveq2d |- ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) -> ( # ` { v e. ( 0 ..^ prod_ p e. { q e. Prime | q || D } p ) | prod_ p e. { q e. Prime | q || D } p || ( v x. ( ( M x. v ) + 1 ) ) } ) = ( # ` { v e. ( 0 ..^ D ) | D || ( v x. ( ( M x. v ) + 1 ) ) } ) )
s35:s34:eqcomd |- ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) -> ( # ` { v e. ( 0 ..^ D ) | D || ( v x. ( ( M x. v ) + 1 ) ) } ) = ( # ` { v e. ( 0 ..^ prod_ p e. { q e. Prime | q || D } p ) | prod_ p e. { q e. Prime | q || D } p || ( v x. ( ( M x. v ) + 1 ) ) } ) )
qed:s35,s28:eqtrd |- ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) -> ( # ` { v e. ( 0 ..^ D ) | D || ( v x. ( ( M x. v ) + 1 ) ) } ) = ( 2 ^ ( # ` { q e. Prime | q || D } ) ) )
