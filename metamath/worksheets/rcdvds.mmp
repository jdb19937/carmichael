s28:s26,i27:syl |- ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) -> ( # ` { v e. ( 0 ..^ prod_ p e. { q e. Prime | q || D } p ) | prod_ p e. { q e. Prime | q || D } p || ( v x. ( ( M x. v ) + 1 ) ) } ) = ( 2 ^ ( # ` { q e. Prime | q || D } ) ) )
