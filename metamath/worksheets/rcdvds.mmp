s9::breq1 |- ( q = n -> ( q || D <-> n || D ) )
s10:s9:elrab |- ( n e. { q e. Prime | q || D } <-> ( n e. Prime /\ n || D ) )
s11:s10:a1i |- ( ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) /\ n e. { q e. Prime | q || D } ) -> ( n e. { q e. Prime | q || D } <-> ( n e. Prime /\ n || D ) ) )
s12::simpr |- ( ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) /\ n e. { q e. Prime | q || D } ) -> n e. { q e. Prime | q || D } )
s13:s11,s12:mpbid |- ( ( ( M e. NN /\ ( D e. NN /\ ( mmu ` D ) =/= 0 ) /\ A. r e. Prime ( r || D -> -. r || M ) ) /\ n e. { q e. Prime | q || D } ) -> ( n e. Prime /\ n || D ) )
