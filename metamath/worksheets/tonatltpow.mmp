$( <MM> <PROOF_ASST> THEOREM=tonatltpow  LOC_AFTER=?

* The value of a bit word is below 2 to any bound on its length.

s1::simp1 |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> X e. Word 2o )
s2::simp2 |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> N e. NN0 )
s3::simp3 |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( # ` X ) <_ N )
i4::tonatlt
s5:s1,i4:syl |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( toNat ` X ) < ( 2 ^ ( # ` X ) ) )
i6::lencl
s7:s1,i6:syl |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( # ` X ) e. NN0 )
s8:s7:nn0zd |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( # ` X ) e. ZZ )
s9:s2:nn0zd |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> N e. ZZ )
s10:s8,s9,s3:3jca |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( ( # ` X ) e. ZZ /\ N e. ZZ /\ ( # ` X ) <_ N ) )
i11::eluz2
s12:s10,i11:sylibr |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> N e. ( ZZ>= ` ( # ` X ) ) )
s13::2re |- 2 e. RR
s14:s13:a1i |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> 2 e. RR )
s15::1le2 |- 1 <_ 2
s16:s15:a1i |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> 1 <_ 2 )
i17::leexp2a
s18:s14,s16,s12,i17:syl3anc |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( 2 ^ ( # ` X ) ) <_ ( 2 ^ N ) )
i19::tonatcl
s20:s1,i19:syl |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( toNat ` X ) e. NN0 )
s21:s20:nn0zd |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( toNat ` X ) e. ZZ )
s22:s21:zred |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( toNat ` X ) e. RR )
s23::2re |- 2 e. RR
s24:s23:a1i |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> 2 e. RR )
s25:s24,s7:reexpcld |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( 2 ^ ( # ` X ) ) e. RR )
s26:s24,s2:reexpcld |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( 2 ^ N ) e. RR )
qed:s22,s25,s26,s5,s18:ltletrd |- ( ( X e. Word 2o /\ N e. NN0 /\ ( # ` X ) <_ N ) -> ( toNat ` X ) < ( 2 ^ N ) )
