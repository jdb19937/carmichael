$( <MM> <PROOF_ASST> THEOREM=561carm  LOC_AFTER=?

* 561 satisfies a ^ 561 == a mod 561 for every integer a: with 561nprm,
  561 is a Carmichael number (the smallest).

1::5nn0     |- 5 e. NN0
2::6nn0     |- 6 e. NN0
3:1,2:deccl |- ; 5 6 e. NN0
4::1nn      |- 1 e. NN
5:3,4:decnncl |- ; ; 5 6 1 e. NN
6::561sqf   |- ( mmu ` ; ; 5 6 1 ) =/= 0
7::561lem7  |- A. p e. Prime ( p || ; ; 5 6 1 -> ( p - 1 ) || ; ; 5 6 0 )
8::0nn0     |- 0 e. NN0
9::1nn0     |- 1 e. NN0
10::eqid    |- ; ; 5 6 0 = ; ; 5 6 0
11::0p1e1   |- ( 0 + 1 ) = 1
12:3,8,9,10,11:decaddi |- ( ; ; 5 6 0 + 1 ) = ; ; 5 6 1
13:12:eqcomi |- ; ; 5 6 1 = ( ; ; 5 6 0 + 1 )
14:13:oveq1i |- ( ; ; 5 6 1 - 1 ) = ( ( ; ; 5 6 0 + 1 ) - 1 )
15:3,8:deccl |- ; ; 5 6 0 e. NN0
16:15:nn0cni |- ; ; 5 6 0 e. CC
17a::pncan1
17:16,17a:ax-mp |- ( ( ; ; 5 6 0 + 1 ) - 1 ) = ; ; 5 6 0
18:14,17:eqtri |- ( ; ; 5 6 1 - 1 ) = ; ; 5 6 0
19:18:eqcomi |- ; ; 5 6 0 = ( ; ; 5 6 1 - 1 )
20:19:breq2i |- ( ( p - 1 ) || ; ; 5 6 0 <-> ( p - 1 ) || ( ; ; 5 6 1 - 1 ) )
21:20:imbi2i |- ( ( p || ; ; 5 6 1 -> ( p - 1 ) || ; ; 5 6 0 ) <-> ( p || ; ; 5 6 1 -> ( p - 1 ) || ( ; ; 5 6 1 - 1 ) ) )
22:21:ralbii |- ( A. p e. Prime ( p || ; ; 5 6 1 -> ( p - 1 ) || ; ; 5 6 0 ) <-> A. p e. Prime ( p || ; ; 5 6 1 -> ( p - 1 ) || ( ; ; 5 6 1 - 1 ) ) )
23:7,22:mpbi |- A. p e. Prime ( p || ; ; 5 6 1 -> ( p - 1 ) || ( ; ; 5 6 1 - 1 ) )
24a::korselt
qed:5,6,23,24a:mp3an |- A. a e. ZZ ; ; 5 6 1 || ( ( a ^ ; ; 5 6 1 ) - a )
$)
