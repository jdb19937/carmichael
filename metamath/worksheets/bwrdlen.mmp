$( <MM> <PROOF_ASST> THEOREM=bwrdlen  LOC_AFTER=?

* The length of the digits word is the number of digits asked for.

s1::bwrdf |- ( ( N e. ZZ /\ M e. NN0 ) -> ( N bwrd M ) : ( 0 ..^ M ) --> 2o )
i2::ffn
s3:s1,i2:syl |- ( ( N e. ZZ /\ M e. NN0 ) -> ( N bwrd M ) Fn ( 0 ..^ M ) )
i4::hashfn
s5:s3,i4:syl |- ( ( N e. ZZ /\ M e. NN0 ) -> ( # ` ( N bwrd M ) ) = ( # ` ( 0 ..^ M ) ) )
s6::simpr |- ( ( N e. ZZ /\ M e. NN0 ) -> M e. NN0 )
i7::hashfzo0
s8:s6,i7:syl |- ( ( N e. ZZ /\ M e. NN0 ) -> ( # ` ( 0 ..^ M ) ) = M )
qed:s5,s8:eqtrd |- ( ( N e. ZZ /\ M e. NN0 ) -> ( # ` ( N bwrd M ) ) = M )
$)
