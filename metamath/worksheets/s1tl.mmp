$( <MM> <PROOF_ASST> THEOREM=s1tl  LOC_AFTER=?

* The tail of a one-letter word is empty.

s1::id |- ( Y e. A -> Y e. A )
s2:s1:s1cld |- ( Y e. A -> <" Y "> e. Word A )
i3::swrdcl
s4:s2,i3:syl |- ( Y e. A -> ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) e. Word A )
s5::s1nz |- <" Y "> =/= (/)
s6:s5:a1i |- ( Y e. A -> <" Y "> =/= (/) )
i7::wrdtllen
s8:s2,s6,i7:syl2anc |- ( Y e. A -> ( # ` ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) ) = ( ( # ` <" Y "> ) - 1 ) )
s9::s1len |- ( # ` <" Y "> ) = 1
s10:s9:a1i |- ( Y e. A -> ( # ` <" Y "> ) = 1 )
s11:s10:oveq1d |- ( Y e. A -> ( ( # ` <" Y "> ) - 1 ) = ( 1 - 1 ) )
s12::1m1e0 |- ( 1 - 1 ) = 0
s13:s12:a1i |- ( Y e. A -> ( 1 - 1 ) = 0 )
s14:s11,s13:eqtrd |- ( Y e. A -> ( ( # ` <" Y "> ) - 1 ) = 0 )
s15:s8,s14:eqtrd |- ( Y e. A -> ( # ` ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) ) = 0 )
s16:s4:elexd |- ( Y e. A -> ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) e. _V )
i17::hasheq0
s18:s16,i17:syl |- ( Y e. A -> ( ( # ` ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) ) = 0 <-> ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) = (/) ) )
qed:s18,s15:mpbid |- ( Y e. A -> ( <" Y "> substr <. 1 , ( # ` <" Y "> ) >. ) = (/) )
$)
