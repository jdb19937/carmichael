$( <MM> <PROOF_ASST> THEOREM=zl1alg5  LOC_AFTER=?

* The ` z ` -derivative of the zeta continuation term in normal form (ring identity for ~ zl1hdv ).

s1::simpll |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> Z e. CC )
s2::simplr |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> K e. CC )
s3::simprll |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> P e. CC )
s4::simprlr |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> Q e. CC )
s5::simprrl |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> A e. CC )
