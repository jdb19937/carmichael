s7:s4:mullidd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( 1 x. Q ) = Q )
s8:s6,s4:mulcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( G x. Q ) e. CC )
s9:s2,s1:addcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( K + Z ) e. CC )
s10:s8,s9:mulneg1d |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( -u ( G x. Q ) x. ( K + Z ) ) = -u ( ( G x. Q ) x. ( K + Z ) ) )
s11:s8,s9:mulcomd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( G x. Q ) x. ( K + Z ) ) = ( ( K + Z ) x. ( G x. Q ) ) )
s12:s11:negeqd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> -u ( ( G x. Q ) x. ( K + Z ) ) = -u ( ( K + Z ) x. ( G x. Q ) ) )
s13:s10,s12:eqtrd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( -u ( G x. Q ) x. ( K + Z ) ) = -u ( ( K + Z ) x. ( G x. Q ) ) )
s14:s7,s13:oveq12d |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( 1 x. Q ) + ( -u ( G x. Q ) x. ( K + Z ) ) ) = ( Q + -u ( ( K + Z ) x. ( G x. Q ) ) ) )
s15:s9,s8:mulcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( K + Z ) x. ( G x. Q ) ) e. CC )
s16:s4,s15:negsubd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( Q + -u ( ( K + Z ) x. ( G x. Q ) ) ) = ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) )
s17:s14,s16:eqtrd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( 1 x. Q ) + ( -u ( G x. Q ) x. ( K + Z ) ) ) = ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) )
s18:s5,s3:mulcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( A x. P ) e. CC )
s19:s2,s18:mulneg2d |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( K x. -u ( A x. P ) ) = -u ( K x. ( A x. P ) ) )
s20:s17,s19:oveq12d |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( ( 1 x. Q ) + ( -u ( G x. Q ) x. ( K + Z ) ) ) - ( K x. -u ( A x. P ) ) ) = ( ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) - -u ( K x. ( A x. P ) ) ) )
s21:s4,s15:subcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) e. CC )
s22:s2,s18:mulcld |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( K x. ( A x. P ) ) e. CC )
s23:s21,s22:subnegd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) - -u ( K x. ( A x. P ) ) ) = ( ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) + ( K x. ( A x. P ) ) ) )
qed:s20,s23:eqtrd |- ( ( ( Z e. CC /\ K e. CC ) /\ ( ( P e. CC /\ Q e. CC ) /\ ( A e. CC /\ G e. CC ) ) ) -> ( ( ( 1 x. Q ) + ( -u ( G x. Q ) x. ( K + Z ) ) ) - ( K x. -u ( A x. P ) ) ) = ( ( Q - ( ( K + Z ) x. ( G x. Q ) ) ) + ( K x. ( A x. P ) ) ) )
