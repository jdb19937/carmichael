$( <MM> <PROOF_ASST> THEOREM=smoothtdbi  LOC_AFTER=?

* The smoothness loop leaves 1 exactly when every prime factor is small.

s1::smoothtdf |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( ( 1st ` ( ( 2 SmoothGo K ) ` ( Y - 1 ) ) ) = 1 -> A. p e. Prime ( p || K -> p <_ Y ) ) )
s2::smoothtdb |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( A. t e. Prime ( t || K -> t <_ Y ) -> ( 1st ` ( ( 2 SmoothGo K ) ` ( Y - 1 ) ) ) = 1 ) )
s3::id |- ( p = t -> p = t )
s4:s3:breq1d |- ( p = t -> ( p || K <-> t || K ) )
s5::id |- ( p = t -> p = t )
s6:s5:breq1d |- ( p = t -> ( p <_ Y <-> t <_ Y ) )
s7:s4,s6:imbi12d |- ( p = t -> ( ( p || K -> p <_ Y ) <-> ( t || K -> t <_ Y ) ) )
s8:s7:cbvralvw |- ( A. p e. Prime ( p || K -> p <_ Y ) <-> A. t e. Prime ( t || K -> t <_ Y ) )
s9:s8:a1i |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( A. p e. Prime ( p || K -> p <_ Y ) <-> A. t e. Prime ( t || K -> t <_ Y ) ) )
s10:s9:biimpd |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( A. p e. Prime ( p || K -> p <_ Y ) -> A. t e. Prime ( t || K -> t <_ Y ) ) )
s11:s10,s2:syld |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( A. p e. Prime ( p || K -> p <_ Y ) -> ( 1st ` ( ( 2 SmoothGo K ) ` ( Y - 1 ) ) ) = 1 ) )
qed:s1,s11:impbid |- ( ( ( Y e. NN /\ K e. NN0 ) /\ 1 <_ K ) -> ( ( 1st ` ( ( 2 SmoothGo K ) ` ( Y - 1 ) ) ) = 1 <-> A. p e. Prime ( p || K -> p <_ Y ) ) )
$)
